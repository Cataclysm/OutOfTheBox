<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!-- Name is "Out of the Box" (spaced), matching Package.wxs's own Package/@Name - what the
       bootstrapper's own welcome text and the bundle's Programs and Features entry actually show,
       distinct from the "OutOfTheBox" identifier used in code/file/repo names. -->
  <Bundle Name="Out of the Box"
          Manufacturer="Dennis Freise"
          Version="$(ProductVersion)"
          UpgradeCode="899fedcf-6b86-4c88-8a39-56a27874008d"
          IconSourceFile="$(var.BrandAssetsPath)outofthebox.ico">

    <!-- ShowVersion puts "Version $(ProductVersion)" in the bootstrapper's own welcome text
         automatically - the brand mark shown alongside it is the same logo used everywhere else
         (installer icon, MSI dialogs, dashboard favicon/header).

         ThemeFile/LocalizationFile (rather than Theme="hyperlinkLicense" + LicenseUrl="") point at
         Theme.xml/Theme.wxl, a local copy of WixStdBA's stock hyperlinkLicense theme with the
         EulaHyperlink/EulaAcceptCheckbox controls removed - there's no real license agreement here,
         and LicenseUrl="" does not suppress those controls despite being the documented way to
         (confirmed by an actual install showing "I agree to the license terms and conditions
         [license terms]" boilerplate regardless). See Theme.xml's own comment for the full story. -->
    <BootstrapperApplication>
      <!-- Theme/LicenseUrl are still required by WiX's own schema validation even when ThemeFile/
           LocalizationFile override the actual rendered content - Theme selects which base engine
           behavior to use, LicenseUrl="" (empty, not omitted) is the minimum needed to satisfy
           "exactly one of LicenseFile or LicenseUrl must have a value." -->
      <bal:WixStandardBootstrapperApplication Theme="hyperlinkLicense" LicenseUrl=""
                                               ThemeFile="Theme.xml" LocalizationFile="Theme.wxl"
                                               ShowVersion="yes" SuppressOptionsUI="yes"
                                               LogoFile="$(var.BrandAssetsPath)logo-96.png" />
    </BootstrapperApplication>

    <!-- Detection: "some .NET 10 SDK is present" is approximated as "this exact patch version's
         install directory exists" - side-by-side SDK installs are harmless (this simply means a
         machine with a different 10.x patch already installed gets this one installed alongside
         it too, not a failure), which is an acceptable trade-off given Burn's built-in search
         elements can't parse the SDK list `dotnet` itself reports; keep this version string current with
         whatever installer/OutOfTheBox.Bootstrapper/Bundle.wxs's SdkPackage below actually installs. -->
    <util:DirectorySearch Id="DotNetSdkSearch"
                           Path="[ProgramFilesFolder]dotnet\sdk\10.0.302"
                           Variable="DotNetSdkInstalled" />

    <util:RegistrySearch Id="GitSearch"
                          Root="HKLM"
                          Key="SOFTWARE\GitForWindows"
                          Value="InstallPath"
                          Variable="GitInstallPath"
                          Result="exists" />

    <Chain>
      <!-- Permanent: this is a prerequisite for the service's own core feature (spawning `dotnet
           build`/`test` against target repositories needs the SDK on PATH regardless of Host's own
           self-contained packaging - see design.md's Packaging decision), not something
           OutOfTheBox itself owns; uninstalling OutOfTheBox must not remove it, since other things
           on the host may depend on it too. -->
      <ExePackage Id="DotNetSdkPackage"
                  InstallArguments="/install /quiet /norestart"
                  DetectCondition="DotNetSdkInstalled"
                  Permanent="yes"
                  Vital="yes">
        <ExePackagePayload Name="dotnet-sdk-10.0.302-win-x64.exe"
                            Hash="ffa847d86755033a4e2c8dd19ab3b0d9c8ae129e1e59cef460f792cced6319c69f730b96e05c5bb88ba906094f332bf5232d4c417605789f03a310dd8f3d22c2"
                            Size="213804008"
                            DownloadUrl="https://builds.dotnet.microsoft.com/dotnet/Sdk/10.0.302/dotnet-sdk-10.0.302-win-x64.exe" />
      </ExePackage>

      <!-- ExePackagePayload/@Hash must be SHA-512 (128 hex chars) - Burn computes/compares SHA-512
           regardless of what you supply, so a SHA-256 value (64 hex chars, `Get-FileHash`'s
           default -Algorithm) silently fails verification with a length-mismatched "actual" hash
           in the log rather than erroring at build time. Real bug, not hypothetical: this exact
           package's hash was originally captured as SHA-256 (a `Get-FileHash` default-algorithm
           slip against the SdkPackage's above, which was correctly captured as SHA-512), and only
           surfaced on a real install attempt - `wix msi validate`/`dotnet build` don't check
           payload hashes against anything, so this shipped for a while unnoticed. Always pass
           `-Algorithm SHA512` explicitly when (re-)capturing an ExePackagePayload hash. -->
      <ExePackage Id="GitForWindowsPackage"
                  InstallArguments="/VERYSILENT /NORESTART /NOCANCEL /SP-"
                  DetectCondition="GitInstallPath"
                  Permanent="yes"
                  Vital="yes">
        <ExePackagePayload Name="Git-2.55.0.3-64-bit.exe"
                            Hash="ef723f34ce8c0c1f8ef9eb7746f77e4ab6129aa7c7dcf501bee56f522ff2c57ff013f9a69db141ad04c9d1b90b4f1bbd22b6028218e3ae68eb4efec861d63f65"
                            Size="65388144"
                            DownloadUrl="https://github.com/git-for-windows/git/releases/download/v2.55.0.windows.3/Git-2.55.0.3-64-bit.exe" />
      </ExePackage>

      <!-- Burn's WixStandardBootstrapperApplication runs chained MsiPackages at a reduced,
           non-interactive UI level by default - without this, ConfigDlg (see Package.wxs) never
           showed when installing via this bootstrapper, only when the MSI was run directly
           (`msiexec /i`). bal:DisplayInternalUICondition (not a plain MsiPackage attribute - v3's
           DisplayInternalUI was relocated into the bal: namespace for v4+, confirmed via WiX's own
           FAQ and a maintainer response, not the non-existent v4+ MsiPackage attribute tried and
           abandoned earlier) restores the chained MSI's own internal UI, scoped to
           WixBundleAction = 6 (BOOTSTRAPPER_ACTION_INSTALL specifically) so it fires only for an
           actual install/upgrade, not uninstall/modify/repair, where a config-collection dialog
           makes no sense. Confirmed to work with the standard BA specifically (not just a custom
           one) via a WiX maintainer's own response, not assumed. -->
      <MsiPackage Id="OutOfTheBoxMsiPackage" SourceFile="$(var.MsiSourcePath)" Vital="yes"
                  bal:DisplayInternalUICondition="WixBundleAction = 6" />
    </Chain>

  </Bundle>
</Wix>

          <Publish Condition="(OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 1) OR (OutOfDiskSpace = 1 AND PROMPTROLLBACKCOST=&quot;F&quot;)" Event="SpawnDialog" Value="OutOfDiskDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Text="Cancel" TabSkip="no" Cancel="yes">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="Back" Type="PushButton" X="156" Y="243" Width="56" Height="17" Text="&amp;Back" DefaultCondition="WixUI_InstallMode = &quot;Remove&quot;" TabSkip="no">
          <Publish Event="NewDialog" Value="MaintenanceTypeDlg" />
          <Publish Condition="NOT Installed" Event="NewDialog" Value="ConfigDlg" />
          <Publish Condition="Installed AND PATCH" Event="NewDialog" Value="WelcomeDlg" />
        </Control>
        <Control Id="InstallTitle" Type="Text" X="15" Y="15" Width="300" Height="15" Text="{\OOTB_Title}Ready to install [ProductName]" Hidden="yes" Transparent="yes" NoPrefix="yes" ShowCondition="NOT Installed" TabSkip="yes" />
        <Control Id="InstallText" Type="Text" X="25" Y="70" Width="320" Height="80" Text="{\OOTB_Body}Click Install to begin the installation. Click Back to review or change any of your installation settings. Click Cancel to exit the wizard." Hidden="yes" Transparent="yes" NoPrefix="yes" ShowCondition="NOT Installed" TabSkip="yes" />
        <Control Id="ChangeTitle" Type="Text" X="15" Y="15" Width="300" Height="15" Text="{\OOTB_Title}Ready to change [ProductName]" Hidden="yes" Transparent="yes" NoPrefix="yes" ShowCondition="WixUI_InstallMode = &quot;Change&quot;" TabSkip="yes" />
        <Control Id="ChangeText" Type="Text" X="25" Y="70" Width="320" Height="80" Text="{\OOTB_Body}Click Change to begin the installation. Click Back to review or change any of your installation settings. Click Cancel to exit the wizard." Hidden="yes" Transparent="yes" NoPrefix="yes" ShowCondition="WixUI_InstallMode = &quot;Change&quot;" TabSkip="yes" />
        <Control Id="RepairTitle" Type="Text" X="15" Y="15" Width="300" Height="15" Text="{\OOTB_Title}Ready to repair [ProductName]" Hidden="yes" Transparent="yes" NoPrefix="yes" ShowCondition="WixUI_InstallMode = &quot;Repair&quot;" TabSkip="yes" />
        <Control Id="RepairText" Type="Text" X="25" Y="70" Width="320" Height="80" Text="{\OOTB_Body}Click Repair to repair the installation of [ProductName]. Click Back to review or change any of your installation settings. Click Cancel to exit the wizard." Hidden="yes" Transparent="yes" NoPrefix="yes" ShowCondition="WixUI_InstallMode = &quot;Repair&quot;" TabSkip="yes" />
        <Control Id="RemoveTitle" Type="Text" X="15" Y="15" Width="300" Height="15" Text="{\OOTB_Title}Ready to remove [ProductName]" Hidden="yes" Transparent="yes" NoPrefix="yes" ShowCondition="WixUI_InstallMode = &quot;Remove&quot;" TabSkip="yes" />
        <Control Id="RemoveText" Type="Text" X="25" Y="70" Width="320" Height="80" Text="{\OOTB_Body}Click Remove to remove [ProductName] from your computer. Click Back to review or change any of your installation settings. Click Cancel to exit the wizard." Hidden="yes" Transparent="yes" NoPrefix="yes" ShowCondition="WixUI_InstallMode = &quot;Remove&quot;" TabSkip="yes" />
        <Control Id="UpdateTitle" Type="Text" X="15" Y="15" Width="300" Height="15" Text="{\OOTB_Title}Ready to update [ProductName]" Hidden="yes" Transparent="yes" NoPrefix="yes" ShowCondition="WixUI_InstallMode = &quot;Update&quot;" TabSkip="yes" />
        <Control Id="UpdateText" Type="Text" X="25" Y="70" Width="320" Height="80" Text="{\OOTB_Body}Click Update to update [ProductName] from your computer. Click Back to review or change any of your installation settings. Click Cancel to exit the wizard." Hidden="yes" Transparent="yes" NoPrefix="yes" ShowCondition="WixUI_InstallMode = &quot;Update&quot;" TabSkip="yes" />
      </Dialog>

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="ConfigDlg" Order="2" Condition="NOT Installed" />

      <!-- Every other reachable path into stock VerifyReadyDlg also needs retargeting to
           VerifyReadyThemedDlg, not just ConfigDlg.Next above - confirmed by querying the compiled
           ControlEvent table for every remaining "NewDialog -> VerifyReadyDlg" row rather than
           assuming ConfigDlg's own Next button was the only entry point: WelcomeDlg's patch-install
           case (never actually exercised by this project - no .msp is authored - but closed anyway
           for correctness), and MaintenanceTypeDlg's Repair/Remove buttons, which very much are a
           real path (Programs and Features repair/uninstall). Order="10" is deliberately far above
           any native or already-authored value on these same Dialog/Control pairs, so there's no
           ambiguity about which one wins. -->
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyThemedDlg" Order="10" Condition="Installed AND PATCH" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyThemedDlg" Order="10" Condition="1" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyThemedDlg" Order="10" Condition="1" />
    </UI>

  </Package>
</Wix>

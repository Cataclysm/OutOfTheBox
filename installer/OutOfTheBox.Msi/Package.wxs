<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:fire="http://wixtoolset.org/schemas/v4/wxs/firewall"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!-- Name is "Out of the Box" (spaced, human-written), not the "OutOfTheBox" identifier used
       throughout the codebase/repository/file names - this is what Programs and Features, the Services
       console, dialog titles, and every stock WixUI_Minimal dialog (via the built-in [ProductName]
       substitution, already proven with [ProductVersion] below) actually show an operator. Most
       user-visible text in this file references [ProductName] rather than repeating the literal
       string, so the two names can never drift apart again the way they briefly did. -->
  <Package Name="Out of the Box"
           Manufacturer="Dennis Freise"
           Version="$(ProductVersion)"
           UpgradeCode="5ab0e967-6c6a-434d-b262-4aa613b49f5e"
           Scope="perMachine">

    <!-- SummaryInformation doesn't support [Property] runtime formatting (it's static .msi file
         metadata, not something the installer engine evaluates), so this one has to be a literal
         string kept in sync by hand rather than referencing [ProductName]. -->
    <SummaryInformation Description="Out of the Box - dotnet/git command execution service" />

    <!-- Embed the cabinet directly in the .msi (WiX's default is a separate .cab file alongside
         it) - the resulting single ~40 MB .msi is simpler to hand to the Burn bootstrapper below
         (one payload, not two files that must travel together) and to distribute standalone. -->
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Brand: the same mark used everywhere else (bootstrapper exe icon, dashboard favicon/
         header) - ARPPRODUCTICON is what Programs and Features shows; WixUIBannerBmp/
         WixUIDialogBmp are the well-known variable ids the stock WixUI dialog set looks for to
         replace its default placeholder banner/background images (493x58 and 493x312 px
         respectively - WixUI's own fixed dimensions, not a choice made here). -->
    <Icon Id="ProductIcon" SourceFile="$(var.BrandAssetsPath)outofthebox.ico" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BrandAssetsPath)banner-493x58.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.BrandAssetsPath)dialog-493x312.bmp" />


    <!-- Native upgrade sequencing (tasks.md 17.11) - supersedes the old upgrade.ps1's hand-rolled
         stop/verify/copy/start script. RemoveExistingProducts defaults to scheduling after the new
         product's files are installed, which is what makes the Windows Service's file replacement
         safe around the service still (briefly) running the old binary.
         Back to the WiX default (AllowSameVersionUpgrades unset, i.e. "no") - a prior version of
         this file set it to "yes" so re-running the installer at an unchanged ProductVersion (this
         project's Version has stayed 1.0.0 through many rebuilds) would still be recognized as an
         upgrade. That widens the Upgrade table's version range to include the current version
         itself, which is exactly what ICE61 exists to flag (WIX1076: "This product should remove
         only older versions of itself") - a real, if institutionally toothless, warning every build
         surfaced. Per direct instruction, disabled again rather than suppressed: a same-
         ProductVersion reinstall goes back to not being recognized as an upgrade at all (uninstall
         then reinstall, or bump Version, are the ways to actually replace an existing install). -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <!-- Defense in depth (tasks.md 17.10): the Burn bootstrapper is expected to have already
         guaranteed git is present before this MSI ever runs, but the MSI can be invoked directly,
         bypassing the bootstrapper - so check again here and fail with a clear message rather than
         installing a service that will fail every git run/clone. -->
    <Property Id="GITINSTALLPATH" Secure="yes">
      <RegistrySearch Id="GitRegistrySearch" Root="HKLM" Key="SOFTWARE\GitForWindows" Name="InstallPath" Type="raw" />
    </Property>
    <Launch Condition="Installed OR GITINSTALLPATH"
            Message="Git for Windows was not found. Install it first, or run OutOfTheBoxSetup.exe (the bootstrapper) instead of this MSI directly - it installs Git automatically." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="OutOfTheBox">
        <!-- Nested so the harvested files land at exactly INSTALLFOLDER\CredentialProviders\AzureArtifacts\ -
             NuGetCredentialProviderLocation.InstallDirectory (OutOfTheBox.Application) computes this
             same path from AppContext.BaseDirectory (== INSTALLFOLDER for the running Host.exe) and
             must stay in sync with these two literal Name values. -->
        <Directory Id="CredentialProvidersDir" Name="CredentialProviders">
          <Directory Id="AzureArtifactsCredProviderDir" Name="AzureArtifacts" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <!-- Per design.md's Data/config directory decision: never referenced by any Component or
         RemoveFolder below, so it structurally can't be touched by upgrade or uninstall, not just
         "by policy." This directory's only job here is to exist (created by the service account
         Component's util:User/permissions setup) so the service has somewhere to write
         appsettings.json/the SQLite file the first time it starts. -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DATADIRFOLDER" Name="OutOfTheBox" />
    </StandardDirectory>

    <!-- Config-collection UI properties (tasks.md 17.9), fed into the service's own environment
         block below rather than a hand-written appsettings.json - Program.cs already reads
         standard ASP.NET Core environment-variable configuration overrides, so this reuses that
         existing mechanism instead of introducing a custom action to render JSON. -->
    <Property Id="REPOSITORYROOTDIR" Value="C:\repositories" />
    <Property Id="BEARERTOKEN" Hidden="yes" Secure="yes" />
    <Property Id="PORTNUMBER" Value="5443" />

    <!-- The service account's name/domain qualifier - fixed, not operator-configurable. "." is
         the standard way to qualify a local (non-domain) account in a service Account string. -->
    <Property Id="SERVICEACCOUNTNAME" Value="svc-outofthebox" />
    <Property Id="SERVICEACCOUNTDOMAIN" Value="." />

    <!-- Secrets: the service account's own logon password (SERVICEACCOUNTPASSWORD) and the
         bearer token (BEARERTOKEN, above) both need a real value with no operator involvement
         required, generated once and then preserved across every subsequent upgrade rather than
         rotated out from under the operator (or, for the account password, out from under the
         service's own already-configured Windows logon). ResolveSecrets (below) is what actually
         resolves both; these two Secure properties are what feed it the prior value on an upgrade,
         found via RegistrySearch into the persisted copies HKLM\SOFTWARE\OutOfTheBox stores (see
         PersistedSecretsComponent) - AppSearch (which runs RegistrySearch) always completes before
         ResolveSecrets' own scheduling point, on both the UI and silent (no-UI) install paths. -->
    <Property Id="EXISTINGBEARERTOKEN" Secure="yes">
      <RegistrySearch Id="ExistingBearerTokenSearch" Root="HKLM" Key="SOFTWARE\OutOfTheBox" Name="BearerToken" Type="raw" />
    </Property>
    <Property Id="EXISTINGSERVICEACCOUNTPASSWORD" Secure="yes">
      <RegistrySearch Id="ExistingServiceAccountPasswordSearch" Root="HKLM" Key="SOFTWARE\OutOfTheBox" Name="ServiceAccountPassword" Type="raw" />
    </Property>
    <!-- Protects the self-signed HTTPS certificate ResolveSecrets generates (CertificateGenerator)
         - same generate-once-then-preserve reasoning as the two secrets above, since the PFX file
         itself is also never regenerated once it exists (see ResolveSecrets.cs), so the password
         that can actually open it has to be preserved just as durably. -->
    <Property Id="CERTPASSWORD" Hidden="yes" Secure="yes" />
    <Property Id="EXISTINGCERTPASSWORD" Secure="yes">
      <RegistrySearch Id="ExistingCertPasswordSearch" Root="HKLM" Key="SOFTWARE\OutOfTheBox" Name="CertificatePassword" Type="raw" />
    </Property>

    <!-- The version a prior install left behind, if any - same RegistrySearch-during-AppSearch
         mechanism as the two secrets above, used by ConfigDlg to show "upgrading from vX.Y.Z"
         rather than an operator having to guess whether this is a fresh install or an upgrade. -->
    <Property Id="EXISTINGVERSION" Secure="yes">
      <RegistrySearch Id="ExistingVersionSearch" Root="HKLM" Key="SOFTWARE\OutOfTheBox" Name="Version" Type="raw" />
    </Property>

    <Binary Id="ResolveSecretsCA" SourceFile="$(var.ResolveSecretsCaDllPath)" />
    <CustomAction Id="ResolveSecrets" BinaryRef="ResolveSecretsCA" DllEntry="ResolveSecrets" Execute="immediate" Return="check" />

    <!-- CreateRepositoryRootDirectory itself is deferred + Impersonate="no" (runs as SYSTEM), not
         immediate like every other custom action here - found necessary on a real install: the
         Windows Installer log showed "Hello, I'm your 64bit Impersonated custom action server"
         immediately before this action ran, meaning it was executing impersonating the installing
         user, not as SYSTEM, unlike util:User's own account-creation action (logged as "running
         with sufficient privileges" - the phrasing for a genuinely elevated, non-impersonated
         action). Resolving svc-outofthebox's SID (via NTAccount.Translate, inside
         GrantServiceAccountAccess) failed with IdentityNotMappedException specifically under that
         impersonated context even though the account demonstrably existed by then (util:User's own
         action, and InstallServices - which itself needs the account to exist to configure the
         service to log on as it - had both already completed) - an impersonated logon session's
         view of local SAM accounts can apparently be stale relative to one SYSTEM only just
         created, even though the underlying write (an admin-elevated calling user can already
         write arbitrary ACLs) would not itself have been the problem. A deferred, non-impersonated
         action can't read Session properties directly (per the Windows Installer execution model,
         only CustomActionData survives into the deferred/elevated context) - SetCreateRepositoryRootDirectoryData
         below is the standard MSI pattern for bridging that: an immediate action packs the needed
         property values into a property named after the deferred action's own Id, which Windows
         Installer then exposes to it as Session.CustomActionData. -->
    <CustomAction Id="SetCreateRepositoryRootDirectoryData"
                  Property="CreateRepositoryRootDirectory"
                  Value="REPOSITORYROOTDIR=[REPOSITORYROOTDIR];SERVICEACCOUNTNAME=[SERVICEACCOUNTNAME]" />
    <CustomAction Id="CreateRepositoryRootDirectory"
                  BinaryRef="ResolveSecretsCA"
                  DllEntry="CreateRepositoryRootDirectory"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <!-- Return="ignore": ConfigureGitSafeDirectoryAction already never throws (catches internally),
         but this makes the "never fail the install over this" intent visible in the authoring too,
         not just the C# doc comment. Still immediate/impersonated, unlike CreateRepositoryRootDirectory
         above - its own write (git's system-wide config file, under an already-elevated admin's own
         Program Files installation) depends only on the calling user's own rights, which impersonation
         of that same (already-admin) user doesn't remove, not on resolving a different principal's SID
         the way GrantServiceAccountAccess does - no evidence this one has the same problem. -->
    <CustomAction Id="ConfigureGitSafeDirectory" BinaryRef="ResolveSecretsCA" DllEntry="ConfigureGitSafeDirectory" Execute="immediate" Return="ignore" />

    <!-- Scheduled in both sequences: InstallUISequence so ConfigDlg's fields already show the
         resolved (generated-or-preserved) values by the time the operator sees the page, and
         InstallExecuteSequence so a genuinely silent (`msiexec /quiet`, no UI at all) install or
         upgrade still resolves them - the two sequences are independent, neither implies the
         other ran. -->
    <InstallUISequence>
      <Custom Action="ResolveSecrets" After="AppSearch" />
    </InstallUISequence>
    <InstallExecuteSequence>
      <Custom Action="ResolveSecrets" After="AppSearch" />
      <!-- InstallExecuteSequence only, deliberately not InstallUISequence too (unlike
           ResolveSecrets above): REPOSITORYROOTDIR only holds its final, operator-confirmed value once
           ConfigDlg has been through - scheduling this during the UI sequence's own early AppSearch
           pass would create the property's still-default value (C:\repositories) before the operator ever
           got a chance to type a different path.

           Scheduled After="InstallServices" (a standard MSI action, unlike this next part: this
           action grants the service account NTFS rights on the repository root, which needs the
           account to already exist first). Found the hard way on a real install - scheduling only
           After="AppSearch" (much earlier) ran before util:User's own CreateUser action, so the
           account genuinely didn't exist yet, and NTAccount("svc-outofthebox")
           .Translate(typeof(SecurityIdentifier)) (called internally by AddAccessRule) threw
           IdentityNotMappedException, failing the entire install with error 1603.
           After="InstallServices" is deliberate, not arbitrary: InstallServices itself needs the
           account to exist too (a service can't be configured to log on as an account that isn't
           there yet), so by the time InstallServices has run, CreateUser is guaranteed to already
           have completed - referencing util:User's own action directly isn't possible from here
           (WixToolset.Util.wixext doesn't expose it as a linkable symbol; both "Wix4CreateUser_X64"
           - its compiled runtime name, visible in the install log - and the unprefixed "CreateUser"
           were tried and rejected by the linker with WIX0094, "identifier could not be found").
           Still safely before StartServices, so the directory/permissions are ready before the
           service itself starts and tries to use them. SetCreateRepositoryRootDirectoryData (the
           immediate property-setting half of the deferred-action pair - see the CustomAction
           authoring above for why this needs to be deferred+elevated at all) is scheduled directly
           in front of the deferred action it feeds; scheduling it any earlier would risk a later
           action changing REPOSITORYROOTDIR/SERVICEACCOUNTNAME before the snapshot is taken (none
           currently do, but there's no benefit to scheduling it earlier than strictly necessary
           either). SERVICEACCOUNTDOMAIN is deliberately NOT plumbed through here - see
           CreateRepositoryRootDirectory.cs's own GrantServiceAccountAccess remarks: "." is not a
           valid domain qualifier for NTAccount.Translate/LookupAccountName the way it is for
           ServiceInstall's own Account attribute below, confirmed on real-machine use, so the SID
           resolution this action performs uses the bare account name only. -->
      <Custom Action="SetCreateRepositoryRootDirectoryData" After="InstallServices" />
      <Custom Action="CreateRepositoryRootDirectory" After="SetCreateRepositoryRootDirectoryData" />
      <!-- Same InstallExecuteSequence-only reasoning as CreateRepositoryRootDirectory just above -
           needs REPOSITORYROOTDIR's final value, and doesn't need to run before it (the system-wide git
           config write doesn't care whether the directory exists yet, only CreateRepositoryRootDirectory does). -->
      <Custom Action="ConfigureGitSafeDirectory" After="CreateRepositoryRootDirectory" />
    </InstallExecuteSequence>

    <Feature Id="MainFeature" Title="Out of the Box Service" Level="1">
      <ComponentGroupRef Id="PublishOutputComponents" />
      <ComponentGroupRef Id="CredentialProviderComponents" />
      <ComponentRef Id="ServiceAccountComponent" />
      <ComponentRef Id="DataDirectoryComponent" />
      <ComponentRef Id="ServiceComponent" />
      <ComponentRef Id="FirewallComponent" />
      <ComponentRef Id="PersistedSecretsComponent" />
    </Feature>

    <!-- Persists whatever ResolveSecrets resolved BEARERTOKEN/SERVICEACCOUNTPASSWORD to (freshly
         generated, or reused from here on a prior install) so the *next* upgrade's
         EXISTINGBEARERTOKEN/EXISTINGSERVICEACCOUNTPASSWORD RegistrySearch above finds it - this is
         what makes "upgrades don't change the bearer token, but the operator still can by editing
         ConfigDlg" true: whatever value ConfigDlg ends up showing (generated default, preserved
         prior value, or an operator's own edit) is what gets written here and carried forward.
         Also persists the version just installed, read back by EXISTINGVERSION on the *next*
         upgrade so ConfigDlg can show "upgrading from vX.Y.Z" - not resolved through
         ResolveSecrets since it needs no generate-or-preserve logic, just "always the current
         ProductVersion". Deliberately a plain Registry key (SOFTWARE\OutOfTheBox), not under the
         service's own Services\OutOfTheBox key used for the Environment value in ServiceComponent
         - keeps "where the running process reads its config from" and "where the installer stores
         its own install-to-install bookkeeping" clearly separate, even though the first two values
         currently also happen to be duplicated into that Environment value. -->
    <Component Id="PersistedSecretsComponent" Directory="INSTALLFOLDER" Guid="7c6a1e3a-1b1f-4a1e-9b7a-5b7b6b3a1a05">
      <RegistryValue Root="HKLM" Key="SOFTWARE\OutOfTheBox" Name="BearerToken" Type="string" Value="[BEARERTOKEN]" KeyPath="yes" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\OutOfTheBox" Name="ServiceAccountPassword" Type="string" Value="[SERVICEACCOUNTPASSWORD]" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\OutOfTheBox" Name="CertificatePassword" Type="string" Value="[CERTPASSWORD]" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\OutOfTheBox" Name="Version" Type="string" Value="[ProductVersion]" />
    </Component>

    <!-- Wildcard file harvesting (WiX v4+'s built-in replacement for the old standalone heat.exe
         tool) - every file under the publish output becomes its own Component/File automatically,
         so a new static asset added to Presentation's wwwroot later is picked up without a
         hand-maintained file list silently missing it (see design.md's Chart.js-goes-missing
         risk). OutOfTheBox.Host.exe itself is deliberately excluded here (Exclude) since
         ServiceComponent below already declares it explicitly, as the KeyPath the ServiceInstall/
         ServiceControl elements attach to - a file can't be harvested twice under two different
         Component ids. -->
    <ComponentGroup Id="PublishOutputComponents" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishOutputPath)**">
        <Exclude Files="$(var.PublishOutputPath)OutOfTheBox.Host.exe" />
      </Files>
    </ComponentGroup>

    <!-- The vendored Azure Artifacts Credential Provider (see design.md's "installer bundling"
         decision, expose-nuget-credentials-mcp) - extracted as-is from the upstream
         microsoft/artifacts-credprovider release archive by a separate, independently re-runnable
         step (INSTALL.md), the same "populate a folder, then harvest everything under it"
         convention PublishOutputComponents above already uses for the Host's own publish output -
         and, like that one, a genuine prerequisite for this project to build at all (WiX's wildcard
         Files harvesting errors on zero matches; there is no "harvest if present" attribute in this
         WiX version to make it optional). authorize_nuget_feed against an Azure DevOps Artifacts
         feed still fails with a specific, actionable diagnostic at runtime on any machine where a
         *different* build of the MSI happened to omit this - this Files element failing closed at
         build time is about this project's own build reproducibility, not a runtime concern. -->
    <ComponentGroup Id="CredentialProviderComponents" Directory="AzureArtifactsCredProviderDir">
      <Files Include="$(var.CredentialProviderPath)**" />
    </ComponentGroup>

    <!-- Dedicated least-privilege service account (design.md's generic-passthrough risk
         mitigation) - not local admin, not a pre-existing/shared account. Removed on uninstall.

         LogonAsService="yes" is required and was missing until a real install on Windows Server
         2025 Datacenter failed to start the service at all (SCM Event Viewer entry: "Logon
         failure: the user has not been granted the requested logon type at this computer" /
         "This service account does not have the required user right 'Log on as a service.'").
         The comment this replaced claimed the right was "granted automatically once the service
         below is installed to run as this account" - that is FALSE: CreateService/ServiceInstall
         never grants SeServiceLogonRight programmatically, only the interactive Services (
         services.msc) GUI does that as an implicit side effect, which is irrelevant to an
         unattended MSI install. LogonAsService="yes" makes util:User's own account-creation action
         call LsaAddAccountRights directly, independent of and not racing against ServiceInstall's
         own sequencing. -->
    <Component Id="ServiceAccountComponent" Directory="INSTALLFOLDER" Guid="7c6a1e3a-1b1f-4a1e-9b7a-5b7b6b3a1a01">
      <util:User Id="ServiceAccount"
                 Name="[SERVICEACCOUNTNAME]"
                 Password="[SERVICEACCOUNTPASSWORD]"
                 PasswordNeverExpires="yes"
                 CanNotChangePassword="yes"
                 CreateUser="yes"
                 RemoveOnUninstall="yes"
                 UpdateIfExists="yes"
                 LogonAsService="yes">
        <!-- Required for PerformanceCounter access to the Processor category (design.md's resource-
             monitoring risk) - the account wouldn't have this by default otherwise. -->
        <util:GroupRef Id="PerformanceMonitorUsersGroup" />
      </util:User>
    </Component>
    <util:Group Id="PerformanceMonitorUsersGroup" Name="Performance Monitor Users" />

    <!-- Grants the service account read/write on the data directory (config + SQLite file) and
         creates it if it doesn't already exist. Never a Component that gets removed on uninstall -
         see the StandardDirectory comment above. -->
    <Component Id="DataDirectoryComponent" Directory="DATADIRFOLDER" Guid="7c6a1e3a-1b1f-4a1e-9b7a-5b7b6b3a1a02">
      <CreateFolder>
        <util:PermissionEx User="[SERVICEACCOUNTNAME]" GenericAll="yes" />
      </CreateFolder>
    </Component>

    <!-- Windows Service registration (tasks.md 17.7). The Environment multi-string is how the
         config-collection UI's values (and OUTOFTHEBOX_DATA_DIR, so Program.cs finds the data
         directory's own appsettings.json overlay) actually reach the running process - see the
         property comment above for why this is preferred over a custom action writing JSON. -->
    <Component Id="ServiceComponent" Directory="INSTALLFOLDER" Guid="7c6a1e3a-1b1f-4a1e-9b7a-5b7b6b3a1a03">
      <File Id="ServiceExeForInstall" Source="$(var.PublishOutputPath)OutOfTheBox.Host.exe" KeyPath="yes" />

      <!-- Name (the actual SCM service key, matched by ServiceControl/@Name and the Environment
           registry key path below) stays the plain "OutOfTheBox" identifier deliberately - unlike
           DisplayName (what services.msc actually shows an operator), this is a technical key
           other things reference by exact string match, not a place to introduce a space. -->
      <ServiceInstall Id="OutOfTheBoxServiceInstall"
                       Name="OutOfTheBox"
                       DisplayName="[ProductName]"
                       Description="Runs dotnet/git commands and transfers build artifacts for a sandboxed Claude Code caller."
                       Type="ownProcess"
                       Start="auto"
                       ErrorControl="normal"
                       Account="[SERVICEACCOUNTDOMAIN]\[SERVICEACCOUNTNAME]"
                       Password="[SERVICEACCOUNTPASSWORD]">
        <!-- SCM does not restart a crashed service by default (design.md's Packaging decision) -
             this configures the same restart/60s x3 recovery actions the old install.ps1's
             `sc.exe failure` call used to set by hand. -->
        <util:ServiceConfig FirstFailureActionType="restart"
                             SecondFailureActionType="restart"
                             ThirdFailureActionType="restart"
                             RestartServiceDelayInSeconds="60"
                             ResetPeriodInDays="1" />
      </ServiceInstall>
      <ServiceControl Id="OutOfTheBoxServiceControl"
                       Name="OutOfTheBox"
                       Start="install"
                       Stop="both"
                       Remove="uninstall"
                       Wait="yes" />

      <!-- OutOfTheBox__SqliteFilePath was missing here entirely - a real gap found only once an
           actual installed service started for the first time and crashed outright: the bundled
           default appsettings.json ships SqliteFilePath="" (deliberately, so a WebApplicationFactory
           test's in-memory config override isn't shadowed by a bundled default - see the
           AddDbContext comment in Program.cs), and since the installer never wrote a data-directory
           appsettings.json (it writes environment variables instead, per the property comment
           above) nor set this specific variable, every real install has been running with an empty
           SqliteFilePath the entire time. An empty SQLite "Data Source" opens a fresh anonymous
           private database per connection rather than one shared file - migrations succeeded on one
           such connection during startup, then ReconcileInterruptedAsync's own query opened a
           different one with no migrated schema at all, crashing with "SQLite Error 1: 'no such
           table: Runs'" (a real crash log from Event Viewer, not a hypothetical). Fixed by pointing
           it at outofthebox.db inside the data directory - the exact filename INSTALL.md's own
           upgrade-rollback guidance already assumed existed, even though nothing ever actually
           created it there before now. -->
      <RegistryValue Root="HKLM"
                      Key="SYSTEM\CurrentControlSet\Services\OutOfTheBox"
                      Name="Environment"
                      Type="multiString">
        <MultiString Value="OUTOFTHEBOX_DATA_DIR=[DATADIRFOLDER]" />
        <MultiString Value="OutOfTheBox__RootDirectory=[REPOSITORYROOTDIR]" />
        <MultiString Value="OutOfTheBox__BearerToken=[BEARERTOKEN]" />
        <MultiString Value="OutOfTheBox__SqliteFilePath=[DATADIRFOLDER]outofthebox.db" />
        <MultiString Value="Kestrel__Endpoints__Https__Url=https://0.0.0.0:[PORTNUMBER]" />
        <!-- ResolveSecrets (installer/OutOfTheBox.Msi.CustomActions) generates this PFX and writes
             it to the data directory if it doesn't already exist - previously nothing configured a
             certificate at all, and the service crashed on every install with "No server
             certificate was specified" the moment it tried to start Kestrel's HTTPS endpoint. -->
        <MultiString Value="Kestrel__Endpoints__Https__Certificate__Path=[DATADIRFOLDER]outofthebox.pfx" />
        <MultiString Value="Kestrel__Endpoints__Https__Certificate__Password=[CERTPASSWORD]" />
        <!-- The public-only counterpart of the PFX above (no private key, no password) - ResolveSecrets
             writes this alongside it. Distinct from the Kestrel__* keys above: this one is read by
             application code (ServiceOptions.CertificateFilePath), not the framework's own Kestrel
             configuration binding, so the dashboard's About page can serve it for download. -->
        <MultiString Value="OutOfTheBox__CertificateFilePath=[DATADIRFOLDER]outofthebox.cer" />
      </RegistryValue>
    </Component>

    <!-- Firewall rule (tasks.md 17.8) - scoped by port only here (the installer doesn't know the
         sbx sandbox's or operator's IPs at install time); see INSTALL.md for narrowing it to
         specific remote addresses after install, per design.md's Network & transport decision. -->
    <Component Id="FirewallComponent" Directory="INSTALLFOLDER" Guid="7c6a1e3a-1b1f-4a1e-9b7a-5b7b6b3a1a04">
      <fire:FirewallException Id="OutOfTheBoxFirewallRule"
                               Name="Out of the Box"
                               Port="[PORTNUMBER]"
                               Protocol="tcp"
                               Scope="any"
                               IgnoreFailure="yes" />
    </Component>

    <!-- Minimal (Welcome/Progress/Exit only) rather than InstallDir - this installer's own
         install location isn't something an operator needs to choose (per design.md, it's
         disposable/upgrade-replaced), so a directory-chooser page for THAT would be a confusing
         second "pick a folder" step alongside ConfigDlg's own repository-root field below.

         This UI content lives directly under <Package> (not a separate Fragment in its own file)
         deliberately: a Fragment elsewhere is only pulled into the linked output if something
         reachable from <Package> references one of its identifiers, and nothing does that for a
         <ui:WixUI>/<Dialog>/override-<Publish> block on its own - putting it in a standalone
         Fragment silently compiled clean but produced an MSI with no Dialog/Control table at all
         (verified via the Windows Installer COM API directly, since wix msi decompile doesn't
         cover UI tables either - a real "build succeeded, feature entirely absent" trap). -->
    <ui:WixUI Id="WixUI_Minimal" />

    <!-- Config-collection page (tasks.md 17.9) - repository root directory, bearer token, and port,
         written into the service's Environment registry value by ServiceComponent above. Spliced
         into WixUI_Minimal's sequence as the fresh-install entry point (see the InstallUISequence
         override below) via overriding Publish entries - the standard WiX pattern for adding a
         custom page to a stock dialog set.

         Light styling: a dark theme was tried first (a full-panel Background Bitmap + custom
         light-on-dark TextStyles) and reversed on direct request - "dark theme in WiX does not
         look good... let's move for a light style." ConfigDlg/InvalidConfigDlg now use the
         standard WixUI convention instead - a banner strip (the same `WixUIBannerBmp` stock
         dialogs use) plus a plain light dialog body, no custom Background/TextStyle at all. This
         also fixes a real readability bug the dark version had: its label TextStyle was a
         near-white color (`Red="230" Green="232" Blue="235"`) specifically so it would read
         against the dark panel - once that panel was removed, the same near-white text on the
         *plain white* dialog body became just as unreadable as black-on-dark had been, in the
         opposite direction. Plain default-styled Text controls (no `{\Style}` prefix, no
         `Transparent`) render in the OS's normal dark caption color against a normal light dialog
         body and need no special handling either way.

         VerifyReadyDlg (the "Ready to install..." confirmation screen) was similarly given a full
         hand-authored replacement (`VerifyReadyThemedDlg`) earlier in this same session, once for
         the same reason - its own stock title sits directly on `banner-493x58.bmp`, and that
         banner was dark at the time. That replacement has been removed now that the banner itself
         is light (see the Binary/comment above) - the underlying readability problem no longer
         exists, so the stock dialog is safe to use again, and reverting removes a large, easy-to-
         subtly-diverge hand-copy of stock behavior (five install/change/repair/remove/update
         states, each with disk-space-exhaustion sub-branches) that no longer earns its risk. -->
    <UI>
      <Dialog Id="ConfigDlg" Width="370" Height="270" Title="Configure options">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" Text="WixUI_Bmp_Banner" TabSkip="no" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="373" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="373" Height="0" />

        <!-- Positioned at X=15 Y=15, on the banner itself - matches the exact placement/style
             stock WixUI_Minimal dialogs use for their own title (e.g. VerifyReadyDlg's
             InstallTitle), which this dialog's title previously didn't (it sat below the banner
             instead), reading as "no title" by comparison since it wasn't where an operator's eye
             goes first on every other dialog in the sequence. Transparent="yes" matters here
             specifically - it's what stock titles sitting on a banner always carry (confirmed
             against InstallTitle's own attributes); without it a Text control paints its own
             opaque background box, which is exactly what showed up as an "unwanted background"
             once this title moved onto the banner bitmap. Every other control here sits on the
             plain dialog body below the banner (no bitmap under it), so none of them need it. -->
        <Control Id="Title" Type="Text" X="15" Y="15" Width="300" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Configure options" />
        <!-- Shown only on an upgrade (EXISTINGVERSION is only non-empty when the version-persist
             RegistryValue from a prior install's PersistedSecretsComponent was found during
             AppSearch) - a fresh install shows nothing here, not an empty "Upgrading from v"
             line. -->
        <Control Id="UpgradeNotice" Type="Text" X="15" Y="53" Width="340" Height="15" NoPrefix="yes" Text="Upgrading from version [EXISTINGVERSION]"
                 HideCondition="EXISTINGVERSION = &quot;&quot;" ShowCondition="EXISTINGVERSION &lt;&gt; &quot;&quot;" />
        <!-- X=25/Width=320, Y=70 (not X=15/W=340 like the title above) - matches VerifyReadyDlg's
             own InstallText exactly (X=25 Y=70 W=320 on the same 370-wide dialog): same top
             spacing below the banner/title, and left/right padding equal (25 each side:
             370 - 25 - 320 = 25) the way every stock dialog's body content does, distinct from the
             title's own flush-left placement. -->
        <Control Id="Description" Type="Text" X="25" Y="70" Width="320" Height="20" NoPrefix="yes"
                 Text="These values are written into the Windows Service's own environment and can be changed later by editing the registry or reinstalling." />

        <!-- Y=100 - a deliberate 5px-larger gap after the title/description block above (whose own
             top position now matches VerifyReadyDlg's), separating it from the interactive fields
             below; every field after this one is positioned relative to this same anchor. -->
        <Control Id="RepositoryRootLabel" Type="Text" X="25" Y="100" Width="320" Height="15" NoPrefix="yes" Text="Repository root directory:" />
        <Control Id="RepositoryRootEdit" Type="Edit" X="25" Y="115" Width="320" Height="18" Property="REPOSITORYROOTDIR" Text="{80}" />

        <Control Id="BearerTokenLabel" Type="Text" X="25" Y="140" Width="320" Height="15" NoPrefix="yes" Text="Bearer token (sbx caller and web interface):" />
        <Control Id="BearerTokenEdit" Type="Edit" X="25" Y="155" Width="320" Height="18" Property="BEARERTOKEN" Text="{80}" />

        <Control Id="PortLabel" Type="Text" X="25" Y="180" Width="150" Height="15" NoPrefix="yes" Text="Port:" />
        <Control Id="PortEdit" Type="Edit" X="25" Y="195" Width="80" Height="18" Property="PORTNUMBER" Text="{80}" />

        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="Back">
          <Publish Event="NewDialog" Value="WelcomeDlg" Order="1" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Text="Next">
          <!-- Refuse to proceed without a repository root and a non-trivial bearer token - an installer
               that silently accepted blank/weak values here would produce a service that's either
               broken (no root configured) or authenticated by an empty credential. Port left
               unvalidated beyond "not blank" - msiexec/Kestrel will fail loudly enough on a
               genuinely invalid one, and duplicating full numeric-range validation here isn't
               worth the extra dialog complexity for a v1 config page. -->
          <Publish Event="SpawnDialog" Value="InvalidConfigDlg" Order="1" Condition="REPOSITORYROOTDIR = &quot;&quot; OR BEARERTOKEN = &quot;&quot; OR PORTNUMBER = &quot;&quot;" />
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Order="2" Condition="REPOSITORYROOTDIR &lt;&gt; &quot;&quot; AND BEARERTOKEN &lt;&gt; &quot;&quot; AND PORTNUMBER &lt;&gt; &quot;&quot;" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" Order="1" />
        </Control>
      </Dialog>

      <!-- Minimal message dialog for the Next-button validation above - reuses the same OK-only
           shape as WiX's own stock error dialogs rather than introducing a new visual pattern. No
           Background control at all - a plain MSI dialog with nothing drawn under it already
           renders as a normal light Win32 dialog, which is all this needs. -->
      <Dialog Id="InvalidConfigDlg" Width="260" Height="85" Title="Configure [ProductName]">
        <Control Id="Text" Type="Text" X="10" Y="10" Width="240" Height="40" NoPrefix="yes"
                 Text="Repository root directory, bearer token, and port are all required." />
        <Control Id="OK" Type="PushButton" X="95" Y="55" Width="56" Height="17" Text="OK">
          <Publish Event="EndDialog" Value="Return" Order="1" />
        </Control>
      </Dialog>

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="ConfigDlg" Order="2" Condition="NOT Installed" />
      <!-- Stock VerifyReadyDlg's own Back button only knows about MaintenanceTypeDlg (its
           unconditional native target) - it has no idea ConfigDlg exists at all, since ConfigDlg
           is this project's own addition. This override was present from ConfigDlg's original
           17.9 authoring but got dropped when VerifyReadyDlg was temporarily replaced with a fully
           custom VerifyReadyThemedDlg (which folded the same logic directly into its own Back
           control instead) and then never restored when that replacement was reverted back to
           stock - a real regression, caught by an operator actually clicking Back and landing on
           "Change/Repair/Uninstall" instead of returning to config. -->
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ConfigDlg" Order="2" Condition="NOT Installed" />

      <!-- WixUI_Minimal's real fresh-install entry point is WelcomeEulaDlg (NOT WelcomeDlg, which
           only fires for a patch install - essentially dead in this project, no .msp is authored) -
           found only by finally querying the compiled InstallUISequence table directly, something
           earlier work never actually did (a first query attempt failed on a PowerShell quoting
           issue and was never retried, so every prior "no license text anywhere in the MSI" check
           was against WelcomeDlg, the wrong dialog). WelcomeEulaDlg carries WixUI_Minimal's own
           default placeholder license RTF verbatim ("Lorem ipsum dolor sit amet...") and its own
           "Install" button - not a "Next" - ends the dialog sequence immediately once the license
           checkbox is checked, bypassing ConfigDlg entirely regardless of any ControlEvent wiring
           elsewhere in this file. `<Show Dialog="override X">` (the exact syntax WiX's own
           WIX7009 error names) suppresses WelcomeEulaDlg outright (Condition="0"); "override
           WelcomeDlg" hits a second, different conflict (WIX0091 against WixUI_Minimal.wxs's own
           internal duplicate declaration of that same row) so rather than fight that too, a fresh
           install now launches straight into ConfigDlg - a genuinely new InstallUISequence entry,
           not an override, so no symbol conflict - skipping the Welcome text step entirely rather
           than showing it via an unnecessary intermediate stock dialog. -->
      <InstallUISequence>
        <Show Dialog="override WelcomeEulaDlg" Before="ProgressDlg" Condition="0" />
        <Show Dialog="ConfigDlg" Before="ProgressDlg" Condition="NOT Installed" />
      </InstallUISequence>
    </UI>

  </Package>
</Wix>

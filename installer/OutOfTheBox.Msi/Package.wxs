<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:fire="http://wixtoolset.org/schemas/v4/wxs/firewall"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!-- Name is "Out of the Box" (spaced, human-written), not the "OutOfTheBox" identifier used
       throughout the codebase/repo/file names - this is what Programs and Features, the Services
       console, dialog titles, and every stock WixUI_Minimal dialog (via the built-in [ProductName]
       substitution, already proven with [ProductVersion] below) actually show an operator. Most
       user-visible text in this file references [ProductName] rather than repeating the literal
       string, so the two names can never drift apart again the way they briefly did. -->
  <Package Name="Out of the Box"
           Manufacturer="Dennis Freise"
           Version="$(ProductVersion)"
           UpgradeCode="5ab0e967-6c6a-434d-b262-4aa613b49f5e"
           Scope="perMachine">

    <!-- SummaryInformation doesn't support [Property] runtime formatting (it's static .msi file
         metadata, not something the installer engine evaluates), so this one has to be a literal
         string kept in sync by hand rather than referencing [ProductName]. -->
    <SummaryInformation Description="Out of the Box - dotnet/git command execution service" />

    <!-- Embed the cabinet directly in the .msi (WiX's default is a separate .cab file alongside
         it) - the resulting single ~40 MB .msi is simpler to hand to the Burn bootstrapper below
         (one payload, not two files that must travel together) and to distribute standalone. -->
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Brand: the same mark used everywhere else (bootstrapper exe icon, dashboard favicon/
         header) - ARPPRODUCTICON is what Programs and Features shows; WixUIBannerBmp/
         WixUIDialogBmp are the well-known variable ids the stock WixUI dialog set looks for to
         replace its default placeholder banner/background images (493x58 and 493x312 px
         respectively - WixUI's own fixed dimensions, not a choice made here). -->
    <Icon Id="ProductIcon" SourceFile="$(var.BrandAssetsPath)outofthebox.ico" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BrandAssetsPath)banner-493x58.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.BrandAssetsPath)dialog-493x312.bmp" />

    <!-- Dark-theme dialog backgrounds, matching the dashboard's own dark palette and body wash
         (see dashboard.css's :root/body rules) - a native MSI dialog is a real Win32 dialog, so
         Edit/PushButton/CheckBox controls are OS-drawn and can't be recolored (no MSI table for
         "edit box background") regardless of what's declared here. What CAN be themed, and is
         below: each overridden dialog's own background (a full-dialog Bitmap control, replacing
         the default white dialog face) and its static Text controls (Transparent + a light
         TextStyle, so they read against the dark bitmap instead of sitting in an opaque white
         text box). One bitmap per distinct dialog size in play, sized to that dialog's own aspect
         ratio - Bitmap controls always stretch-to-fit, so a mismatched aspect ratio would visibly
         distort the glow shape. -->
    <Binary Id="PanelBmp370x290" SourceFile="$(var.BrandAssetsPath)panel-370x290.bmp" />
    <Binary Id="PanelBmp370x270" SourceFile="$(var.BrandAssetsPath)panel-370x270.bmp" />
    <Binary Id="PanelBmp260x85" SourceFile="$(var.BrandAssetsPath)panel-260x85.bmp" />

    <!-- Native upgrade sequencing (tasks.md 17.11) - supersedes the old upgrade.ps1's hand-rolled
         stop/verify/copy/start script. RemoveExistingProducts defaults to scheduling after the new
         product's files are installed, which is what makes the Windows Service's file replacement
         safe around the service still (briefly) running the old binary. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <!-- Defense in depth (tasks.md 17.10): the Burn bootstrapper is expected to have already
         guaranteed git is present before this MSI ever runs, but the MSI can be invoked directly,
         bypassing the bootstrapper - so check again here and fail with a clear message rather than
         installing a service that will fail every git run/clone. -->
    <Property Id="GITINSTALLPATH" Secure="yes">
      <RegistrySearch Id="GitRegistrySearch" Root="HKLM" Key="SOFTWARE\GitForWindows" Name="InstallPath" Type="raw" />
    </Property>
    <Launch Condition="Installed OR GITINSTALLPATH"
            Message="Git for Windows was not found. Install it first, or run OutOfTheBoxSetup.exe (the bootstrapper) instead of this MSI directly - it installs Git automatically." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="OutOfTheBox" />
    </StandardDirectory>

    <!-- Per design.md's Data/config directory decision: never referenced by any Component or
         RemoveFolder below, so it structurally can't be touched by upgrade or uninstall, not just
         "by policy." This directory's only job here is to exist (created by the service account
         Component's util:User/permissions setup) so the service has somewhere to write
         appsettings.json/the SQLite file the first time it starts. -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DATADIRFOLDER" Name="OutOfTheBox" />
    </StandardDirectory>

    <!-- Config-collection UI properties (tasks.md 17.9), fed into the service's own environment
         block below rather than a hand-written appsettings.json - Program.cs already reads
         standard ASP.NET Core environment-variable configuration overrides, so this reuses that
         existing mechanism instead of introducing a custom action to render JSON. -->
    <Property Id="REPOROOTDIR" Value="C:\repos" />
    <Property Id="BEARERTOKEN" Hidden="yes" Secure="yes" />
    <Property Id="PORTNUMBER" Value="5443" />

    <!-- The service account's name/domain qualifier - fixed, not operator-configurable. "." is
         the standard way to qualify a local (non-domain) account in a service Account string. -->
    <Property Id="SERVICEACCOUNTNAME" Value="svc-outofthebox" />
    <Property Id="SERVICEACCOUNTDOMAIN" Value="." />

    <!-- Secrets: the service account's own logon password (SERVICEACCOUNTPASSWORD) and the
         bearer token (BEARERTOKEN, above) both need a real value with no operator involvement
         required, generated once and then preserved across every subsequent upgrade rather than
         rotated out from under the operator (or, for the account password, out from under the
         service's own already-configured Windows logon). ResolveSecrets (below) is what actually
         resolves both; these two Secure properties are what feed it the prior value on an upgrade,
         found via RegistrySearch into the persisted copies HKLM\SOFTWARE\OutOfTheBox stores (see
         PersistedSecretsComponent) - AppSearch (which runs RegistrySearch) always completes before
         ResolveSecrets' own scheduling point, on both the UI and silent (no-UI) install paths. -->
    <Property Id="EXISTINGBEARERTOKEN" Secure="yes">
      <RegistrySearch Id="ExistingBearerTokenSearch" Root="HKLM" Key="SOFTWARE\OutOfTheBox" Name="BearerToken" Type="raw" />
    </Property>
    <Property Id="EXISTINGSERVICEACCOUNTPASSWORD" Secure="yes">
      <RegistrySearch Id="ExistingServiceAccountPasswordSearch" Root="HKLM" Key="SOFTWARE\OutOfTheBox" Name="ServiceAccountPassword" Type="raw" />
    </Property>

    <!-- The version a prior install left behind, if any - same RegistrySearch-during-AppSearch
         mechanism as the two secrets above, used by ConfigDlg to show "upgrading from vX.Y.Z"
         rather than an operator having to guess whether this is a fresh install or an upgrade. -->
    <Property Id="EXISTINGVERSION" Secure="yes">
      <RegistrySearch Id="ExistingVersionSearch" Root="HKLM" Key="SOFTWARE\OutOfTheBox" Name="Version" Type="raw" />
    </Property>

    <Binary Id="ResolveSecretsCA" SourceFile="$(var.ResolveSecretsCaDllPath)" />
    <CustomAction Id="ResolveSecrets" BinaryRef="ResolveSecretsCA" DllEntry="ResolveSecrets" Execute="immediate" Return="check" />

    <!-- Scheduled in both sequences: InstallUISequence so ConfigDlg's fields already show the
         resolved (generated-or-preserved) values by the time the operator sees the page, and
         InstallExecuteSequence so a genuinely silent (`msiexec /quiet`, no UI at all) install or
         upgrade still resolves them - the two sequences are independent, neither implies the
         other ran. -->
    <InstallUISequence>
      <Custom Action="ResolveSecrets" After="AppSearch" />
    </InstallUISequence>
    <InstallExecuteSequence>
      <Custom Action="ResolveSecrets" After="AppSearch" />
    </InstallExecuteSequence>

    <Feature Id="MainFeature" Title="Out of the Box Service" Level="1">
      <ComponentGroupRef Id="PublishOutputComponents" />
      <ComponentRef Id="ServiceAccountComponent" />
      <ComponentRef Id="DataDirectoryComponent" />
      <ComponentRef Id="ServiceComponent" />
      <ComponentRef Id="FirewallComponent" />
      <ComponentRef Id="PersistedSecretsComponent" />
    </Feature>

    <!-- Persists whatever ResolveSecrets resolved BEARERTOKEN/SERVICEACCOUNTPASSWORD to (freshly
         generated, or reused from here on a prior install) so the *next* upgrade's
         EXISTINGBEARERTOKEN/EXISTINGSERVICEACCOUNTPASSWORD RegistrySearch above finds it - this is
         what makes "upgrades don't change the bearer token, but the operator still can by editing
         ConfigDlg" true: whatever value ConfigDlg ends up showing (generated default, preserved
         prior value, or an operator's own edit) is what gets written here and carried forward.
         Also persists the version just installed, read back by EXISTINGVERSION on the *next*
         upgrade so ConfigDlg can show "upgrading from vX.Y.Z" - not resolved through
         ResolveSecrets since it needs no generate-or-preserve logic, just "always the current
         ProductVersion". Deliberately a plain Registry key (SOFTWARE\OutOfTheBox), not under the
         service's own Services\OutOfTheBox key used for the Environment value in ServiceComponent
         - keeps "where the running process reads its config from" and "where the installer stores
         its own install-to-install bookkeeping" clearly separate, even though the first two values
         currently also happen to be duplicated into that Environment value. -->
    <Component Id="PersistedSecretsComponent" Directory="INSTALLFOLDER" Guid="7c6a1e3a-1b1f-4a1e-9b7a-5b7b6b3a1a05">
      <RegistryValue Root="HKLM" Key="SOFTWARE\OutOfTheBox" Name="BearerToken" Type="string" Value="[BEARERTOKEN]" KeyPath="yes" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\OutOfTheBox" Name="ServiceAccountPassword" Type="string" Value="[SERVICEACCOUNTPASSWORD]" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\OutOfTheBox" Name="Version" Type="string" Value="[ProductVersion]" />
    </Component>

    <!-- Wildcard file harvesting (WiX v4+'s built-in replacement for the old standalone heat.exe
         tool) - every file under the publish output becomes its own Component/File automatically,
         so a new static asset added to Presentation's wwwroot later is picked up without a
         hand-maintained file list silently missing it (see design.md's Chart.js-goes-missing
         risk). OutOfTheBox.Host.exe itself is deliberately excluded here (Exclude) since
         ServiceComponent below already declares it explicitly, as the KeyPath the ServiceInstall/
         ServiceControl elements attach to - a file can't be harvested twice under two different
         Component ids. -->
    <ComponentGroup Id="PublishOutputComponents" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishOutputPath)**">
        <Exclude Files="$(var.PublishOutputPath)OutOfTheBox.Host.exe" />
      </Files>
    </ComponentGroup>

    <!-- Dedicated least-privilege service account (design.md's generic-passthrough risk
         mitigation) - not local admin, not a pre-existing/shared account. Removed on uninstall.

         LogonAsService="yes" is required and was missing until a real install on Windows Server
         2025 Datacenter failed to start the service at all (SCM Event Viewer entry: "Logon
         failure: the user has not been granted the requested logon type at this computer" /
         "This service account does not have the required user right 'Log on as a service.'").
         The comment this replaced claimed the right was "granted automatically once the service
         below is installed to run as this account" - that is FALSE: CreateService/ServiceInstall
         never grants SeServiceLogonRight programmatically, only the interactive Services (
         services.msc) GUI does that as an implicit side effect, which is irrelevant to an
         unattended MSI install. LogonAsService="yes" makes util:User's own account-creation action
         call LsaAddAccountRights directly, independent of and not racing against ServiceInstall's
         own sequencing. -->
    <Component Id="ServiceAccountComponent" Directory="INSTALLFOLDER" Guid="7c6a1e3a-1b1f-4a1e-9b7a-5b7b6b3a1a01">
      <util:User Id="ServiceAccount"
                 Name="[SERVICEACCOUNTNAME]"
                 Password="[SERVICEACCOUNTPASSWORD]"
                 PasswordNeverExpires="yes"
                 CanNotChangePassword="yes"
                 CreateUser="yes"
                 RemoveOnUninstall="yes"
                 UpdateIfExists="yes"
                 LogonAsService="yes">
        <!-- Required for PerformanceCounter access to the Processor category (design.md's resource-
             monitoring risk) - the account wouldn't have this by default otherwise. -->
        <util:GroupRef Id="PerformanceMonitorUsersGroup" />
      </util:User>
    </Component>
    <util:Group Id="PerformanceMonitorUsersGroup" Name="Performance Monitor Users" />

    <!-- Grants the service account read/write on the data directory (config + SQLite file) and
         creates it if it doesn't already exist. Never a Component that gets removed on uninstall -
         see the StandardDirectory comment above. -->
    <Component Id="DataDirectoryComponent" Directory="DATADIRFOLDER" Guid="7c6a1e3a-1b1f-4a1e-9b7a-5b7b6b3a1a02">
      <CreateFolder>
        <util:PermissionEx User="[SERVICEACCOUNTNAME]" GenericAll="yes" />
      </CreateFolder>
    </Component>

    <!-- Windows Service registration (tasks.md 17.7). The Environment multi-string is how the
         config-collection UI's values (and OUTOFTHEBOX_DATA_DIR, so Program.cs finds the data
         directory's own appsettings.json overlay) actually reach the running process - see the
         property comment above for why this is preferred over a custom action writing JSON. -->
    <Component Id="ServiceComponent" Directory="INSTALLFOLDER" Guid="7c6a1e3a-1b1f-4a1e-9b7a-5b7b6b3a1a03">
      <File Id="ServiceExeForInstall" Source="$(var.PublishOutputPath)OutOfTheBox.Host.exe" KeyPath="yes" />

      <!-- Name (the actual SCM service key, matched by ServiceControl/@Name and the Environment
           registry key path below) stays the plain "OutOfTheBox" identifier deliberately - unlike
           DisplayName (what services.msc actually shows an operator), this is a technical key
           other things reference by exact string match, not a place to introduce a space. -->
      <ServiceInstall Id="OutOfTheBoxServiceInstall"
                       Name="OutOfTheBox"
                       DisplayName="[ProductName]"
                       Description="Runs dotnet/git commands and transfers build artifacts for a sandboxed Claude Code caller."
                       Type="ownProcess"
                       Start="auto"
                       ErrorControl="normal"
                       Account="[SERVICEACCOUNTDOMAIN]\[SERVICEACCOUNTNAME]"
                       Password="[SERVICEACCOUNTPASSWORD]">
        <!-- SCM does not restart a crashed service by default (design.md's Packaging decision) -
             this configures the same restart/60s x3 recovery actions the old install.ps1's
             `sc.exe failure` call used to set by hand. -->
        <util:ServiceConfig FirstFailureActionType="restart"
                             SecondFailureActionType="restart"
                             ThirdFailureActionType="restart"
                             RestartServiceDelayInSeconds="60"
                             ResetPeriodInDays="1" />
      </ServiceInstall>
      <ServiceControl Id="OutOfTheBoxServiceControl"
                       Name="OutOfTheBox"
                       Start="install"
                       Stop="both"
                       Remove="uninstall"
                       Wait="yes" />

      <RegistryValue Root="HKLM"
                      Key="SYSTEM\CurrentControlSet\Services\OutOfTheBox"
                      Name="Environment"
                      Type="multiString"
                      Value="OUTOFTHEBOX_DATA_DIR=[DATADIRFOLDER]&#x9;OutOfTheBox__RootDirectory=[REPOROOTDIR]&#x9;OutOfTheBox__BearerToken=[BEARERTOKEN]&#x9;Kestrel__Endpoints__Https__Url=https://0.0.0.0:[PORTNUMBER]" />
    </Component>

    <!-- Firewall rule (tasks.md 17.8) - scoped by port only here (the installer doesn't know the
         sbx sandbox's or operator's IPs at install time); see INSTALL.md for narrowing it to
         specific remote addresses after install, per design.md's Network & transport decision. -->
    <Component Id="FirewallComponent" Directory="INSTALLFOLDER" Guid="7c6a1e3a-1b1f-4a1e-9b7a-5b7b6b3a1a04">
      <fire:FirewallException Id="OutOfTheBoxFirewallRule"
                               Name="Out of the Box"
                               Port="[PORTNUMBER]"
                               Protocol="tcp"
                               Scope="any"
                               IgnoreFailure="yes" />
    </Component>

    <!-- Minimal (Welcome/Progress/Exit only) rather than InstallDir - this installer's own
         install location isn't something an operator needs to choose (per design.md, it's
         disposable/upgrade-replaced), so a directory-chooser page for THAT would be a confusing
         second "pick a folder" step alongside ConfigDlg's own repo-root field below.

         This UI content lives directly under <Package> (not a separate Fragment in its own file)
         deliberately: a Fragment elsewhere is only pulled into the linked output if something
         reachable from <Package> references one of its identifiers, and nothing does that for a
         <ui:WixUI>/<Dialog>/override-<Publish> block on its own - putting it in a standalone
         Fragment silently compiled clean but produced an MSI with no Dialog/Control table at all
         (verified via the Windows Installer COM API directly, since wix msi decompile doesn't
         cover UI tables either - a real "build succeeded, feature entirely absent" trap). -->
    <ui:WixUI Id="WixUI_Minimal" />

    <!-- Config-collection page (tasks.md 17.9) - repo root directory, bearer token, and port,
         written into the service's Environment registry value by ServiceComponent above. Spliced
         into WixUI_Minimal's sequence between the Welcome and Verify-Ready dialogs via overriding
         Publish entries (Order="2", higher than the extension's own default so it wins) - the
         standard WiX pattern for adding a custom page to a stock dialog set.

         Dark theming (see the Binary/comment above): WelcomeDlg/ExitDialog need no changes at all
         - WixUI_Minimal's own "dialog style" layout already covers ~90% of their area with our
         WixUIDialogBmp (the same violet/pink logo art used for the bootstrapper icon etc.), which
         is already dark. ConfigDlg/InvalidConfigDlg are ours outright, themed fully below.

         Every OTHER stock WixUI_Minimal dialog (CancelDlg, ProgressDlg, ...) was deliberately left
         with its default light styling, not by choice but because WiX has no mechanism to override
         an individual dialog from a referenced extension's dialog set: a genuine attempt to
         redeclare CancelDlg/ProgressDlg here (same Id, only Bitmap/TextStyle/Transparent added, no
         behavior changed) failed the build outright with WIX0091 "Duplicate Control/Dialog" - the
         linker treats a same-Id symbol pulled in from `ui:WixUI`'s referenced wixlib as a hard
         conflict with a locally-authored one, not an override; a later attempt at a lighter-weight
         per-control override (a standalone top-level `<ControlCondition>`, mirroring the
         `<Publish Dialog="..." Control="...">` pattern this file already uses to hook into
         WelcomeDlg/VerifyReadyDlg's own Next/Back buttons without redeclaring them) failed too,
         with WIX0005 "unexpected child element" - `<UI>` only accepts a standalone `<Publish>`,
         not a standalone `<ControlCondition>`. Both confirmed by actually trying them and reading
         the linker error, not assumed.

         VerifyReadyDlg (the "Ready to install..." confirmation screen) is the one exception - it's
         reached on every single install, unlike Cancel/Progress which are edge cases, so once the
         combination of `banner-493x58.bmp`'s dark branding (17.9b) and this dialog's own default
         black title text (sitting directly on top of the banner, unreadably) was found on a real
         install, hand-authoring a full replacement was worth the extra risk this section's own
         reasoning above weighs against for the other stock dialogs. `VerifyReadyThemedDlg` below is
         a full copy of stock VerifyReadyDlg's actual compiled behavior (extracted via `wix msi
         decompile` against this project's own build, not reconstructed from memory - the five
         install/change/repair/remove/update states each have their own disk-space-exhaustion
         sub-branches that would be easy to get subtly wrong by hand) under a new Id, themed the
         same way ConfigDlg/InvalidConfigDlg are (full-dialog Background Bitmap, `{\OOTB_Title}`/
         `{\OOTB_Body}` styled Transparent text, no Banner/Line controls - WiX has no mechanism to
         recolor a `Line` control either, same reasoning as those two dialogs already established).
         Native PushButtons (Install/Change/Repair/Remove/Update/Back/Cancel) are left exactly as
         stock renders them, per the same "dark chrome, light inputs" scope decision. Reuses
         `panel-370x270.bmp` - already generated for this exact 370x270 dialog size back when this
         dialog's theming was first attempted and abandoned, left unreferenced ever since. -->
    <UI>
      <TextStyle Id="OOTB_Title" FaceName="Tahoma" Size="9" Bold="yes" Red="255" Green="255" Blue="255" />
      <TextStyle Id="OOTB_Body" FaceName="Tahoma" Size="8" Red="230" Green="232" Blue="235" />
      <TextStyle Id="OOTB_Muted" FaceName="Tahoma" Size="8" Red="154" Green="162" Blue="175" />

      <Dialog Id="ConfigDlg" Width="370" Height="290" Title="Configure [ProductName]">
        <Control Id="Background" Type="Bitmap" X="0" Y="0" Width="370" Height="290" TabSkip="no" Text="PanelBmp370x290" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="{\OOTB_Title}Configure [ProductName] v[ProductVersion]" />
        <!-- Shown only on an upgrade (EXISTINGVERSION is only non-empty when the version-persist
             RegistryValue from a prior install's PersistedSecretsComponent was found during
             AppSearch) - a fresh install shows nothing here, not an empty "Upgrading from v"
             line. -->
        <Control Id="UpgradeNotice" Type="Text" X="15" Y="21" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="{\OOTB_Muted}Upgrading from version [EXISTINGVERSION]"
                 HideCondition="EXISTINGVERSION = &quot;&quot;" ShowCondition="EXISTINGVERSION &lt;&gt; &quot;&quot;" />
        <Control Id="Description" Type="Text" X="15" Y="38" Width="340" Height="20" Transparent="yes" NoPrefix="yes"
                 Text="{\OOTB_Muted}These values are written into the Windows Service's own environment and can be changed later by editing the registry or reinstalling." />

        <Control Id="RepoRootLabel" Type="Text" X="15" Y="73" Width="150" Height="15" Transparent="yes" NoPrefix="yes" Text="{\OOTB_Body}Repository root directory:" />
        <Control Id="RepoRootEdit" Type="Edit" X="15" Y="88" Width="340" Height="18" Property="REPOROOTDIR" Text="{80}" />

        <Control Id="BearerTokenLabel" Type="Text" X="15" Y="113" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="{\OOTB_Body}Bearer token (the shared credential the sbx sandbox caller must present) - a random one is pre-filled below; change it if you want your own:" />
        <Control Id="BearerTokenEdit" Type="Edit" X="15" Y="128" Width="340" Height="18" Property="BEARERTOKEN" Text="{80}" />

        <Control Id="PortLabel" Type="Text" X="15" Y="153" Width="150" Height="15" Transparent="yes" NoPrefix="yes" Text="{\OOTB_Body}Port:" />
        <Control Id="PortEdit" Type="Edit" X="15" Y="168" Width="80" Height="18" Property="PORTNUMBER" Text="{80}" />

        <Control Id="Back" Type="PushButton" X="180" Y="263" Width="56" Height="17" Text="Back">
          <Publish Event="NewDialog" Value="WelcomeDlg" Order="1" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="263" Width="56" Height="17" Text="Next">
          <!-- Refuse to proceed without a repo root and a non-trivial bearer token - an installer
               that silently accepted blank/weak values here would produce a service that's either
               broken (no root configured) or authenticated by an empty credential. Port left
               unvalidated beyond "not blank" - msiexec/Kestrel will fail loudly enough on a
               genuinely invalid one, and duplicating full numeric-range validation here isn't
               worth the extra dialog complexity for a v1 config page. -->
          <Publish Event="SpawnDialog" Value="InvalidConfigDlg" Order="1" Condition="REPOROOTDIR = &quot;&quot; OR BEARERTOKEN = &quot;&quot; OR PORTNUMBER = &quot;&quot;" />
          <Publish Event="NewDialog" Value="VerifyReadyThemedDlg" Order="2" Condition="REPOROOTDIR &lt;&gt; &quot;&quot; AND BEARERTOKEN &lt;&gt; &quot;&quot; AND PORTNUMBER &lt;&gt; &quot;&quot;" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="263" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" Order="1" />
        </Control>
      </Dialog>

      <!-- Minimal message dialog for the Next-button validation above - reuses the same OK-only
           shape as WiX's own stock error dialogs rather than introducing a new visual pattern. -->
      <Dialog Id="InvalidConfigDlg" Width="260" Height="85" Title="Configure [ProductName]">
        <Control Id="Background" Type="Bitmap" X="0" Y="0" Width="260" Height="85" TabSkip="no" Text="PanelBmp260x85" />
        <Control Id="Text" Type="Text" X="10" Y="10" Width="240" Height="40" Transparent="yes" NoPrefix="yes"
                 Text="{\OOTB_Body}Repository root directory, bearer token, and port are all required." />
        <Control Id="OK" Type="PushButton" X="95" Y="55" Width="56" Height="17" Text="OK">
          <Publish Event="EndDialog" Value="Return" Order="1" />
        </Control>
      </Dialog>

      <!-- Full replacement for stock VerifyReadyDlg (see the comment above this <UI> block for why
           this one dialog gets the full-rewrite treatment the others don't) - every Control/Publish
           below is copied from `wix msi decompile` output against this project's own compiled MSI,
           i.e. the actual current stock behavior including the two <Publish Dialog="..."> overrides
           this file used to add externally, now folded directly into this dialog's own Back control
           instead (no longer needed as external overrides once this dialog is fully owned). Only
           the Background control, the *Title/*Text controls' styling (added Transparent="yes" +
           {\OOTB_*} style prefix), and the dropped Banner/Line controls differ from stock. -->
      <Dialog Id="VerifyReadyThemedDlg" X="50" Y="50" Width="370" Height="270" TrackDiskSpace="yes" Title="[ProductName] Setup">
        <Control Id="Background" Type="Bitmap" X="0" Y="0" Width="370" Height="270" TabSkip="no" Text="PanelBmp370x270" />

        <Control Id="Install" Type="PushButton" X="212" Y="243" Width="80" Height="17" Text="&amp;Install" Disabled="yes" Hidden="yes" ElevationShield="yes" ShowCondition="NOT Installed AND ALLUSERS" EnableCondition="NOT Installed" DefaultCondition="NOT Installed" TabSkip="no">
          <Publish Condition="OutOfDiskSpace &lt;&gt; 1" Event="EndDialog" Value="Return" />
          <Publish Condition="OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND (PROMPTROLLBACKCOST=&quot;P&quot; OR NOT PROMPTROLLBACKCOST)" Event="SpawnDialog" Value="OutOfRbDiskDlg" />
          <Publish Condition="OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND PROMPTROLLBACKCOST=&quot;D&quot;" Event="EndDialog" Value="Return" />

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net472, not net10.0: this DLL is loaded in-process by msiexec.exe (a native host), and
         .NET Framework 4.7.2 is present on every supported Windows version out of the box - using
         it avoids this custom action depending on any .NET runtime OutOfTheBox itself needs
         (this installer's whole point is to *establish* that runtime, so the installer's own
         custom action can't assume it's there yet). -->
    <TargetFramework>net472</TargetFramework>
    <!-- Overrides the repo-root Directory.Build.props' <Nullable>enable</Nullable>/
         <ImplicitUsings>enable</ImplicitUsings> - net472's default C# language version (7.3)
         predates both nullable reference type syntax and global using directives entirely. -->
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Dtf.WindowsInstaller" Version="7.0.0" />
    <PackageReference Include="WixToolset.Dtf.CustomAction" Version="7.0.0" />
  </ItemGroup>

  <!-- Must be a Content item, not None: WixToolset.Dtf.CustomAction's PackCustomAction target only
       embeds @(Content) items (plus copy-local references) into the .CA.dll SFXCA package - nothing
       auto-generates a CustomAction.config, despite the SFXCA host looking for one by this exact
       name at runtime. Without it, SfxCA.dll falls back to guessing which CLR to host, which failed
       for real on a genuine Windows 11 test machine ("SFXCA: Failed to get requested CLR info. Error
       code 0x80131700") despite .NET Framework 4.8.1 being present - this is a decades-old, still
       load-bearing WiX/DTF quirk (traced to the same error message and fix in WiX's own issue
       tracker going back to WiX 3.5), not something specific to this machine or this Framework
       version. useLegacyV2RuntimeActivationPolicy="true" is required alongside supportedRuntime, not
       optional - omitting it reproduces the exact same failure. -->
  <ItemGroup>
    <Content Include="CustomAction.config" />
  </ItemGroup>

</Project>

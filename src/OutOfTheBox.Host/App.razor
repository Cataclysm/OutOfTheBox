@using static Microsoft.AspNetCore.Components.Web.RenderMode
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#4c1d95" />
    <title>Out of the Box</title>
    <base href="/" />
    <link rel="icon" type="image/x-icon" href="_content/OutOfTheBox.Presentation/favicon.ico" />
    <link rel="stylesheet" href="@Assets["_content/OutOfTheBox.Presentation/css/vendor/codemirror.min.css"]" />
    <link rel="stylesheet" href="@Assets["_content/OutOfTheBox.Presentation/css/dashboard.css"]" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <div id="components-reconnect-modal" data-nosnippet>
        <span class="reconnect-text-show">Reconnecting to Out of the Box&hellip;</span>
        <span class="reconnect-text-failed">Connection lost. <a href=".">Reload</a> to reconnect.</span>
        <span class="reconnect-text-rejected">Session expired. <a href=".">Reload</a> to continue.</span>
    </div>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/OutOfTheBox.Presentation/js/vendor/chart.umd.min.js"]"></script>
    <script src="@Assets["_content/OutOfTheBox.Presentation/js/vendor/chartjs-adapter-native.js"]"></script>
    <script src="@Assets["_content/OutOfTheBox.Presentation/js/chart-interop.js"]"></script>
    <script src="@Assets["_content/OutOfTheBox.Presentation/js/vendor/codemirror.min.js"]"></script>
    <script src="@Assets["_content/OutOfTheBox.Presentation/js/codemirror-interop.js"]"></script>
    <script src="@Assets["_content/OutOfTheBox.Presentation/js/dialog-interop.js"]"></script>
</body>
</html>

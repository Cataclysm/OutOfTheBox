<Project>
  <!--
    Self-contained, single-file, win-x64 publish profile (tasks.md 17.1) - matches design.md's
    Packaging decision verbatim. IncludeNativeLibrariesForSelfExtract is required because the
    SQLite provider ships a native library (e_sqlite3.dll); without it, single-file publishing
    fails to resolve that native dependency at run time. PublishTrimmed is explicitly false -
    Blazor Server and EF Core are reflection-heavy, and trimming risks removing code only reached
    dynamically, causing runtime failures that are hard to catch pre-deployment; the larger binary
    (100+ MB) is an accepted trade-off for reliability.

    Usage: dotnet publish src/OutOfTheBox.Host -c Release -p:PublishProfile=win-x64 -o <output-dir>
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>

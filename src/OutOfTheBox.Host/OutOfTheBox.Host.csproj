<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\OutOfTheBox.Domain\OutOfTheBox.Domain.csproj" />
    <ProjectReference Include="..\OutOfTheBox.Application\OutOfTheBox.Application.csproj" />
    <ProjectReference Include="..\OutOfTheBox.Infrastructure\OutOfTheBox.Infrastructure.csproj" />
    <ProjectReference Include="..\OutOfTheBox.Presentation\OutOfTheBox.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <!-- Design-time only, same reasoning as Infrastructure's own reference: `dotnet ef` requires
         the *startup* project to reference this package too, not just the project containing the
         DbContext, in order to run `dotnet ef migrations add`. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>

</Project>

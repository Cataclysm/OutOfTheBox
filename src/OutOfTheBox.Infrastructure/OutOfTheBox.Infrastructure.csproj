<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OutOfTheBox.Application\OutOfTheBox.Application.csproj" />
    <ProjectReference Include="..\OutOfTheBox.Domain\OutOfTheBox.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- Glob (*, **, ?) matching for the MCP find_files tool - Directory.EnumerateFileSystemEntries'
         own wildcard support is limited to a single path segment and doesn't understand **. -->
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
    <!-- BackgroundService, for RepositoryStatsSampler (and, later, the host-resource sampler). -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <!-- Direct reference so the pinned (patched) version in Directory.Packages.props actually
         wins over the older, vulnerable one EF Core Sqlite would otherwise pull in transitively. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" />
    <PackageReference Include="System.Management" />
  </ItemGroup>

  <ItemGroup>
    <!-- Design-time only: needed to run `dotnet ef migrations add`, not referenced by any
         production code path (migrations are applied at startup via Database.Migrate(), which
         only needs the Sqlite package above). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>

</Project>

@page "/mcp-settings"
@attribute [Authorize]
@using OutOfTheBox.Application.Mcp
@using OutOfTheBox.Domain.Execution
@using OutOfTheBox.Domain.Mcp
@inject IMcpPermissionStore PermissionStore

<PageTitle>@VersionInfo.DisplayName - MCP Settings</PageTitle>

<h1>MCP Settings</h1>

<p>
    Enable or disable individual MCP tools, and individual <code>dotnet_run</code>/<code>git_run</code>
    subcommands, for the sbx sandbox caller. Changes apply immediately to the next call - nothing here
    needs a restart. Hover or focus a row's icon for what it allows, how it works, and why it's rated
    that way.
</p>

<div class="mcp-settings-legend">
    <span><span class="mcp-tip-icon mcp-risk-dangerous" aria-hidden="true"></span> dangerous - can destroy data, reach outside the repository, or expose a credential</span>
    <span><span class="mcp-tip-icon mcp-risk-info" aria-hidden="true"></span> safe, but may reveal information</span>
    <span><span class="mcp-tip-icon mcp-risk-safe" aria-hidden="true"></span> safe</span>
</div>

@if (_state is null)
{
    <p>Loading...</p>
}
else
{
    <div class="mcp-settings-groups">
        <fieldset>
            <legend>dotnet subcommands</legend>
            @foreach (var subcommand in DotnetSubcommands)
            {
                var key = McpToolCatalog.SubcommandKey("dotnet", subcommand);
                var tip = McpPermissionTooltips.For(key);
                <label>
                    <input type="checkbox" checked="@_state[key]" @onchange="@(e => ToggleAsync(key, (bool)e.Value!))" />
                    @RenderTip(tip)
                    @subcommand
                </label>
            }
        </fieldset>

        <fieldset>
            <legend>git subcommands</legend>
            @foreach (var subcommand in GitSubcommands)
            {
                var key = McpToolCatalog.SubcommandKey("git", subcommand);
                var tip = McpPermissionTooltips.For(key);
                <label>
                    <input type="checkbox" checked="@_state[key]" @onchange="@(e => ToggleAsync(key, (bool)e.Value!))" />
                    @RenderTip(tip)
                    @subcommand
                </label>
            }
        </fieldset>

        @foreach (var group in ToolGroups)
        {
            <fieldset>
                <legend>@group.Name</legend>
                @foreach (var key in group.Keys)
                {
                    var tip = McpPermissionTooltips.For(key);
                    <label>
                        <input type="checkbox" checked="@_state[key]" @onchange="@(e => ToggleAsync(key, (bool)e.Value!))" />
                        @RenderTip(tip)
                        @key
                    </label>
                }
            </fieldset>
        }
    </div>
}

@code {
    /// <summary>
    /// The nineteen plain tools, grouped for the page the same way <c>Credentials.razor</c>/
    /// <c>History.razor</c> already group their own filter <c>&lt;fieldset&gt;</c>s - purely a
    /// presentation grouping, not reflected in <see cref="McpToolCatalog"/> itself (Domain doesn't
    /// know about UI layout).
    /// </summary>
    private static readonly (string Name, string[] Keys)[] ToolGroups =
    [
        ("Run management", ["read_run_output", "cancel_run", "get_run_resources"]),
        ("Repository management", ["list_repositories", "delete_repository", "clone_repository"]),
        ("File management", ["find_files", "get_file_info", "delete_path", "transfer_file", "get_file_lock_info"]),
        ("Git credentials", ["authorize_git_host", "list_authorized_git_hosts", "revoke_git_host_authorization"]),
        ("NuGet credentials", ["authorize_nuget_feed", "list_authorized_nuget_feeds", "revoke_nuget_feed_authorization"]),
        ("Diagnostics", ["get_environment_info", "get_mcp_permissions"]),
    ];

    private static readonly IReadOnlyCollection<string> DotnetSubcommands = CommandSubcommandPolicy.KnownSubcommandsFor("dotnet");
    private static readonly IReadOnlyCollection<string> GitSubcommands = CommandSubcommandPolicy.KnownSubcommandsFor("git");

    private Dictionary<string, bool>? _state;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        var all = await PermissionStore.GetAllAsync(CancellationToken.None);
        _state = new Dictionary<string, bool>(all, StringComparer.Ordinal);
    }

    private static string RiskClass(McpPermissionRiskLevel level) => level switch
    {
        McpPermissionRiskLevel.Dangerous => "mcp-risk-dangerous",
        McpPermissionRiskLevel.InfoExposure => "mcp-risk-info",
        _ => "mcp-risk-safe",
    };

    private static RenderFragment RenderTip(McpPermissionTooltip tip) => @<span class="mcp-tip" tabindex="0">
        <span class="mcp-tip-icon @RiskClass(tip.Level)" aria-hidden="true"></span>
        <span class="mcp-tip-bubble">
            <strong>What</strong>@tip.What
            <strong>How</strong>@tip.How
            <strong>Risk</strong>@tip.Risk
        </span>
    </span>;

    private async Task ToggleAsync(string key, bool enabled)
    {
        await PermissionStore.SetEnabledAsync(key, enabled, CancellationToken.None);
        _state![key] = enabled;
    }
}

<svg class="icon @CssClass" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @GetPaths()
</svg>

@code {
    /// <summary>
    /// Which icon to render - one of the names listed in <c>wwwroot/icons/ATTRIBUTION.md</c>
    /// (vendored from Lucide, ISC-licensed). Rendered as inline SVG (not <c>&lt;img src&gt;</c>) so
    /// <c>stroke="currentColor"</c> picks up the surrounding element's CSS <c>color</c> - what lets
    /// e.g. the repository git-action buttons flash green/red on completion via a CSS class alone.
    /// </summary>
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    /// <summary>Additional CSS class(es) applied alongside the base <c>icon</c> class.</summary>
    [Parameter]
    public string? CssClass { get; set; }

    private MarkupString GetPaths() => new(Name switch
    {
        "trash" => """<path d="M10 11v6" /><path d="M14 11v6" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" /><path d="M3 6h18" /><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />""",
        "download" => """<path d="M12 15V3" /><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><path d="m7 10 5 5 5-5" />""",
        "pull" => """<circle cx="12" cy="12" r="10" /><path d="M12 8v8" /><path d="m8 12 4 4 4-4" />""",

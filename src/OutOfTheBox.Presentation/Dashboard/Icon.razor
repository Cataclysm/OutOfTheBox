@using System.Collections.Concurrent
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Hosting

<svg class="icon @CssClass" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @GetPaths()
</svg>

@code {
    /// <summary>
    /// Which icon to render - one of the keys in <see cref="IconFiles"/>, backed by the matching
    /// vendored file under <c>wwwroot/icons</c> (Lucide, https://lucide.dev, ISC-licensed - see that
    /// directory's own ATTRIBUTION.md for the full vendored set and how to add another). Rendered as
    /// inline SVG (not <c>&lt;img src&gt;</c>) so <c>stroke="currentColor"</c> picks up the
    /// surrounding element's CSS <c>color</c> - what lets e.g. the repository git-action buttons
    /// flash green/red on completion via a CSS class alone - so each vendored file's inner markup is
    /// read once per icon name and cached (see <see cref="_pathsCache"/>) rather than the file being
    /// fetched by the browser.
    /// </summary>
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    /// <summary>Additional CSS class(es) applied alongside the base <c>icon</c> class.</summary>
    [Parameter]
    public string? CssClass { get; set; }

    [Inject]
    private IWebHostEnvironment WebHostEnvironment { get; set; } = null!;

    private static readonly ConcurrentDictionary<string, string> _pathsCache = new();

    private static readonly Regex InnerSvgPattern = new("<svg[^>]*>(?<inner>.*)</svg>", RegexOptions.Singleline | RegexOptions.Compiled);

    private static readonly Dictionary<string, string> IconFiles = new()
    {
        ["trash"] = "trash-2.svg",
        ["download"] = "download.svg",
        ["pull"] = "circle-arrow-down.svg",
        ["push"] = "circle-arrow-up.svg",
        ["force-push"] = "chevrons-up.svg",
        ["fetch"] = "refresh-cw.svg",
        ["clean"] = "eraser.svg",
        ["branch"] = "git-branch.svg",
        ["clear-filters"] = "list-filter.svg",
        ["close"] = "x.svg",
        ["confirm"] = "check.svg",
        ["folder"] = "folder.svg",
        ["folder-open"] = "folder-open.svg",
        ["file"] = "file.svg",
        ["pencil"] = "pencil.svg",
        ["tag"] = "tag.svg",
        ["checkout"] = "map-pin.svg",
        ["ahead"] = "arrow-up.svg",
        ["behind"] = "arrow-down.svg",
        ["remote-gone"] = "triangle-alert.svg",
        ["avatar-placeholder"] = "circle-user.svg",
        ["credential"] = "key.svg",
        ["key"] = "key.svg",
        ["add"] = "plus.svg",
    };

    private MarkupString GetPaths() => new(_pathsCache.GetOrAdd(Name, LoadInnerMarkup));

    private string LoadInnerMarkup(string name)
    {
        if (!IconFiles.TryGetValue(name, out var fileName))
        {
            return string.Empty;
        }

        var file = WebHostEnvironment.WebRootFileProvider.GetFileInfo($"_content/OutOfTheBox.Presentation/icons/{fileName}");
        if (!file.Exists)
        {
            return string.Empty;
        }

        using var stream = file.CreateReadStream();
        using var reader = new StreamReader(stream);
        var svg = reader.ReadToEnd();
        var match = InnerSvgPattern.Match(svg);
        return match.Success ? match.Groups["inner"].Value.Trim() : string.Empty;
    }
}

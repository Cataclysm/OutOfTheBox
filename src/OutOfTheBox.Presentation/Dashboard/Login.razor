@page "/login"
@layout LoginLayout
@attribute [AllowAnonymous]

<PageTitle>@VersionInfo.DisplayName - Log in</PageTitle>

<div class="login-card">
    <div class="login-logo-wrap">
        <img src="_content/OutOfTheBox.Presentation/img/logo.png" alt="@VersionInfo.DisplayName" class="login-logo" />
    </div>
    <h1>@VersionInfo.DisplayName</h1>

    @if (Error)
    {
        <p class="login-error">Invalid token.</p>
    }

    <form method="post" action="account/login">
        <label for="token">Token</label>
        <input type="password" id="token" name="token" autocomplete="current-password" autofocus />
        <button type="submit">Log in</button>
    </form>
</div>

@code {
    /// <summary>Set when the previous login attempt failed - reflected via a query string, since this page renders before any circuit-scoped state exists.</summary>
    [SupplyParameterFromQuery(Name = "error")]
    public string? ErrorFlag { get; set; }

    private bool Error => ErrorFlag is not null;
}

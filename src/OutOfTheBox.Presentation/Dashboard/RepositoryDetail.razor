@page "/repository-management/{Name}"
@attribute [Authorize]
@using System.Globalization
@using OutOfTheBox.Application.Execution
@using OutOfTheBox.Application.Repositories
@using OutOfTheBox.Domain.Repositories
@inject IRepositoryManager RepositoryManager
@inject IRunRepository RunRepository
@inject IWorkingDirectoryResolver WorkingDirectoryResolver
@inject IRepositoryStatsEventBus RepositoryStatsEventBus
@inject NavigationManager NavigationManager
@implements IDisposable

<PageTitle>@VersionInfo.DisplayName - @Name</PageTitle>

<a class="back-link" href="repository-management">← Back to Repositories</a>

<h1>@Name</h1>

@if (_summary is null)
{
    <p>Loading...</p>
}
else
{
    <dl>
        <dt>Status</dt>
        <dd>@(_summary.IsActive ? "Active" : "Idle")</dd>
        <dt>Path</dt>
        <dd>@_summary.Path</dd>
        <dt>Size</dt>
        <dd>@(_summary.StatsComputed ? $"{_summary.TotalSizeBytes:N0} bytes" : "Computing…")</dd>
        <dt>Git status</dt>
        <dd>@GitStatusText(_summary)</dd>
        @if (_summary.IsGitRepository)
        {
            <dt>Branch</dt>
            <dd>
                <select value="@_summary.Branch" @onchange="OnBranchSelectedAsync" disabled="@(_branches.Count == 0)">
                    @if (_summary.Branch is not null && !_branches.Any(b => !b.IsRemote && b.Name == _summary.Branch))
                    {
                        <option value="@_summary.Branch">@_summary.Branch</option>
                    }
                    @foreach (var branch in _branches)
                    {
                        <option value="@branch.Name">@branch.Name@(branch.IsRemote ? " (remote)" : string.Empty)</option>
                    }
                </select>
                @if (_branchSwitchError is not null)
                {
                    <span class="login-error">@_branchSwitchError</span>
                }
            </dd>
            <dt>Clone source</dt>
            <dd>@(_cloneSourceUrl ?? "Unknown (not cloned through this service, or history since pruned)")</dd>
            <dt>Remotes</dt>
            <dd>
                @if (_summary.Remotes.Count == 0)
                {
                    @:None configured
                }
                else
                {
                    <ul class="remote-list">
                        @foreach (var remote in _summary.Remotes)
                        {
                            <li><strong>@remote.Name</strong>: @remote.Url</li>
                        }
                    </ul>
                }
            </dd>
        }
    </dl>

    <div class="tab-group">
        @if (_summary.IsGitRepository)
        {
            <button type="button" class="tab-button @(_activeTab == DetailTab.Commits ? "active" : "")" @onclick="@(() => _activeTab = DetailTab.Commits)">Commits</button>
        }
        <button type="button" class="tab-button @(_activeTab == DetailTab.Files ? "active" : "")" @onclick="@(() => _activeTab = DetailTab.Files)">Files</button>
        <button type="button" class="tab-button @(_activeTab == DetailTab.History ? "active" : "")" @onclick="@(() => _activeTab = DetailTab.History)">History</button>
    </div>

    @if (_activeTab == DetailTab.Commits && _summary.IsGitRepository)
    {
        <CommitGraph RepositoryName="@Name" OnBranchSwitched="RefreshBranchStateAsync" />
    }
    else if (_activeTab == DetailTab.Files)
    {
        <FileTree RepositoryName="@Name" />
    }
    else
    {
        @if (_runs is null)
        {
            <p>Loading...</p>
        }
        else if (_runs.Count == 0)
        {
            <p class="empty-state">No runs recorded against this repository yet.</p>
        }
        else
        {
            <table class="data-table clickable-rows">
                <colgroup>
                    <col style="width:7rem" />
                    <col style="width:9rem" />
                    <col />
                    <col style="width:11rem" />
                </colgroup>
                <thead>
                    <tr>
                        <th @onclick="@(() => SortBy(SortColumn.Kind))">Kind@(SortIndicator(SortColumn.Kind))</th>
                        <th @onclick="@(() => SortBy(SortColumn.Outcome))">Outcome@(SortIndicator(SortColumn.Outcome))</th>
                        <th @onclick="@(() => SortBy(SortColumn.Detail))">Detail@(SortIndicator(SortColumn.Detail))</th>
                        <th @onclick="@(() => SortBy(SortColumn.Started))">Started@(SortIndicator(SortColumn.Started))</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var run in SortedRuns())
                    {
                        <tr @onclick="@(() => NavigationManager.NavigateTo($"history/{run.Id}"))">
                            <td><span class="kind-badge kind-@run.Kind.ToString().ToLowerInvariant()">@run.Kind.ShortLabel()</span></td>
                            <td>@run.Outcome.Label()</td>
                            <td class="ellipsis" title="@RunDisplay.Detail(run)">@RunDisplay.Detail(run)</td>
                            <td>@FormatDateTime(run.StartedAt)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
}

@code {
    /// <summary>The repository name from the route (<c>/repository-management/{Name}</c>).</summary>
    [Parameter]
    public string Name { get; set; } = string.Empty;

    private RepositorySummary? _summary;
    private IReadOnlyList<Run>? _runs;
    private SortColumn _sortColumn = SortColumn.Started;
    private bool _sortAscending;
    private IDisposable? _statsSubscription;
    private string? _cloneSourceUrl;
    private IReadOnlyList<RepositoryBranch> _branches = [];
    private string? _branchSwitchError;
    private DetailTab _activeTab = DetailTab.Commits;

    private enum DetailTab
    {
        Commits,
        Files,
        History,
    }

    private enum SortColumn
    {
        Kind,
        Outcome,
        Detail,
        Started,
    }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        await RefreshSummaryAsync();

        // Commits isn't a valid tab for a non-git repository - the tab-group never renders that
        // button for one, so the default active tab needs to move too, or the content area would
        // fall through to History (the last @else branch) with no button showing as active. Only
        // done once, here, not on every later stats-triggered RefreshSummaryAsync - otherwise an
        // operator on the History tab would get silently kicked back the next time stats refresh.
        if (_summary is not null && !_summary.IsGitRepository)
        {
            _activeTab = DetailTab.Files;
        }

        // Reuses the same RunQuery/IRunRepository.ListAsync mechanism the History view's list uses
        // (per task 13.14), pre-filtered to this repository's resolved path - the route only carries the
        // repository's name, so it's resolved the same way any repository-relative path is before querying.
        var resolution = WorkingDirectoryResolver.Resolve(Name);
        _runs = resolution.IsAllowed
            ? await RunRepository.ListAsync(new RunQuery { RepositoryPath = resolution.ResolvedPath }, CancellationToken.None)
            : [];

        _cloneSourceUrl = await RepositoryManager.GetCloneSourceUrlAsync(Name, CancellationToken.None);
        _branches = await RepositoryManager.ListBranchesAsync(Name, CancellationToken.None);

        // Otherwise this page, left open on a repository whose stats aren't cached yet, would sit
        // showing "Computing…" forever - unlike Repositories.razor, it has no other event subscription
        // at all to piggyback a refresh onto. See IRepositoryStatsEventBus's own remarks.
        _statsSubscription = RepositoryStatsEventBus.Subscribe(OnRepositoryStatsChanged);
    }

    private async Task OnBranchSelectedAsync(ChangeEventArgs e)
    {
        var branch = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(branch) || branch == _summary?.Branch)
        {
            return;
        }

        _branchSwitchError = null;
        var result = await RepositoryManager.SwitchBranchAsync(Name, branch, CancellationToken.None);

        if (result is RepositoryGitActionResult.Failed failed)
        {
            _branchSwitchError = failed.ErrorMessage ?? "Branch switch failed.";
        }
        else if (result is RepositoryGitActionResult.Rejected rejected)
        {
            _branchSwitchError = rejected.Reason == RepositoryActionRejectionReason.Busy
                ? $"Busy - conflicting run {rejected.ConflictingRunId}."
                : "Rejected.";
        }

        await RefreshBranchStateAsync();
    }

    // Re-fetches both the summary (its Branch/IsDirty/... drive the <dl>) and the branch list (the
    // dropdown's own <option>s) together - a switch that checks out a remote branch for the first
    // time creates a new local tracking branch _branches doesn't know about yet, so refreshing only
    // the summary would leave the dropdown's option list stale even though its selected value still
    // shows correctly (via the synthetic fallback option below). Called after every branch switch,
    // regardless of whether it was triggered from this page's own dropdown or a commit graph badge.
    private async Task RefreshBranchStateAsync()
    {
        await RefreshSummaryAsync();
        _branches = await RepositoryManager.ListBranchesAsync(Name, CancellationToken.None);
    }

    private void OnRepositoryStatsChanged(string repositoryName)
    {
        if (!string.Equals(repositoryName, Name, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await RefreshSummaryAsync();
            StateHasChanged();
        });
    }

    private async Task RefreshSummaryAsync()
    {
        var summaries = await RepositoryManager.ListAsync(CancellationToken.None);
        _summary = summaries.FirstOrDefault(r => string.Equals(r.Name, Name, StringComparison.OrdinalIgnoreCase));
    }

    /// <inheritdoc />
    public void Dispose() => _statsSubscription?.Dispose();

    private void SortBy(SortColumn column)
    {
        if (_sortColumn == column)
        {
            _sortAscending = !_sortAscending;
        }
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
    }

    private string SortIndicator(SortColumn column) => _sortColumn == column ? (_sortAscending ? " ▲" : " ▼") : string.Empty;

    private IEnumerable<Run> SortedRuns()
    {
        IEnumerable<Run> ordered = _sortColumn switch
        {
            SortColumn.Kind => _runs!.OrderBy(r => r.Kind.ShortLabel(), StringComparer.OrdinalIgnoreCase),
            SortColumn.Outcome => _runs!.OrderBy(r => r.Outcome.Label(), StringComparer.OrdinalIgnoreCase),
            SortColumn.Detail => _runs!.OrderBy(RunDisplay.Detail, StringComparer.OrdinalIgnoreCase),
            _ => _runs!.OrderBy(r => r.StartedAt),
        };

        return _sortAscending ? ordered : ordered.Reverse();
    }

    private static string GitStatusText(RepositorySummary repository)
    {
        if (!repository.StatsComputed)
        {
            return "Computing…";
        }

        if (!repository.IsGitRepository)
        {
            return "Not a git repository";
        }

        var branchText = repository.IsDetachedHead ? $"detached at {repository.Branch}" : repository.Branch ?? "(no branch)";
        var status = $"{branchText} ({(repository.IsDirty ? "dirty" : "clean")})";

        if (repository.IsRemoteGone)
        {
            status += ", remote gone";
        }
        else
        {
            if (repository.AheadCount is > 0)
            {
                status += $", ahead {repository.AheadCount}";
            }

            if (repository.BehindCount is > 0)
            {
                status += $", behind {repository.BehindCount}";
            }
        }

        return status;
    }

    // Local time, no offset suffix - see RunDetail.razor's own FormatDateTime for why.
    private static string FormatDateTime(DateTimeOffset value) =>
        value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture);
}

@using OutOfTheBox.Application.Repositories
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject IGitCredentialStore GitCredentialStore
@inject INuGetFeedCredentialStore NuGetFeedCredentialStore

<dialog @ref="_dialogElement">
    <div class="dialog-body">
        <h2>Change credential</h2>
        <label>
            @(_isGitHost ? "Host" : "Feed URL")
            <input type="text" value="@_serverOrFeed" disabled />
        </label>
        <label>
            Personal access token
            <input type="password" @bind="_token" @bind:event="oninput" />
        </label>
        @if (_error is not null)
        {
            <span class="login-error">@_error</span>
        }
        <div class="dialog-actions">
            <button type="button" @onclick="CancelAsync">
                <Icon Name="close" CssClass="icon-inline" /> Cancel
            </button>
            <button type="button" class="btn-primary" @onclick="SaveAsync" disabled="@_submitting">
                <Icon Name="key" CssClass="icon-inline" /> Save
            </button>
        </div>
    </div>
</dialog>

@code {
    /// <summary>
    /// Replaces an already-authorized credential from the Credentials page, by clicking its row -
    /// per direct instruction, replacing the previous per-repository "change credential" action.
    /// Unlike <see cref="AddCredentialDialog"/>, the type and the host/feed URL are both fixed (they
    /// identify which existing credential is being changed, per the row that was clicked), so only a
    /// new token is entered - saving calls the same <c>AuthorizeAsync</c> either store already
    /// exposes, which replaces the existing credential for that host/feed URL rather than duplicating it.
    /// </summary>
    [Parameter]
    public EventCallback OnSaved { get; set; }

    private ElementReference _dialogElement;
    private bool _isGitHost;
    private string _serverOrFeed = string.Empty;
    private string _token = string.Empty;
    private string? _error;
    private bool _submitting;

    /// <summary>Opens the dialog for an already-authorized credential, with an empty token field.</summary>
    public async Task ShowAsync(bool isGitHost, string serverOrFeed)
    {
        _isGitHost = isGitHost;
        _serverOrFeed = serverOrFeed;
        _token = string.Empty;
        _error = null;
        StateHasChanged();
        await JS.ShowModalAsync(_dialogElement);
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_token))
        {
            _error = "Enter a token.";
            return;
        }

        _submitting = true;

        try
        {
            _error = _isGitHost ? await AuthorizeGitHostAsync() : await AuthorizeNuGetFeedAsync();

            if (_error is not null)
            {
                return;
            }

            await JS.CloseAsync(_dialogElement);
            await OnSaved.InvokeAsync();
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task<string?> AuthorizeGitHostAsync()
    {
        var result = await GitCredentialStore.AuthorizeAsync(_serverOrFeed, _token, CancellationToken.None);
        return result switch
        {
            GitCredentialAuthorizeResult.Succeeded => null,
            GitCredentialAuthorizeResult.NoCredentialHelperConfigured =>
                "No git credential helper is configured on this host - reinstall Git for Windows, or run `git config --global credential.helper manager`.",
            GitCredentialAuthorizeResult.VerificationFailed =>
                "That token didn't work - it may be invalid, or missing the required scope.",
            GitCredentialAuthorizeResult.GitUnreachable gitUnreachable => $"git could not be started: {gitUnreachable.ErrorMessage}",
            _ => "That token didn't work.",
        };
    }

    private async Task<string?> AuthorizeNuGetFeedAsync()
    {
        var result = await NuGetFeedCredentialStore.AuthorizeAsync(_serverOrFeed, _token, CancellationToken.None);
        return result switch
        {
            NuGetCredentialAuthorizeResult.Succeeded => null,
            NuGetCredentialAuthorizeResult.InvalidFeedUrl => "That's not a valid absolute http/https feed URL.",
            NuGetCredentialAuthorizeResult.VerificationFailed =>
                "The credential was written but could not be verified as retrievable - the write may not have persisted.",
            NuGetCredentialAuthorizeResult.ConfigurationUnwritable unwritable =>
                $"This machine's NuGet configuration could not be accessed: {unwritable.ErrorMessage}",
            NuGetCredentialAuthorizeResult.CredentialProviderNotInstalled =>
                "That's an Azure DevOps Artifacts feed, but the Azure Artifacts Credential Provider is not installed on this system.",
            _ => "That token didn't work.",
        };
    }

    private async Task CancelAsync() => await JS.CloseAsync(_dialogElement);
}

@using OutOfTheBox.Application.Repositories
@inject IRepositoryManager RepositoryManager

<button type="button" class="icon-button @FlashClass("pull")" title="Pull" @onclick="@(() => RunGitActionAsync("pull", RepositoryManager.PullAsync))">
    <Icon Name="pull" />
</button>
<button type="button" class="icon-button @FlashClass("push")" title="Push" @onclick="@(() => RunGitActionAsync("push", RepositoryManager.PushAsync))">
    <Icon Name="push" />
</button>
<button type="button" class="icon-button @FlashClass("force-push")" title="Force push" @onclick="@(() => ConfirmAndRunAsync("force-push", "Force push", $"Force-push '{RepositoryName}'? This can overwrite the remote's history.", RepositoryManager.ForcePushAsync))">
    <Icon Name="force-push" />
</button>
<button type="button" class="icon-button @FlashClass("fetch")" title="Fetch" @onclick="@(() => RunGitActionAsync("fetch", RepositoryManager.FetchAsync))">
    <Icon Name="fetch" />
</button>
<button type="button" class="icon-button @FlashClass("clean")" title="Clean (git clean -xdf)" @onclick="@(() => ConfirmAndRunAsync("clean", "Clean", $"Run 'git clean -xdf' on '{RepositoryName}'? This permanently deletes every untracked file.", RepositoryManager.CleanAsync))">
    <Icon Name="clean" />
</button>

<ConfirmDialog @ref="_confirmDialog" />

@code {
    /// <summary>
    /// The pull/push/force-push/fetch/clean action row - shared by <c>Repositories.razor</c>'s list
    /// (one instance per row) and <c>RepositoryDetail.razor</c> (one instance for the currently
    /// viewed repository), per specs/repository-management's "Dashboard-only pull/push/force-push/
    /// fetch/clean actions" requirement, so both surfaces reach the exact same behavior (including
    /// the flash-on-completion outcome reporting) through one implementation rather than two that
    /// could drift apart. Deliberately excludes rename/delete - unlike these five, both have
    /// navigation implications specific to where they're invoked from (a list row disappearing vs.
    /// a detail page needing to redirect away from a name that no longer resolves), so those stay
    /// wherever they're already implemented rather than folded in here too.
    /// </summary>
    [Parameter, EditorRequired]
    public string RepositoryName { get; set; } = string.Empty;

    /// <summary>Raised after any action completes (success or failure) - the caller's own summary/list is what actually changed, not this component's.</summary>
    [Parameter]
    public EventCallback OnActionCompleted { get; set; }

    private ConfirmDialog? _confirmDialog;

    /// <summary>Per action name, the CSS class briefly applied to report its outcome - no streamed output, per specs/repository-management's "Outcome is shown without a console view" requirement.</summary>
    private readonly Dictionary<string, string> _flashClasses = [];

    private Task ConfirmAndRunAsync(string action, string title, string message, Func<string, CancellationToken, Task<RepositoryGitActionResult>> operation) =>
        _confirmDialog!.ShowAsync(title, message, () => RunGitActionAsync(action, operation));

    private async Task RunGitActionAsync(string action, Func<string, CancellationToken, Task<RepositoryGitActionResult>> operation)
    {
        var result = await operation(RepositoryName, CancellationToken.None);
        _flashClasses[action] = result is RepositoryGitActionResult.Succeeded ? "flash-success" : "flash-fail";
        StateHasChanged();

        await OnActionCompleted.InvokeAsync();

        _ = ClearFlashAfterDelayAsync(action);
    }

    private async Task ClearFlashAfterDelayAsync(string action)
    {
        await Task.Delay(TimeSpan.FromSeconds(2.5));
        _flashClasses.Remove(action);
        await InvokeAsync(StateHasChanged);
    }

    private string FlashClass(string action) => _flashClasses.GetValueOrDefault(action, string.Empty);
}

@using OutOfTheBox.Application.Repositories
@using OutOfTheBox.Domain.Repositories
@inject IRepositoryGitActions RepositoryGitActions

<button type="button" class="icon-button @FlashClass("pull")" title="@Title("pull", "Pull")" @onclick="@(() => RunGitActionAsync("pull", RepositoryGitActions.PullAsync))">
    <Icon Name="pull" />
</button>
<button type="button" class="icon-button @FlashClass("push")" title="@Title("push", "Push")" @onclick="@(() => RunGitActionAsync("push", RepositoryGitActions.PushAsync))">
    <Icon Name="push" />
</button>
<button type="button" class="icon-button @FlashClass("force-push")" title="@Title("force-push", "Force push")" @onclick="@(() => ConfirmAndRunAsync("force-push", "Force push", $"Force-push '{RepositoryName}'? This can overwrite the remote's history.", RepositoryGitActions.ForcePushAsync))">
    <Icon Name="force-push" />
</button>
<button type="button" class="icon-button @FlashClass("fetch")" title="@Title("fetch", "Fetch")" @onclick="@(() => RunGitActionAsync("fetch", RepositoryGitActions.FetchAsync))">
    <Icon Name="fetch" />
</button>
<button type="button" class="icon-button @FlashClass("clean")" title="@Title("clean", "Clean (git clean -xdf)")" @onclick="@(() => ConfirmAndRunAsync("clean", "Clean", $"Run 'git clean -xdf' on '{RepositoryName}'? This permanently deletes every untracked file.", RepositoryGitActions.CleanAsync))">
    <Icon Name="clean" />
</button>

<ConfirmDialog @ref="_confirmDialog" />

@code {
    /// <summary>
    /// The pull/push/force-push/fetch/clean action row - shared by <c>Repositories.razor</c>'s list
    /// (one instance per row) and <c>RepositoryDetail.razor</c> (one instance for the currently
    /// viewed repository), per specs/repository-management's "Dashboard-only pull/push/force-push/
    /// fetch/clean actions" requirement, so both surfaces reach the exact same behavior (including
    /// the flash-on-completion outcome reporting) through one implementation rather than two that
    /// could drift apart. Deliberately excludes rename/delete - unlike these five, both have
    /// navigation implications specific to where they're invoked from (a list row disappearing vs. a
    /// detail page needing to redirect away from a name that no longer resolves), so those stay
    /// wherever they're already implemented rather than folded in here too. Also excludes changing a
    /// git credential (previously a per-repository action here) - per direct instruction, that's now
    /// done from the Credentials page instead, by clicking the host's own row.
    /// </summary>
    [Parameter, EditorRequired]
    public string RepositoryName { get; set; } = string.Empty;

    /// <summary>Raised after any action completes (success or failure) - the caller's own summary/list is what actually changed, not this component's.</summary>
    [Parameter]
    public EventCallback OnActionCompleted { get; set; }

    private ConfirmDialog? _confirmDialog;

    /// <summary>Per action name, the CSS class briefly applied to report its outcome - no streamed output, per specs/repository-management's "Outcome is shown without a console view" requirement.</summary>
    private readonly Dictionary<string, string> _flashClasses = [];

    /// <summary>
    /// Per action name, the real failure detail (previously discarded entirely) shown as a tooltip -
    /// a passive, hover-only surface, never a popup, per specs/repository-management's "A failed
    /// action's detail is available without an interrupting prompt" scenario.
    /// </summary>
    private readonly Dictionary<string, string> _flashTitles = [];

    private Task ConfirmAndRunAsync(string action, string title, string message, Func<string, CancellationToken, Task<RepositoryGitActionResult>> operation) =>
        _confirmDialog!.ShowAsync(title, message, () => RunGitActionAsync(action, operation));

    private async Task RunGitActionAsync(string action, Func<string, CancellationToken, Task<RepositoryGitActionResult>> operation)
    {
        var result = await operation(RepositoryName, CancellationToken.None);
        Flash(action, succeeded: result is RepositoryGitActionResult.Succeeded, errorMessage: (result as RepositoryGitActionResult.Failed)?.ErrorMessage);

        await OnActionCompleted.InvokeAsync();
    }

    private void Flash(string action, bool succeeded, string? errorMessage)
    {
        _flashClasses[action] = succeeded ? "flash-success" : "flash-fail";
        _flashTitles[action] = succeeded || string.IsNullOrEmpty(errorMessage)
            ? DefaultTitle(action)
            : GitAuthFailureClassifier.IsLikelyAuthFailure(errorMessage)
                ? "Authentication failed - update the credential from the Credentials page."
                : errorMessage;
        StateHasChanged();

        _ = ClearFlashAfterDelayAsync(action);
    }

    private async Task ClearFlashAfterDelayAsync(string action)
    {
        await Task.Delay(TimeSpan.FromSeconds(2.5));
        _flashClasses.Remove(action);
        _flashTitles.Remove(action);
        await InvokeAsync(StateHasChanged);
    }

    private string FlashClass(string action) => _flashClasses.GetValueOrDefault(action, string.Empty);

    private string Title(string action, string defaultTitle) => _flashTitles.GetValueOrDefault(action, defaultTitle);

    private static string DefaultTitle(string action) => action switch
    {
        "pull" => "Pull",
        "push" => "Push",
        "force-push" => "Force push",
        "fetch" => "Fetch",
        "clean" => "Clean (git clean -xdf)",
        _ => action,
    };
}

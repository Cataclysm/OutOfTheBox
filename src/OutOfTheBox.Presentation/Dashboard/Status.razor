@page "/"
@attribute [Authorize]
@using System.Globalization
@using OutOfTheBox.Application.Diagnostics
@using OutOfTheBox.Application.Execution
@using OutOfTheBox.Application.Monitoring
@using OutOfTheBox.Presentation.Dashboard.Charts
@inject IRunRepository RunRepository
@inject IRunEventBus RunEventBus
@inject IResourceEventBus ResourceEventBus
@inject IProcessMonitor ProcessMonitor
@inject IInstalledToolVersionsProvider InstalledToolVersionsProvider
@inject IRootDirectoryDiskSpaceProvider DiskSpaceProvider
@inject NavigationManager NavigationManager
@implements IDisposable

<PageTitle>@VersionInfo.DisplayName - Status</PageTitle>

<h1>Status</h1>

<!-- Two rows, per direct request - identity/version tiles (rarely change, nothing to watch) apart
     from the live resource tiles (the ones an operator is actually monitoring), rather than all
     seven crowded into one row. -->
<div class="resource-tiles">
    <div class="resource-tile">
        <span class="resource-tile-label">Service</span>
        <span class="resource-tile-value">@VersionInfo.Current</span>
    </div>
    <div class="resource-tile">
        <span class="resource-tile-label">Uptime</span>
        <span class="resource-tile-value">@ServiceUptime.Format(DateTimeOffset.UtcNow)</span>
    </div>
    <div class="resource-tile">
        <span class="resource-tile-label">Git Version</span>
        <span class="resource-tile-value">@(_toolVersions.GitVersion ?? "not detected")</span>
    </div>
    <div class="resource-tile">
        <span class="resource-tile-label">.NET Version</span>
        <span class="resource-tile-value">@(_toolVersions.DotnetVersion ?? "not detected")</span>
    </div>
</div>

<div class="resource-tiles">
    <div class="resource-tile">
        <span class="resource-tile-label">Host CPU</span>
        <span class="resource-tile-value">@FormatPercent(_host.TotalCpuPercent)</span>
    </div>
    <div class="resource-tile">
        <span class="resource-tile-label">Host RAM</span>
        <span class="resource-tile-value">@FormatBytes(_host.TotalRamBytes - _host.AvailableRamBytes) / @FormatBytes(_host.TotalRamBytes)</span>
    </div>
    <div class="resource-tile">
        <span class="resource-tile-label">Service RAM</span>
        <span class="resource-tile-value">@FormatBytes(_host.ServiceRamBytes)</span>
    </div>
    <div class="resource-tile">
        <span class="resource-tile-label">Disk Space</span>
        <span class="resource-tile-value">@FormatBytes(_diskSpace.AvailableFreeBytes) free / @FormatBytes(_diskSpace.TotalBytes)</span>
    </div>
</div>

<LiveResourceGraph SeriesKey="@ResourceHistoryBuffer.HostSeriesKey" />

@if (_runs is null)
{
    <p>Loading...</p>
}
else if (!DisplayedRuns().Any())
{
    <p class="empty-state">Idle - no runs in flight.</p>
}
else
{
    <table class="data-table clickable-rows run-table">
        <colgroup>
            <col style="width:1%" />
            <col style="width:1%" />
            <col style="width:1%" />
            <col />
            <col style="width:1%" />
            <col style="width:1%" />
        </colgroup>
        <thead>
            <tr>
                <th class="col-shrink not-sortable">Kind</th>
                <th class="col-shrink not-sortable">Repository</th>
                <th class="col-shrink not-sortable">Run ID</th>
                <th class="not-sortable">Command</th>
                <th class="col-shrink not-sortable">Elapsed</th>
                <th class="col-shrink not-sortable">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var run in DisplayedRuns())
            {
                <tr @key="run.Id" class="@(_exitingRunIds.Contains(run.Id) ? ListAnimation.ExitingClass : null)" @onclick="@(() => NavigationManager.NavigateTo($"history/{run.Id}"))">
                    <td class="col-shrink"><span class="kind-badge kind-@run.Kind.ToString().ToLowerInvariant()">@run.Kind.ShortLabel()</span></td>
                    <td class="col-shrink ellipsis" title="@RunDisplay.RepositoryName(run)">@RunDisplay.RepositoryName(run)</td>
                    <td class="col-shrink">@run.Id</td>
                    <td class="ellipsis" title="@RunDisplay.Detail(run)">@RunDisplay.Detail(run)</td>
                    <td class="col-shrink">@Elapsed(run)</td>
                    <td class="col-shrink actions">
                        <button type="button" class="run-graph-toggle" @onclick="@(() => ToggleExpanded(run.Id))" @onclick:stopPropagation="true">@(_expandedRunIds.Contains(run.Id) ? "Hide graph" : "Show graph")</button>
                        @if (_processesByRun.TryGetValue(run.Id, out var processesForToggle) && processesForToggle.Count > 0)
                        {
                            <button type="button" class="run-graph-toggle process-toggle" @onclick="@(() => ToggleProcessesExpanded(run.Id))" @onclick:stopPropagation="true">@(_expandedProcessRunIds.Contains(run.Id) ? "Hide processes" : "Show processes")</button>
                        }
                    </td>
                </tr>

                @* Process table intentionally rendered after the graph, not before, when both are
                   expanded - matches the order an operator expands them in (graph first, per its
                   longer-standing toggle position) and per direct request. Each expansion is its own
                   full-width row (colspan across every column above) rather than trying to fit either
                   inside a single cell. *@
                @if (_expandedRunIds.Contains(run.Id))
                {
                    <tr @key="@($"{run.Id}-graph")" class="run-expansion-row">
                        <td class="run-expansion-cell" colspan="6">
                            <LiveResourceGraph SeriesKey="@run.Id.ToString()" Note="@(run.Kind == RunKind.FileTransfer ? "Host activity during transfer - no isolated per-transfer figure is possible." : null)" />
                        </td>
                    </tr>
                }

                @if (_expandedProcessRunIds.Contains(run.Id) && _processesByRun.TryGetValue(run.Id, out var processes) && processes.Count > 0)
                {
                    <tr @key="@($"{run.Id}-processes")" class="run-expansion-row">
                        <td class="run-expansion-cell" colspan="6">
                            <div class="process-table-container">
                                <table class="data-table process-table">
                                    <colgroup>
                                        <col />
                                        <col style="width:1%" />
                                        <col style="width:1%" />
                                        <col style="width:1%" />
                                        <col style="width:1%" />
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th @onclick="@(() => SortProcessesBy(ProcessSortColumn.Name))">Process@(ProcessSortIndicator(ProcessSortColumn.Name))</th>
                                            <th class="col-shrink" @onclick="@(() => SortProcessesBy(ProcessSortColumn.ProcessId))">PID@(ProcessSortIndicator(ProcessSortColumn.ProcessId))</th>
                                            <th class="col-shrink" @onclick="@(() => SortProcessesBy(ProcessSortColumn.Cpu))">CPU %@(ProcessSortIndicator(ProcessSortColumn.Cpu))</th>
                                            <th class="col-shrink" @onclick="@(() => SortProcessesBy(ProcessSortColumn.Ram))">RAM@(ProcessSortIndicator(ProcessSortColumn.Ram))</th>
                                            <th class="col-shrink not-sortable">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var process in SortedProcesses(processes))
                                        {
                                            <tr @key="process.ProcessId">
                                                <td class="ellipsis" title="@process.ProcessName">@process.ProcessName</td>
                                                <td class="col-shrink">@process.ProcessId</td>
                                                <td class="col-shrink">@FormatPercent(process.CpuPercent)</td>
                                                <td class="col-shrink">@FormatBytes(process.RamBytes)</td>
                                                <td class="col-shrink actions"><button type="button" class="process-kill-button" @onclick="@(() => KillAsync(process))">Kill</button></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<Run>? _runs;
    private IDisposable? _runSubscription;
    private IDisposable? _resourceSubscription;
    private Timer? _elapsedTimer;

    private HostResourceSample _host = new(0, [], 0, 0, 0, 0, 0);
    private Dictionary<Guid, IReadOnlyList<ProcessResourceSample>> _processesByRun = [];
    private readonly HashSet<Guid> _expandedRunIds = [];
    private readonly HashSet<Guid> _expandedProcessRunIds = [];

    /// <summary>
    /// A run that just went terminal, held here (and so still shown in <see cref="DisplayedRuns"/>)
    /// for <see cref="MinimumCompletedVisibleDuration"/> after its own <see cref="RunEventType.Terminal"/>
    /// event - a run that finishes in well under that window (a `git status`, a fast `dotnet build`
    /// incremental no-op) would otherwise appear and disappear from this list almost too fast to
    /// register as having run at all.
    /// </summary>
    private readonly Dictionary<Guid, Run> _recentlyCompletedRuns = [];

    /// <summary>Run ids that just went terminal and are playing their exit animation before dropping off this list - see <see cref="ListAnimation"/>.</summary>
    private readonly HashSet<Guid> _exitingRunIds = [];
    private InstalledToolVersions _toolVersions = new(null, null);
    private DiskSpaceInfo _diskSpace = new(0, 0);
    private ProcessSortColumn _processSortColumn = ProcessSortColumn.Name;
    private bool _processSortAscending = true;

    private static readonly TimeSpan MinimumCompletedVisibleDuration = TimeSpan.FromSeconds(10);

    private enum ProcessSortColumn
    {
        Name,
        ProcessId,
        Cpu,
        Ram,
    }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();

        // A run already in flight when this page first loads is treated the same as one that just
        // started for expansion purposes (see OnRunEvent's own Started handling below) - otherwise
        // whether a running row starts expanded would depend on page-load timing relative to when the
        // run actually started, rather than simply "is it running."
        foreach (var run in _runs ?? [])
        {
            _expandedRunIds.Add(run.Id);
            _expandedProcessRunIds.Add(run.Id);
        }

        _toolVersions = await InstalledToolVersionsProvider.GetVersionsAsync(CancellationToken.None);
        _diskSpace = await DiskSpaceProvider.GetDiskSpaceAsync(CancellationToken.None);
        _runSubscription = RunEventBus.Subscribe(OnRunEvent);
        _resourceSubscription = ResourceEventBus.Subscribe(OnResourceSnapshot);

        // Elapsed time needs to keep advancing even between run-started/run-terminal events, since
        // a long-running command produces neither for minutes at a time.
        _elapsedTimer = new Timer(_ => InvokeAsync(StateHasChanged), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void OnRunEvent(RunEvent runEvent)
    {
        if (runEvent.Type is RunEventType.OutputLine)
        {
            // The Status list shows summary fields only (repository, kind, elapsed time, ...), not a
            // live output preview - re-rendering the whole list per stdout/stderr line would be
            // both wasteful and not what task 12.7 scopes this view to.
            return;
        }

        // Auto-expand on start, auto-collapse on terminal, per direct request - the operator's own
        // manual toggle (ToggleExpanded/ToggleProcessesExpanded) still works exactly as before on top
        // of this default, since both are just plain HashSet membership; only the *initial* state
        // after each transition is driven here, not a permanent lock on it. Deliberately not gated on
        // "does this run actually have a graph/processes yet" - expanding pre-emptively means the
        // section is already visible the instant its first data point arrives, rather than the
        // operator needing to notice and click a toggle that only then appears.
        if (runEvent.Type == RunEventType.Started)
        {
            _expandedRunIds.Add(runEvent.RunId);
            _expandedProcessRunIds.Add(runEvent.RunId);
        }
        else if (runEvent.Type == RunEventType.Terminal)
        {
            // Collapsed immediately, not after MinimumCompletedVisibleDuration's own hold below - a
            // finished run's graph/process data is no longer changing, so there's nothing "live" left
            // to keep showing expanded for the row's own separate still-visible-for-a-moment purpose.
            _expandedRunIds.Remove(runEvent.RunId);
            _expandedProcessRunIds.Remove(runEvent.RunId);
        }

        _ = InvokeAsync(async () =>
        {
            if (runEvent.Type == RunEventType.Terminal)
            {
                // Held here for MinimumCompletedVisibleDuration before this list ever drops it, then
                // played as an exit animation on its own row rather than just vanishing, the same
                // "animate the specific thing that changed" treatment RepositoryManagement/Credentials
                // give their own delete/remove actions - see _recentlyCompletedRuns' own remarks.
                var completedRun = await RunRepository.FindByIdAsync(runEvent.RunId, CancellationToken.None);
                if (completedRun is not null)
                {
                    _recentlyCompletedRuns[runEvent.RunId] = completedRun;
                }

                await RefreshAsync();
                StateHasChanged();

                await Task.Delay(MinimumCompletedVisibleDuration);

                _exitingRunIds.Add(runEvent.RunId);
                StateHasChanged();
                await Task.Delay(ListAnimation.ExitDuration);
                _exitingRunIds.Remove(runEvent.RunId);
                _recentlyCompletedRuns.Remove(runEvent.RunId);
                StateHasChanged();
                return;
            }

            await RefreshAsync();
            StateHasChanged();
        });
    }

    /// <summary>
    /// Every currently-running run, plus any recently-terminal one still within its
    /// <see cref="MinimumCompletedVisibleDuration"/> hold (deduplicated - a run refreshed into
    /// <c>_runs</c> as no-longer-running and still held here at the same time is shown once, not
    /// twice).
    /// </summary>
    private IEnumerable<Run> DisplayedRuns()
    {
        if (_runs is null)
        {
            yield break;
        }

        foreach (var run in _runs)
        {
            yield return run;
        }

        foreach (var run in _recentlyCompletedRuns.Values)
        {
            if (_runs.All(r => r.Id != run.Id))
            {
                yield return run;
            }
        }
    }

    private void OnResourceSnapshot(ResourceSnapshot snapshot)
    {
        _ = InvokeAsync(() =>
        {
            _host = snapshot.Host;

            // Grouped under each run's own row, never a flat global table, and never populated
            // for a transfer or delete - both fall out naturally, since neither ever appears in
            // snapshot.Runs (RunRegistry only records a process id for dotnet/git/clone runs).
            _processesByRun = snapshot.Runs.ToDictionary(r => r.RunId, r => r.Processes);

            StateHasChanged();
        });
    }

    private async Task RefreshAsync() =>
        _runs = await RunRepository.ListAsync(new RunQuery { Outcomes = [RunOutcome.Running] }, CancellationToken.None);

    private async Task KillAsync(ProcessResourceSample process) =>
        await ProcessMonitor.KillAsync(process.ProcessId, process.StartTime, CancellationToken.None);

    // Per design.md's "Chart rendering is lazy" decision: a run's live chart isn't mounted (no JS
    // interop, no per-run IResourceEventBus-driven subscription via LiveResourceGraph) until the
    // operator explicitly expands its card.
    private void ToggleExpanded(Guid runId)
    {
        if (!_expandedRunIds.Remove(runId))
        {
            _expandedRunIds.Add(runId);
        }
    }

    // Mirrors ToggleExpanded above - the process table is its own independently expandable section,
    // per direct request, not tied to the graph's own toggle state.
    private void ToggleProcessesExpanded(Guid runId)
    {
        if (!_expandedProcessRunIds.Remove(runId))
        {
            _expandedProcessRunIds.Add(runId);
        }
    }

    private IEnumerable<ProcessResourceSample> SortedProcesses(IReadOnlyList<ProcessResourceSample> processes)
    {
        IEnumerable<ProcessResourceSample> ordered = _processSortColumn switch
        {
            ProcessSortColumn.ProcessId => processes.OrderBy(p => p.ProcessId),
            ProcessSortColumn.Cpu => processes.OrderBy(p => p.CpuPercent),
            ProcessSortColumn.Ram => processes.OrderBy(p => p.RamBytes),
            _ => processes.OrderBy(p => p.ProcessName, StringComparer.OrdinalIgnoreCase),
        };

        return _processSortAscending ? ordered : ordered.Reverse();
    }

    // One shared sort state for every expanded run's process table, not one per run - mirrors every
    // other sortable .data-table in this project (History, Repositories, Credentials), none of which
    // carry independent per-instance sort state either.
    private void SortProcessesBy(ProcessSortColumn column)
    {
        if (_processSortColumn == column)
        {
            _processSortAscending = !_processSortAscending;
        }
        else
        {
            _processSortColumn = column;
            _processSortAscending = true;
        }
    }

    private string ProcessSortIndicator(ProcessSortColumn column) => _processSortColumn == column ? (_processSortAscending ? " ▲" : " ▼") : string.Empty;

    // A held-but-completed run (see _recentlyCompletedRuns) has its own CompletedAt - freezing the
    // display at that moment once set, rather than letting it keep counting up past when the run
    // actually finished.
    private static string Elapsed(Run run)
    {
        var elapsed = (run.CompletedAt ?? DateTimeOffset.UtcNow) - run.StartedAt;
        return elapsed.TotalHours >= 1 ? elapsed.ToString(@"h\:mm\:ss") : elapsed.ToString(@"mm\:ss");
    }

    // Explicitly invariant-culture-formatted - left to the current culture, this would render
    // "0,0%" instead of "0.0%" on a host configured for a comma-decimal locale, which is exactly
    // the kind of thing that's easy to never notice on a US/UK-locale development machine and only
    // surface once deployed to a host with different regional settings. Found by actually
    // rendering this component (bUnit) and observing the literal output, not by review.
    private static string FormatPercent(double value) => $"{value.ToString("F1", CultureInfo.InvariantCulture)}%";

    private static string FormatBytes(long bytes) => bytes switch
    {
        >= 1024L * 1024 * 1024 => $"{(bytes / (1024.0 * 1024 * 1024)).ToString("F1", CultureInfo.InvariantCulture)} GB",
        >= 1024L * 1024 => $"{(bytes / (1024.0 * 1024)).ToString("F1", CultureInfo.InvariantCulture)} MB",
        >= 1024L => $"{(bytes / 1024.0).ToString("F1", CultureInfo.InvariantCulture)} KB",
        _ => $"{bytes} B",
    };

    /// <inheritdoc />
    public void Dispose()
    {
        _runSubscription?.Dispose();
        _resourceSubscription?.Dispose();
        _elapsedTimer?.Dispose();
    }
}

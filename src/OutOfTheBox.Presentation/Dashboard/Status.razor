@page "/"
@attribute [Authorize]
@using System.Globalization
@using OutOfTheBox.Application.Execution
@using OutOfTheBox.Application.Monitoring
@using OutOfTheBox.Presentation.Dashboard.Charts
@inject IRunRepository RunRepository
@inject IRunEventBus RunEventBus
@inject IResourceEventBus ResourceEventBus
@inject IProcessMonitor ProcessMonitor
@inject IInstalledToolVersionsProvider InstalledToolVersionsProvider
@implements IDisposable

<PageTitle>@VersionInfo.DisplayName - Status</PageTitle>

<h1>Status</h1>

<div class="resource-tiles">
    <div class="resource-tile">
        <span class="resource-tile-label">Host CPU</span>
        <span class="resource-tile-value">@FormatPercent(_host.TotalCpuPercent)</span>
    </div>
    <div class="resource-tile">
        <span class="resource-tile-label">Host RAM</span>
        <span class="resource-tile-value">@FormatBytes(_host.TotalRamBytes - _host.AvailableRamBytes) / @FormatBytes(_host.TotalRamBytes)</span>
    </div>
    <div class="resource-tile">
        <span class="resource-tile-label">Service RAM</span>
        <span class="resource-tile-value">@FormatBytes(_host.ServiceRamBytes)</span>
    </div>
    <div class="resource-tile">
        <span class="resource-tile-label">Service</span>
        <span class="resource-tile-value">@VersionInfo.Current</span>
    </div>
    <div class="resource-tile">
        <span class="resource-tile-label">Uptime</span>
        <span class="resource-tile-value">@ServiceUptime.Format(DateTimeOffset.UtcNow)</span>
    </div>
    <div class="resource-tile">
        <span class="resource-tile-label">Git Version</span>
        <span class="resource-tile-value">@(_toolVersions.GitVersion ?? "not detected")</span>
    </div>
    <div class="resource-tile">
        <span class="resource-tile-label">.NET Version</span>
        <span class="resource-tile-value">@(_toolVersions.DotnetVersion ?? "not detected")</span>
    </div>
</div>

<LiveResourceGraph SeriesKey="@ResourceHistoryBuffer.HostSeriesKey" />

@if (_runs is null)
{
    <p>Loading...</p>
}
else if (_runs.Count == 0)
{
    <p class="empty-state">Idle - no runs in flight.</p>
}
else
{
    <ul class="run-list">
        @foreach (var run in _runs)
        {
            <li @key="run.Id" class="status-run @(_exitingRunIds.Contains(run.Id) ? ListAnimation.ExitingClass : null)">
                <div class="run-row">
                    <span class="kind-badge kind-@run.Kind.ToString().ToLowerInvariant()">@run.Kind.ShortLabel()</span>
                    <span class="run-repository">@RunDisplay.RepositoryName(run)</span>
                    <span class="run-id">@run.Id</span>
                    <span class="run-detail">@RunDisplay.Detail(run)</span>
                    <span class="run-elapsed">@Elapsed(run)</span>
                    <button type="button" class="run-graph-toggle" @onclick="@(() => ToggleExpanded(run.Id))">@(_expandedRunIds.Contains(run.Id) ? "Hide graph" : "Show graph")</button>
                </div>

                @if (_processesByRun.TryGetValue(run.Id, out var processes) && processes.Count > 0)
                {
                    <ul class="process-list">
                        @foreach (var process in processes)
                        {
                            <li @key="process.ProcessId" class="process-row">
                                <span>@process.ProcessName (@process.ProcessId)</span>
                                <span>@FormatPercent(process.CpuPercent)</span>
                                <span>@FormatBytes(process.RamBytes)</span>
                                <button type="button" @onclick="@(() => KillAsync(process))">Kill</button>
                            </li>
                        }
                    </ul>
                }

                @if (_expandedRunIds.Contains(run.Id))
                {
                    <LiveResourceGraph SeriesKey="@run.Id.ToString()" Note="@(run.Kind == RunKind.FileTransfer ? "Host activity during transfer - no isolated per-transfer figure is possible." : null)" />
                }
            </li>
        }
    </ul>
}

@code {
    private IReadOnlyList<Run>? _runs;
    private IDisposable? _runSubscription;
    private IDisposable? _resourceSubscription;
    private Timer? _elapsedTimer;

    private HostResourceSample _host = new(0, [], 0, 0, 0, 0, 0);
    private Dictionary<Guid, IReadOnlyList<ProcessResourceSample>> _processesByRun = [];
    private readonly HashSet<Guid> _expandedRunIds = [];

    /// <summary>Run ids that just went terminal and are playing their exit animation before dropping off this list - see <see cref="ListAnimation"/>.</summary>
    private readonly HashSet<Guid> _exitingRunIds = [];
    private InstalledToolVersions _toolVersions = new(null, null);

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        _toolVersions = await InstalledToolVersionsProvider.GetVersionsAsync(CancellationToken.None);
        _runSubscription = RunEventBus.Subscribe(OnRunEvent);
        _resourceSubscription = ResourceEventBus.Subscribe(OnResourceSnapshot);

        // Elapsed time needs to keep advancing even between run-started/run-terminal events, since
        // a long-running command produces neither for minutes at a time.
        _elapsedTimer = new Timer(_ => InvokeAsync(StateHasChanged), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void OnRunEvent(RunEvent runEvent)
    {
        if (runEvent.Type is RunEventType.OutputLine)
        {
            // The Status list shows summary fields only (repository, kind, elapsed time, ...), not a
            // live output preview - re-rendering the whole list per stdout/stderr line would be
            // both wasteful and not what task 12.7 scopes this view to.
            return;
        }

        _ = InvokeAsync(async () =>
        {
            // A run reaching a terminal state drops off this list on the very next refresh - played
            // as an exit animation on its own row first, rather than the row just vanishing, the same
            // "animate the specific thing that changed" treatment RepositoryManagement/Credentials
            // give their own delete/remove actions.
            if (runEvent.Type == RunEventType.Terminal)
            {
                _exitingRunIds.Add(runEvent.RunId);
                StateHasChanged();
                await Task.Delay(ListAnimation.ExitDuration);
                _exitingRunIds.Remove(runEvent.RunId);
            }

            await RefreshAsync();
            StateHasChanged();
        });
    }

    private void OnResourceSnapshot(ResourceSnapshot snapshot)
    {
        _ = InvokeAsync(() =>
        {
            _host = snapshot.Host;

            // Grouped under each run's own row, never a flat global table, and never populated
            // for a transfer or delete - both fall out naturally, since neither ever appears in
            // snapshot.Runs (RunRegistry only records a process id for dotnet/git/clone runs).
            _processesByRun = snapshot.Runs.ToDictionary(r => r.RunId, r => r.Processes);

            StateHasChanged();
        });
    }

    private async Task RefreshAsync() =>
        _runs = await RunRepository.ListAsync(new RunQuery { Outcomes = [RunOutcome.Running] }, CancellationToken.None);

    private async Task KillAsync(ProcessResourceSample process) =>
        await ProcessMonitor.KillAsync(process.ProcessId, process.StartTime, CancellationToken.None);

    // Per design.md's "Chart rendering is lazy" decision: a run's live chart isn't mounted (no JS
    // interop, no per-run IResourceEventBus-driven subscription via LiveResourceGraph) until the
    // operator explicitly expands its card.
    private void ToggleExpanded(Guid runId)
    {
        if (!_expandedRunIds.Remove(runId))
        {
            _expandedRunIds.Add(runId);
        }
    }

    private static string Elapsed(Run run)
    {
        var elapsed = DateTimeOffset.UtcNow - run.StartedAt;
        return elapsed.TotalHours >= 1 ? elapsed.ToString(@"h\:mm\:ss") : elapsed.ToString(@"mm\:ss");
    }

    // Explicitly invariant-culture-formatted - left to the current culture, this would render
    // "0,0%" instead of "0.0%" on a host configured for a comma-decimal locale, which is exactly
    // the kind of thing that's easy to never notice on a US/UK-locale development machine and only
    // surface once deployed to a host with different regional settings. Found by actually
    // rendering this component (bUnit) and observing the literal output, not by review.
    private static string FormatPercent(double value) => $"{value.ToString("F1", CultureInfo.InvariantCulture)}%";

    private static string FormatBytes(long bytes) => bytes switch
    {
        >= 1024L * 1024 * 1024 => $"{(bytes / (1024.0 * 1024 * 1024)).ToString("F1", CultureInfo.InvariantCulture)} GB",
        >= 1024L * 1024 => $"{(bytes / (1024.0 * 1024)).ToString("F1", CultureInfo.InvariantCulture)} MB",
        >= 1024L => $"{(bytes / 1024.0).ToString("F1", CultureInfo.InvariantCulture)} KB",
        _ => $"{bytes} B",
    };

    /// <inheritdoc />
    public void Dispose()
    {
        _runSubscription?.Dispose();
        _resourceSubscription?.Dispose();
        _elapsedTimer?.Dispose();
    }
}

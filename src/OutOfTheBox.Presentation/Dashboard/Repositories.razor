@page "/repository-management"
@attribute [Authorize]
@using System.Globalization
@using OutOfTheBox.Application.Concurrency
@using OutOfTheBox.Application.Repositories
@using OutOfTheBox.Domain.Repositories
@inject IRepositoryManager RepositoryManager
@inject IRunRepository RunRepository
@inject RunRegistry RunRegistry
@inject IRunEventBus RunEventBus
@inject IRepositoryStatsEventBus RepositoryStatsEventBus
@inject NavigationManager NavigationManager
@implements IDisposable

<PageTitle>@VersionInfo.DisplayName - Repositories</PageTitle>

<h1>Repositories</h1>

<div class="history-filters">
    <label>
        Search
        <input type="text" @bind="_searchText" @bind:event="oninput" placeholder="Repository name" />
    </label>
    <label>
        <input type="checkbox" @bind="_activeOnly" /> Active only
    </label>
    <label>
        Git status
        <select @bind="_gitStatusFilter">
            <option value="">(any)</option>
            <option value="clean">Clean</option>
            <option value="dirty">Dirty</option>
            <option value="no-git">Not a git repository</option>
        </select>
    </label>
    <button type="button" class="icon-button" title="Clear filters" @onclick="ClearFilters">
        <Icon Name="clear-filters" />
    </button>
    <button type="button" class="icon-button" title="Clone repository" @onclick="@(() => _cloneDialog!.ShowAsync())">
        <Icon Name="download" />
    </button>
</div>

@if (_summaries is null)
{
    <p>Loading...</p>
}
else
{
    var filtered = FilteredSummaries();
    if (filtered.Count == 0)
    {
        <p class="empty-state">No repositories match the current filters.</p>
    }
    else
    {
        <table class="data-table clickable-rows">
            <colgroup>
                <col style="width:1%" />
                <col />
                <col style="width:1%" />
                <col style="width:1%" />
                <col style="width:1%" />
            </colgroup>
            <thead>
                <tr>
                    <th class="col-shrink" @onclick="@(() => SortBy(SortColumn.Status))">Status@(SortIndicator(SortColumn.Status))</th>
                    <th @onclick="@(() => SortBy(SortColumn.Name))">Name@(SortIndicator(SortColumn.Name))</th>
                    <th class="col-shrink" @onclick="@(() => SortBy(SortColumn.Size))">Size@(SortIndicator(SortColumn.Size))</th>
                    <th class="col-shrink" @onclick="@(() => SortBy(SortColumn.GitStatus))">Git status@(SortIndicator(SortColumn.GitStatus))</th>
                    <th class="col-shrink not-sortable">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var repository in Sorted(filtered))
                {
                    <tr @onclick="@(() => NavigationManager.NavigateTo($"repository-management/{repository.Name}"))">
                        <td class="col-shrink"><span class="kind-badge">@(repository.IsActive ? "Active" : "Idle")</span></td>
                        <td class="ellipsis" title="@repository.Name">@repository.Name</td>
                        <td class="col-shrink">@(repository.StatsComputed ? FormatSize(repository.TotalSizeBytes) : "Computing…")</td>
                        <td class="col-shrink ellipsis" title="@GitStatusText(repository)">@GitStatusText(repository)</td>
                        <td class="col-shrink actions" @onclick:stopPropagation="true">
                            @if (_inFlightClonesByRepositoryName.TryGetValue(repository.Name, out var cloneRunId))
                            {
                                <button type="button" class="icon-button" title="Cancel clone" @onclick="@(() => CancelCloneAsync(cloneRunId))">
                                    <Icon Name="close" />
                                </button>
                            }
                            else
                            {
                                <button type="button" class="icon-button @FlashClass(repository.Name, "pull")" title="Pull" @onclick="@(() => RunGitActionAsync(repository.Name, "pull", RepositoryManager.PullAsync))">
                                    <Icon Name="pull" />
                                </button>
                                <button type="button" class="icon-button @FlashClass(repository.Name, "push")" title="Push" @onclick="@(() => RunGitActionAsync(repository.Name, "push", RepositoryManager.PushAsync))">
                                    <Icon Name="push" />
                                </button>
                                <button type="button" class="icon-button @FlashClass(repository.Name, "force-push")" title="Force push" @onclick="@(() => ConfirmAndRunAsync(repository.Name, "force-push", "Force push", $"Force-push '{repository.Name}'? This can overwrite the remote's history.", RepositoryManager.ForcePushAsync))">
                                    <Icon Name="force-push" />
                                </button>
                                <button type="button" class="icon-button @FlashClass(repository.Name, "fetch")" title="Fetch" @onclick="@(() => RunGitActionAsync(repository.Name, "fetch", RepositoryManager.FetchAsync))">
                                    <Icon Name="fetch" />
                                </button>
                                <button type="button" class="icon-button @FlashClass(repository.Name, "clean")" title="Clean (git clean -xdf)" @onclick="@(() => ConfirmAndRunAsync(repository.Name, "clean", "Clean", $"Run 'git clean -xdf' on '{repository.Name}'? This permanently deletes every untracked file.", RepositoryManager.CleanAsync))">
                                    <Icon Name="clean" />
                                </button>
                                <button type="button" class="icon-button" title="Rename" @onclick="@(() => _renameDialog!.ShowAsync(repository.Name))">
                                    <Icon Name="pencil" />
                                </button>
                                <button type="button" class="icon-button icon-button-danger" title="Delete" @onclick="@(() => ConfirmDeleteAsync(repository.Name))">
                                    <Icon Name="trash" />
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

<ConfirmDialog @ref="_confirmDialog" />
<CloneDialog @ref="_cloneDialog" OnCloned="RefreshAsync" />
<RenameDialog @ref="_renameDialog" OnRenamed="RefreshAsync" />

@code {
    private IReadOnlyList<RepositorySummary>? _summaries;
    private Dictionary<string, Guid> _inFlightClonesByRepositoryName = [];
    private IDisposable? _subscription;
    private IDisposable? _statsSubscription;
    private string _searchText = string.Empty;
    private bool _activeOnly;
    private string _gitStatusFilter = string.Empty;
    private SortColumn _sortColumn = SortColumn.Name;
    private bool _sortAscending = true;
    private ConfirmDialog? _confirmDialog;
    private CloneDialog? _cloneDialog;
    private RenameDialog? _renameDialog;

    /// <summary>Per "repositoryName:action" (e.g. "my-repo:pull"), the CSS class briefly applied to that row's icon to report the outcome - no streamed output, per specs/repository-management's "Outcome is shown without a console view" requirement.</summary>
    private readonly Dictionary<string, string> _flashClasses = [];

    private enum SortColumn
    {
        Status,
        Name,
        Size,
        GitStatus,
    }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        _subscription = RunEventBus.Subscribe(OnRunEvent);

        // A repository's stats cache can update independently of any run reaching a terminal state
        // (the stats sampler's slow-cadence sweep, or the delayed half of a clone's own event-driven
        // recompute) - without this, a page left open would sit showing "Computing…" or a stale size
        // until some unrelated run's event happened to trigger another refresh. See
        // IRepositoryStatsEventBus's own remarks.
        _statsSubscription = RepositoryStatsEventBus.Subscribe(OnRepositoryStatsChanged);
    }

    private void OnRunEvent(RunEvent runEvent)
    {
        if (runEvent.Type == RunEventType.OutputLine)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await RefreshAsync();
            StateHasChanged();
        });
    }

    private void OnRepositoryStatsChanged(string repositoryName)
    {
        _ = InvokeAsync(async () =>
        {
            await RefreshAsync();
            StateHasChanged();
        });
    }

    private async Task RefreshAsync()
    {
        _summaries = await RepositoryManager.ListAsync(CancellationToken.None);

        var inFlightClones = await RunRepository.ListAsync(
            new RunQuery { Kinds = [RunKind.RepositoryClone], Outcomes = [RunOutcome.Running] },
            CancellationToken.None);
        _inFlightClonesByRepositoryName = inFlightClones.ToDictionary(r => Path.GetFileName(r.RepositoryPath), r => r.Id);
    }

    private IReadOnlyList<RepositorySummary> FilteredSummaries()
    {
        IEnumerable<RepositorySummary> query = _summaries!;

        if (_activeOnly)
        {
            query = query.Where(r => r.IsActive);
        }

        query = _gitStatusFilter switch
        {
            "clean" => query.Where(r => r.IsGitRepository && !r.IsDirty),
            "dirty" => query.Where(r => r.IsGitRepository && r.IsDirty),
            "no-git" => query.Where(r => !r.IsGitRepository),
            _ => query,
        };

        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            query = query.Where(r => r.Name.Contains(_searchText, StringComparison.OrdinalIgnoreCase));
        }

        return [.. query];
    }

    private void ClearFilters()
    {
        _searchText = string.Empty;
        _activeOnly = false;
        _gitStatusFilter = string.Empty;
    }

    private void SortBy(SortColumn column)
    {
        if (_sortColumn == column)
        {
            _sortAscending = !_sortAscending;
        }
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
    }

    private string SortIndicator(SortColumn column) => _sortColumn == column ? (_sortAscending ? " ▲" : " ▼") : string.Empty;

    private IEnumerable<RepositorySummary> Sorted(IReadOnlyList<RepositorySummary> repositories)
    {
        IEnumerable<RepositorySummary> ordered = _sortColumn switch
        {
            SortColumn.Status => repositories.OrderBy(r => r.IsActive),
            SortColumn.Size => repositories.OrderBy(r => r.TotalSizeBytes),
            SortColumn.GitStatus => repositories.OrderBy(GitStatusText, StringComparer.OrdinalIgnoreCase),
            _ => repositories.OrderBy(r => r.Name, StringComparer.OrdinalIgnoreCase),
        };

        return _sortAscending ? ordered : ordered.Reverse();
    }

    private void CancelCloneAsync(Guid runId) => RunRegistry.TryCancel(runId);

    private Task ConfirmDeleteAsync(string name) =>
        _confirmDialog!.ShowAsync(
            "Delete repository",
            $"Permanently delete '{name}'? This cannot be undone.",
            () => DeleteAsync(name),
            confirmLabel: "Delete");

    private async Task DeleteAsync(string name)
    {
        await RepositoryManager.DeleteAsync(name, CancellationToken.None);
        await RefreshAsync();
    }

    private Task ConfirmAndRunAsync(string name, string action, string title, string message, Func<string, CancellationToken, Task<RepositoryGitActionResult>> operation) =>
        _confirmDialog!.ShowAsync(title, message, () => RunGitActionAsync(name, action, operation));

    /// <summary>Runs a pull/push/force-push/fetch/clean action to completion, then flashes that row's icon green/success or red/failure - no streamed output/console, per specs/repository-management's "Dashboard-only pull/push/force-push/fetch/clean actions" requirement.</summary>
    private async Task RunGitActionAsync(string name, string action, Func<string, CancellationToken, Task<RepositoryGitActionResult>> operation)
    {
        var result = await operation(name, CancellationToken.None);
        var key = $"{name}:{action}";
        _flashClasses[key] = result is RepositoryGitActionResult.Succeeded ? "flash-success" : "flash-fail";
        StateHasChanged();

        await RefreshAsync();

        _ = ClearFlashAfterDelayAsync(key);
    }

    private async Task ClearFlashAfterDelayAsync(string key)
    {
        await Task.Delay(TimeSpan.FromSeconds(2.5));
        _flashClasses.Remove(key);
        await InvokeAsync(StateHasChanged);
    }

    private string FlashClass(string name, string action) => _flashClasses.GetValueOrDefault($"{name}:{action}", string.Empty);

    // Invariant-culture-formatted - see Status.razor's FormatBytes for why this matters.
    private static string FormatSize(long bytes) => bytes switch
    {
        >= 1024L * 1024 * 1024 => $"{(bytes / (1024.0 * 1024 * 1024)).ToString("F1", CultureInfo.InvariantCulture)} GB",
        >= 1024L * 1024 => $"{(bytes / (1024.0 * 1024)).ToString("F1", CultureInfo.InvariantCulture)} MB",
        >= 1024L => $"{(bytes / 1024.0).ToString("F1", CultureInfo.InvariantCulture)} KB",
        _ => $"{bytes} B",
    };

    private static string GitStatusText(RepositorySummary repository)
    {
        if (!repository.StatsComputed)
        {
            return "Computing…";
        }

        if (!repository.IsGitRepository)
        {
            return "Not a git repository";
        }

        var branchText = repository.IsDetachedHead ? $"detached at {repository.Branch}" : repository.Branch ?? "(no branch)";
        var status = $"{branchText} ({(repository.IsDirty ? "dirty" : "clean")})";

        if (repository.IsRemoteGone)
        {
            status += ", remote gone";
        }
        else
        {
            if (repository.AheadCount is > 0)
            {
                status += $", ahead {repository.AheadCount}";
            }

            if (repository.BehindCount is > 0)
            {
                status += $", behind {repository.BehindCount}";
            }
        }

        return status;
    }

    /// <inheritdoc />
    public void Dispose()
    {
        _subscription?.Dispose();
        _statsSubscription?.Dispose();
    }
}

@page "/repository-management"
@attribute [Authorize]
@using OutOfTheBox.Application.Concurrency
@using OutOfTheBox.Application.Repositories
@using OutOfTheBox.Domain.Repositories
@inject IRepositoryManager RepositoryManager
@inject IRunRepository RunRepository
@inject RunRegistry RunRegistry
@inject IRunEventBus RunEventBus
@inject IRepositoryStatsEventBus RepositoryStatsEventBus
@inject NavigationManager NavigationManager
@implements IDisposable

<PageTitle>@VersionInfo.DisplayName - Repositories</PageTitle>

<h1>Repositories</h1>

<div class="history-filters">
    <label>
        Search
        <input type="text" @bind="_searchText" @bind:event="oninput" placeholder="Repository name" />
    </label>
    <label>
        <input type="checkbox" @bind="_activeOnly" /> Active only
    </label>
    <label>
        Git status
        <select @bind="_gitStatusFilter">
            <option value="">(any)</option>
            <option value="clean">Clean</option>
            <option value="dirty">Dirty</option>
            <option value="no-git">Not a git repository</option>
        </select>
    </label>
    <button type="button" class="icon-button" title="Clear filters" @onclick="ClearFilters">
        <Icon Name="clear-filters" />
    </button>
    <button type="button" class="icon-button" title="Clone repository" @onclick="@(() => _cloneDialog!.ShowAsync())">
        <Icon Name="download" />
    </button>
</div>

@if (_summaries is null)
{
    <p>Loading...</p>
}
else
{
    var filtered = FilteredSummaries();
    if (filtered.Count == 0)
    {
        <p class="empty-state">No repositories match the current filters.</p>
    }
    else
    {
        <table class="data-table clickable-rows">
            <colgroup>
                <col style="width:1%" />
                <col />
                <col style="width:1%" />
                <col style="width:1%" />
                <col style="width:1%" />
            </colgroup>
            <thead>
                <tr>
                    <th class="col-shrink" @onclick="@(() => SortBy(SortColumn.Status))">Status@(SortIndicator(SortColumn.Status))</th>
                    <th @onclick="@(() => SortBy(SortColumn.Name))">Name@(SortIndicator(SortColumn.Name))</th>
                    <th class="col-shrink" @onclick="@(() => SortBy(SortColumn.Size))">Size@(SortIndicator(SortColumn.Size))</th>
                    <th class="col-shrink" @onclick="@(() => SortBy(SortColumn.GitStatus))">Git status@(SortIndicator(SortColumn.GitStatus))</th>
                    <th class="col-shrink not-sortable">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var repository in Sorted(filtered))
                {
                    <tr @key="repository.Name" class="@(_exitingNames.Contains(repository.Name) ? ListAnimation.ExitingClass : null)" @onclick="@(() => NavigationManager.NavigateTo($"repository-management/{repository.Name}"))">
                        <td class="col-shrink"><span class="kind-badge">@(repository.IsActive ? "Active" : "Idle")</span></td>
                        <td class="ellipsis" title="@repository.Name">
                            @repository.Name
                            @if (repository.NeedsCredential)
                            {
                                <span title="This repository's remote host needs a working git credential.">
                                    <Icon Name="credential" CssClass="icon-inline needs-credential-marker" />
                                </span>
                            }
                        </td>
                        <td class="col-shrink">@(repository.StatsComputed ? RepositoryDisplay.FormatSize(repository.TotalSizeBytes) : "Computing…")</td>
                        <td class="col-shrink"><GitStatusIndicator Repository="repository" /></td>
                        <td class="col-shrink actions" @onclick:stopPropagation="true">
                            @if (_inFlightClonesByRepositoryName.TryGetValue(repository.Name, out var cloneRunId))
                            {
                                <button type="button" class="icon-button" title="Cancel clone" @onclick="@(() => CancelCloneAsync(cloneRunId))">
                                    <Icon Name="close" />
                                </button>
                            }
                            else
                            {
                                <RepositoryQuickActions RepositoryName="@repository.Name" OnActionCompleted="RefreshAsync" />
                                <button type="button" class="icon-button" title="Rename" @onclick="@(() => _renameDialog!.ShowAsync(repository.Name))">
                                    <Icon Name="pencil" />
                                </button>
                                <button type="button" class="icon-button icon-button-danger" title="Delete" @onclick="@(() => ConfirmDeleteAsync(repository.Name))">
                                    <Icon Name="trash" />
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

<ConfirmDialog @ref="_confirmDialog" />
<CloneDialog @ref="_cloneDialog" OnCloned="HandleClonedAsync" />
<RenameDialog @ref="_renameDialog" OnRenamed="RefreshAsync" />
<PatPromptDialog @ref="_patPromptDialog" />

@code {
    private IReadOnlyList<RepositorySummary>? _summaries;
    private Dictionary<string, Guid> _inFlightClonesByRepositoryName = [];
    private IDisposable? _subscription;
    private IDisposable? _statsSubscription;
    private string _searchText = string.Empty;
    private bool _activeOnly;
    private string _gitStatusFilter = string.Empty;
    private SortColumn _sortColumn = SortColumn.Name;
    private bool _sortAscending = true;
    private ConfirmDialog? _confirmDialog;
    private CloneDialog? _cloneDialog;
    private RenameDialog? _renameDialog;
    private PatPromptDialog? _patPromptDialog;

    /// <summary>Repository names currently mid-delete, playing their exit animation - see <see cref="ListAnimation"/>.</summary>
    private readonly HashSet<string> _exitingNames = [];

    /// <summary>
    /// Clones this page itself started, keyed by run id, kept only until that run reaches a
    /// terminal state - watched in <see cref="OnRunEvent"/> so a classified authentication failure
    /// can prompt for a PAT and retry with the exact same parameters, per design.md's clone-retry
    /// decision. Deliberately not scoped to <see cref="CloneDialog"/> itself (see that component's
    /// own remarks) - keeping a modal dialog open for a clone's full, possibly-long duration would
    /// block the operator from using the rest of the dashboard for no reason a successful clone
    /// would ever need.
    /// </summary>
    private readonly Dictionary<Guid, ClonedInfo> _pendingClones = [];

    private enum SortColumn
    {
        Status,
        Name,
        Size,
        GitStatus,
    }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        _subscription = RunEventBus.Subscribe(OnRunEvent);

        // A repository's stats cache can update independently of any run reaching a terminal state
        // (the stats sampler's slow-cadence sweep, or the delayed half of a clone's own event-driven
        // recompute) - without this, a page left open would sit showing "Computing…" or a stale size
        // until some unrelated run's event happened to trigger another refresh. See
        // IRepositoryStatsEventBus's own remarks.
        _statsSubscription = RepositoryStatsEventBus.Subscribe(OnRepositoryStatsChanged);
    }

    private void OnRunEvent(RunEvent runEvent)
    {
        if (runEvent.Type == RunEventType.OutputLine)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            if (runEvent.Type == RunEventType.Terminal && _pendingClones.ContainsKey(runEvent.RunId))
            {
                await HandleCloneTerminalAsync(runEvent.RunId);
            }

            await RefreshAsync();
            StateHasChanged();
        });
    }

    private async Task HandleClonedAsync(ClonedInfo info)
    {
        _pendingClones[info.RunId] = info;
        await RefreshAsync();
    }

    /// <summary>
    /// Reacts to one of this page's own pending clones reaching a terminal state - success or a
    /// non-authentication failure just clears it (the list/status already reflects the outcome via
    /// the normal refresh); a classified authentication failure prompts for a PAT and, once one
    /// verifies, retries the identical clone (looping through this same method again on its own
    /// eventual terminal event) - cancelling the prompt clears it with no further retry, per
    /// specs/repository-management's "Cancelling the PAT prompt means no clone happens" scenario.
    /// </summary>
    private async Task HandleCloneTerminalAsync(Guid runId)
    {
        if (!_pendingClones.Remove(runId, out var info))
        {
            return;
        }

        var run = await RunRepository.FindByIdAsync(runId, CancellationToken.None);
        var succeeded = run is { Outcome: RunOutcome.Completed, ExitCode: 0 };
        if (succeeded)
        {
            return;
        }

        if (!GitAuthFailureClassifier.IsLikelyAuthFailure(run?.Stderr) || !GitRemoteUrlParser.TryGetHost(info.Url, out var host))
        {
            return;
        }

        await _patPromptDialog!.ShowAsync(
            host,
            onSaved: () => RetryCloneAsync(info),
            onCancelled: () => { });
    }

    private async Task RetryCloneAsync(ClonedInfo info)
    {
        var result = await RepositoryManager.CloneAsync(info.Url, info.Name, info.Branch, CancellationToken.None);
        if (result is RepositoryActionResult.Accepted accepted)
        {
            await HandleClonedAsync(info with { RunId = accepted.RunId });
        }
    }

    private void OnRepositoryStatsChanged(string repositoryName)
    {
        _ = InvokeAsync(async () =>
        {
            await RefreshAsync();
            StateHasChanged();
        });
    }

    private async Task RefreshAsync()
    {
        _summaries = await RepositoryManager.ListAsync(CancellationToken.None);

        var inFlightClones = await RunRepository.ListAsync(
            new RunQuery { Kinds = [RunKind.RepositoryClone], Outcomes = [RunOutcome.Running] },
            CancellationToken.None);
        _inFlightClonesByRepositoryName = inFlightClones.ToDictionary(r => Path.GetFileName(r.RepositoryPath), r => r.Id);
    }

    private IReadOnlyList<RepositorySummary> FilteredSummaries()
    {
        IEnumerable<RepositorySummary> query = _summaries!;

        if (_activeOnly)
        {
            query = query.Where(r => r.IsActive);
        }

        query = _gitStatusFilter switch
        {
            "clean" => query.Where(r => r.IsGitRepository && !r.IsDirty),
            "dirty" => query.Where(r => r.IsGitRepository && r.IsDirty),
            "no-git" => query.Where(r => !r.IsGitRepository),
            _ => query,
        };

        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            query = query.Where(r => r.Name.Contains(_searchText, StringComparison.OrdinalIgnoreCase));
        }

        return [.. query];
    }

    private void ClearFilters()
    {
        _searchText = string.Empty;
        _activeOnly = false;
        _gitStatusFilter = string.Empty;
    }

    private void SortBy(SortColumn column)
    {
        if (_sortColumn == column)
        {
            _sortAscending = !_sortAscending;
        }
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
    }

    private string SortIndicator(SortColumn column) => _sortColumn == column ? (_sortAscending ? " ▲" : " ▼") : string.Empty;

    private IEnumerable<RepositorySummary> Sorted(IReadOnlyList<RepositorySummary> repositories)
    {
        IEnumerable<RepositorySummary> ordered = _sortColumn switch
        {
            SortColumn.Status => repositories.OrderBy(r => r.IsActive),
            SortColumn.Size => repositories.OrderBy(r => r.TotalSizeBytes),
            SortColumn.GitStatus => repositories.OrderBy(RepositoryDisplay.GitStatusText, StringComparer.OrdinalIgnoreCase),
            _ => repositories.OrderBy(r => r.Name, StringComparer.OrdinalIgnoreCase),
        };

        return _sortAscending ? ordered : ordered.Reverse();
    }

    private void CancelCloneAsync(Guid runId) => RunRegistry.TryCancel(runId);

    private Task ConfirmDeleteAsync(string name) =>
        _confirmDialog!.ShowAsync(
            "Delete repository",
            $"Permanently delete '{name}'? This cannot be undone.",
            () => DeleteAsync(name),
            confirmLabel: "Delete");

    private async Task DeleteAsync(string name)
    {
        _exitingNames.Add(name);
        StateHasChanged();
        await Task.Delay(ListAnimation.ExitDuration);

        await RepositoryManager.DeleteAsync(name, CancellationToken.None);
        _exitingNames.Remove(name);
        await RefreshAsync();
    }

    /// <inheritdoc />
    public void Dispose()
    {
        _subscription?.Dispose();
        _statsSubscription?.Dispose();
    }
}

@using Microsoft.JSInterop
@using OutOfTheBox.Application.Repositories
@using OutOfTheBox.Presentation.Dashboard.CodePreview
@inject IRepositoryHistoryReader RepositoryHistoryReader
@inject IJSRuntime JS
@inject ICodePreviewInterop CodePreviewInterop
@implements IAsyncDisposable

<dialog @ref="_dialogElement" class="file-preview-dialog">
    <div class="dialog-body">
        <div class="dialog-title-row">
            <h2 class="ellipsis" title="@_path">@_path</h2>
            @if (_diff is not null)
            {
                <label class="word-wrap-toggle">
                    <input type="checkbox" checked="@_codePreview.WordWrap" @onchange="OnWordWrapChangedAsync" />
                    Wrap lines
                </label>
            }
            <button type="button" class="icon-button dialog-close-button" @onclick="CloseAsync" title="Close">
                <Icon Name="close" />
            </button>
        </div>
        @if (_loading)
        {
            <p>Loading...</p>
        }
        else if (_diff is null)
        {
            <p class="empty-state">No text diff available for this file (it may be binary, or the commit may not have touched it).</p>
        }
        else
        {
            <textarea id="@_codePreview.ElementId" class="file-preview-code" data-mime="@DiffMimeType" readonly>@_diff</textarea>
        }
    </div>
</dialog>

@code {
    // CodeMirror's "text/x-diff" mode is already vendored (see CodePreviewLanguage's own .diff/.patch
    // mapping) - reused directly here rather than trying to infer a per-language mode for the
    // changed file itself, since a unified diff's own syntax (+/-/@@ hunk headers) is what actually
    // needs highlighting, not the underlying file's language.
    private const string DiffMimeType = "text/x-diff";

    private ElementReference _dialogElement;
    private CodePreviewSession _codePreview = null!;
    private string _path = string.Empty;
    private string? _diff;
    private bool _loading;

    /// <inheritdoc />
    protected override void OnInitialized() => _codePreview = new CodePreviewSession(CodePreviewInterop);

    /// <summary>Opens the dialog and loads the unified diff for <paramref name="path"/> as changed by <paramref name="hash"/>.</summary>
    public async Task ShowAsync(string repositoryName, string hash, string path)
    {
        // Tears down any previous CodeMirror instance and refreshes the word-wrap preference before
        // any state below changes - see CodePreviewSession.PrepareForOpenAsync's own remarks.
        await _codePreview.PrepareForOpenAsync();

        _path = path;
        _diff = null;
        _loading = true;
        StateHasChanged();
        await JS.ShowModalAsync(_dialogElement);

        _diff = await RepositoryHistoryReader.GetCommitFileDiffAsync(repositoryName, hash, path, CancellationToken.None);
        if (_diff is not null)
        {
            _codePreview.MarkContentReady();
        }

        _loading = false;
        StateHasChanged();
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender) => await _codePreview.RenderIfPendingAsync(DiffMimeType);

    private async Task OnWordWrapChangedAsync(ChangeEventArgs e) => await _codePreview.ToggleWordWrapAsync(e.Value is true);

    private async Task CloseAsync() => await JS.CloseAsync(_dialogElement);

    /// <inheritdoc />
    public async ValueTask DisposeAsync() => await _codePreview.DisposeAsync();
}

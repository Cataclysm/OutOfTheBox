@inherits LayoutComponentBase

<div class="dashboard-shell">
    <header class="dashboard-header">
        <span class="dashboard-brand">
            <img src="_content/OutOfTheBox.Presentation/img/logo.png" alt="@VersionInfo.DisplayName" class="dashboard-brand-logo" />
            @VersionInfo.DisplayName
        </span>
        <nav class="dashboard-nav">
            <NavLink href="" Match="NavLinkMatch.All">Status</NavLink>
            <NavLink href="history">History</NavLink>
            <NavLink href="repository-management">Repositories</NavLink>
            <NavLink href="about">About</NavLink>
        </nav>
        <form method="post" action="account/logout" class="dashboard-logout">
            <button type="submit">Log out</button>
        </form>
    </header>

    <main class="dashboard-content">
        @Body
    </main>
</div>

@using System.Text
@using Markdig
@using Microsoft.JSInterop
@using OutOfTheBox.Application.Repositories
@using OutOfTheBox.Presentation.Dashboard.CodePreview
@inject IRepositoryFileBrowser FileBrowser
@inject IJSRuntime JS
@inject ICodePreviewInterop CodePreviewInterop
@implements IAsyncDisposable

<dialog @ref="_dialogElement" class="file-preview-dialog">
    <div class="dialog-body">
        <div class="dialog-title-row">
            <h2 class="ellipsis" title="@_name">@_name</h2>
            @if (_kind == PreviewKind.Text && _html is null && !_loading && _error is null)
            {
                <label class="word-wrap-toggle">
                    <input type="checkbox" checked="@_codePreview.WordWrap" @onchange="OnWordWrapChangedAsync" />
                    Wrap lines
                </label>
            }
            <button type="button" class="icon-button dialog-close-button" @onclick="CloseAsync" title="Close">
                <Icon Name="close" />
            </button>
        </div>
        @if (_loading)
        {
            <p>Loading...</p>
        }
        else if (_error is not null)
        {
            <p class="empty-state">@_error</p>
        }
        else if (_kind == PreviewKind.Image)
        {
            <img class="file-preview-image" src="@_mediaUrl" alt="@_name" />
        }
        else if (_kind == PreviewKind.Pdf)
        {
            <iframe class="file-preview-pdf" src="@_mediaUrl" title="@_name"></iframe>
        }
        else if (_kind == PreviewKind.Audio)
        {
            <audio class="file-preview-audio" controls src="@_mediaUrl">Your browser cannot play this audio file.</audio>
        }
        else if (_kind == PreviewKind.Video)
        {
            <video class="file-preview-video" controls src="@_mediaUrl">Your browser cannot play this video file.</video>
        }
        else if (_kind == PreviewKind.Text)
        {
            @if (_html is not null)
            {
                <div class="markdown-preview">@((MarkupString)_html)</div>
            }
            else
            {
                <textarea id="@_codePreview.ElementId" class="file-preview-code" data-mime="@_codeMime" readonly>@_text</textarea>
            }
            @if (_truncated)
            {
                <p class="empty-state">Preview truncated to the first @RepositoryDisplay.FormatSize(PreviewMaxBytes) - download the file for the rest.</p>
            }
        }
        else
        {
            <p class="empty-state">No preview available for this file.</p>
        }
    </div>
</dialog>

@code {
    private const long PreviewMaxBytes = 1024 * 1024;

    // How much of the file to read before deciding what it is - large enough to catch a magic
    // number/enough text to judge, small enough to stay cheap even for a huge file. The same
    // ballpark git itself samples to decide "is this binary" (a NUL byte anywhere in the sample).
    private const int SniffSampleBytes = 8000;

    private static readonly byte[] PngSignature = [0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A];
    private static readonly byte[] JpegSignature = [0xFF, 0xD8, 0xFF];
    private static readonly byte[] Gif87Signature = "GIF87a"u8.ToArray();
    private static readonly byte[] Gif89Signature = "GIF89a"u8.ToArray();
    private static readonly byte[] BmpSignature = "BM"u8.ToArray();
    private static readonly byte[] IcoSignature = [0x00, 0x00, 0x01, 0x00];
    private static readonly byte[] RiffSignature = "RIFF"u8.ToArray();
    private static readonly byte[] WebpSignature = "WEBP"u8.ToArray();
    private static readonly byte[] WaveSignature = "WAVE"u8.ToArray();
    private static readonly byte[] PdfSignature = "%PDF-"u8.ToArray();
    private static readonly byte[] Id3Signature = "ID3"u8.ToArray();
    private static readonly byte[] OggSignature = "OggS"u8.ToArray();
    private static readonly byte[] FlacSignature = "fLaC"u8.ToArray();
    private static readonly byte[] Mp4Signature = "ftyp"u8.ToArray();
    private static readonly byte[] WebmSignature = [0x1A, 0x45, 0xDF, 0xA3];

    // Rejects any byte that isn't valid UTF-8 instead of silently substituting U+FFFD (the BCL's
    // default Encoding.UTF8 behavior) - substitution would make binary data look like "text with a
    // few odd characters" instead of correctly failing the text sniff below.
    private static readonly UTF8Encoding StrictUtf8 = new(encoderShouldEmitUTF8Identifier: false, throwOnInvalidBytes: true);

    private static readonly MarkdownPipeline MarkdownPipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        // A cloned repository's own Markdown is not trusted content - without this, a malicious
        // README (raw <script>/event-handler HTML) previewed by an operator would execute in their
        // authenticated dashboard session. Formatting is still fully supported; only raw HTML
        // passthrough is disabled.
        .DisableHtml()
        .Build();

    private enum PreviewKind
    {
        Unsupported,
        Text,
        Image,
        Pdf,
        Audio,
        Video,
    }

    private ElementReference _dialogElement;
    private CodePreviewSession _codePreview = null!;
    private string _name = string.Empty;
    private string _mediaUrl = string.Empty;
    private string _text = string.Empty;
    private string? _html;
    private string? _codeMime;
    private bool _truncated;
    private bool _loading;
    private string? _error;
    private PreviewKind _kind;

    /// <inheritdoc />
    protected override void OnInitialized() => _codePreview = new CodePreviewSession(CodePreviewInterop);

    /// <summary>
    /// Opens the dialog and loads a preview for the given file. What kind of preview - code, image,
    /// PDF, audio, video, or none - is decided from the file's actual content (magic bytes for
    /// images/PDF/audio/video, a binary/text sniff for everything else), not its extension, so a
    /// mislabeled or extensionless file still previews correctly. The one exception is Markdown
    /// rendering: there is no reliable way to detect "this text is meant as Markdown" from content
    /// alone, so a `.md`/`.markdown` name is what decides whether text renders as formatted HTML
    /// instead of a syntax-highlighted code view.
    /// </summary>
    public async Task ShowAsync(string repositoryName, string relativePath, string name, string downloadUrl)
    {
        // Tears down any CodeMirror instance left over from a previously previewed file, and
        // refreshes the word-wrap preference, before touching any state below - see
        // CodePreviewSession.PrepareForOpenAsync's own remarks for why the ordering matters
        // (CodeMirror.fromTextArea inserts its own wrapper element as a sibling of the <textarea> it
        // enhances, a DOM node Blazor's own diffing doesn't know about).
        await _codePreview.PrepareForOpenAsync();

        _name = name;
        _error = null;
        _text = string.Empty;
        _html = null;
        _codeMime = null;
        _truncated = false;
        _kind = PreviewKind.Unsupported;
        _loading = true;
        StateHasChanged();
        await JS.ShowModalAsync(_dialogElement);

        var resolvedPath = await FileBrowser.ResolveConfinedFilePathAsync(repositoryName, relativePath, CancellationToken.None);
        if (resolvedPath is null)
        {
            _error = "File not found.";
            _loading = false;
            StateHasChanged();
            return;
        }

        try
        {
            _kind = await ClassifyAsync(resolvedPath);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            _error = "Failed to read file - it may be locked by another process.";
            _loading = false;
            StateHasChanged();
            return;
        }

        if (_kind is PreviewKind.Image or PreviewKind.Pdf or PreviewKind.Audio or PreviewKind.Video)
        {
            _mediaUrl = downloadUrl;
            _loading = false;
            StateHasChanged();
            return;
        }

        if (_kind != PreviewKind.Text)
        {
            _loading = false;
            StateHasChanged();
            return;
        }

        try
        {
            var fileInfo = new FileInfo(resolvedPath);
            if (fileInfo.Length <= PreviewMaxBytes)
            {
                _text = await File.ReadAllTextAsync(resolvedPath);
            }
            else
            {
                await using var stream = File.OpenRead(resolvedPath);
                var buffer = new byte[PreviewMaxBytes];
                var read = await stream.ReadAsync(buffer.AsMemory());
                _text = Encoding.UTF8.GetString(buffer, 0, read);
                _truncated = true;
            }

            if (name.EndsWith(".md", StringComparison.OrdinalIgnoreCase) || name.EndsWith(".markdown", StringComparison.OrdinalIgnoreCase))
            {
                _html = Markdown.ToHtml(_text, MarkdownPipeline);
            }
            else
            {
                _codeMime = CodePreviewLanguage.GetMimeType(name);
                _codePreview.MarkContentReady();
            }
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            _error = "Failed to read file - it may be locked by another process.";
        }

        _loading = false;
        StateHasChanged();
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender) => await _codePreview.RenderIfPendingAsync(_codeMime);

    private async Task OnWordWrapChangedAsync(ChangeEventArgs e) => await _codePreview.ToggleWordWrapAsync(e.Value is true);

    private static async Task<PreviewKind> ClassifyAsync(string filePath)
    {
        byte[] sample;
        int read;
        await using (var stream = File.OpenRead(filePath))
        {
            sample = new byte[SniffSampleBytes];
            read = await stream.ReadAsync(sample.AsMemory());
        }

        var sampleSpan = sample.AsSpan(0, read);

        if (LooksLikeRasterImage(sampleSpan))
        {
            return PreviewKind.Image;
        }

        if (StartsWith(sampleSpan, PdfSignature))
        {
            return PreviewKind.Pdf;
        }

        if (LooksLikeVideo(sampleSpan))
        {
            return PreviewKind.Video;
        }

        if (LooksLikeAudio(sampleSpan))
        {
            return PreviewKind.Audio;
        }

        if (!LooksLikeText(sampleSpan, out var decodedSample))
        {
            return PreviewKind.Unsupported;
        }

        return LooksLikeSvg(decodedSample!) ? PreviewKind.Image : PreviewKind.Text;
    }

    private static bool LooksLikeRasterImage(ReadOnlySpan<byte> sample) =>
        StartsWith(sample, PngSignature)
        || StartsWith(sample, JpegSignature)
        || StartsWith(sample, Gif87Signature)
        || StartsWith(sample, Gif89Signature)
        || StartsWith(sample, BmpSignature)
        || StartsWith(sample, IcoSignature)
        || (sample.Length >= 12 && StartsWith(sample, RiffSignature) && sample.Slice(8, 4).SequenceEqual(WebpSignature));

    // MP4/M4A (ISO base media "ftyp" box at offset 4) and WebM/MKV (EBML header) - both are
    // container formats a full parse would identify more precisely, but these prefixes are reliable
    // enough in practice for a preview decision, the same magic-byte-only spirit as the image checks.
    private static bool LooksLikeVideo(ReadOnlySpan<byte> sample) =>
        StartsWith(sample, WebmSignature)
        || (sample.Length >= 8 && sample.Slice(4, 4).SequenceEqual(Mp4Signature));

    // OggS covers both Ogg audio and Ogg video (.ogv) - treated as audio here since an audio test
    // fixture is by far the more common case in a repository, and <audio>/<video> both just play
    // whatever the browser's own demuxer decides the container actually holds.
    private static bool LooksLikeAudio(ReadOnlySpan<byte> sample) =>
        StartsWith(sample, Id3Signature)
        || StartsWith(sample, OggSignature)
        || StartsWith(sample, FlacSignature)
        || (sample.Length >= 12 && StartsWith(sample, RiffSignature) && sample.Slice(8, 4).SequenceEqual(WaveSignature));

    private static bool StartsWith(ReadOnlySpan<byte> sample, ReadOnlySpan<byte> signature) =>
        sample.Length >= signature.Length && sample[..signature.Length].SequenceEqual(signature);

    // The same heuristic git itself uses to decide "is this binary": a NUL byte anywhere in the
    // sample is treated as decisive, since no common text encoding legitimately produces one. Beyond
    // that, the sample must be valid UTF-8 outright (not merely "mostly printable") - anything else
    // is presumed binary rather than guessed at.
    private static bool LooksLikeText(ReadOnlySpan<byte> sample, out string? decoded)
    {
        if (sample.IsEmpty)
        {
            decoded = string.Empty;
            return true;
        }

        if (sample.IndexOf((byte)0) >= 0)
        {
            decoded = null;
            return false;
        }

        try
        {
            decoded = StrictUtf8.GetString(sample);
            return true;
        }
        catch (DecoderFallbackException)
        {
            decoded = null;
            return false;
        }
    }

    // SVG is XML text, not a binary format with a magic number - detected as "text that opens with
    // an <svg> root element" (an optional XML prolog first is fine) rather than by extension.
    private static bool LooksLikeSvg(string sampleText)
    {
        var trimmed = sampleText.TrimStart();
        if (trimmed.StartsWith("<?xml", StringComparison.OrdinalIgnoreCase))
        {
            var svgIndex = trimmed.IndexOf("<svg", StringComparison.OrdinalIgnoreCase);
            return svgIndex is >= 0 and < 500;
        }

        return trimmed.StartsWith("<svg", StringComparison.OrdinalIgnoreCase);
    }

    private async Task CloseAsync() => await JS.CloseAsync(_dialogElement);

    /// <inheritdoc />
    public async ValueTask DisposeAsync() => await _codePreview.DisposeAsync();
}

@page "/repository-management/{Name}/commits/{Hash}"
@attribute [Authorize]
@using System.Globalization
@using OutOfTheBox.Application.Repositories
@using OutOfTheBox.Domain.Repositories
@inject IRepositoryManager RepositoryManager
@inject IRepositoryStatsEventBus RepositoryStatsEventBus
@implements IDisposable

<PageTitle>@VersionInfo.DisplayName - Commit @Hash</PageTitle>

<a class="back-link" href="@($"repository-management/{Name}")">← Back to @Name</a>

@if (_loading)
{
    <p>Loading...</p>
}
else if (_detail is null)
{
    <p class="empty-state">Commit not found.</p>
}
else
{
    <h1>@_detail.ShortHash</h1>

    <dl>
        @if (_summary is not null)
        {
            <dt>Repository status</dt>
            <dd><GitStatusIndicator Repository="_summary" /></dd>
        }
        <dt>Hash</dt>
        <dd>@_detail.Hash</dd>
        <dt>Parents</dt>
        <dd>
            @if (_detail.ParentHashes.Count == 0)
            {
                @:None (root commit)
            }
            else
            {
                @for (var i = 0; i < _detail.ParentHashes.Count; i++)
                {
                    var parentHash = _detail.ParentHashes[i];
                    <a href="@($"repository-management/{Name}/commits/{parentHash}")">@parentHash[..Math.Min(7, parentHash.Length)]</a>
                    @(i < _detail.ParentHashes.Count - 1 ? ", " : "")
                }
            }
        </dd>
        @if (_detail.Refs.Count > 0)
        {
            <dt>Refs</dt>
            <dd>
                @foreach (var reference in _detail.Refs)
                {
                    <span class="ref-pill @RefPillClass(reference.Kind) @(reference.IsCurrent ? "ref-pill-current" : null)">
                        <Icon Name="@(reference.Kind == CommitRefKind.Tag ? "tag" : "branch")" />@reference.Name
                    </span>
                }
            </dd>
        }
        <dt>Author</dt>
        <dd>@_detail.AuthorName &lt;@_detail.AuthorEmail&gt; on @FormatDate(_detail.AuthorDate)</dd>
        <dt>Committer</dt>
        <dd>@_detail.CommitterName &lt;@_detail.CommitterEmail&gt; on @FormatDate(_detail.CommitterDate)</dd>
    </dl>

    <h2>Message</h2>
    <p><strong>@_detail.Subject</strong></p>
    @if (!string.IsNullOrWhiteSpace(_detail.Body))
    {
        <pre class="run-output">@_detail.Body</pre>
    }

    <h2>Files changed (@_detail.Files.Count)</h2>
    @if (_detail.Files.Count == 0)
    {
        <p class="empty-state">No file changes recorded (a merge commit's own changes aren't shown by default).</p>
    }
    else
    {
        <table class="data-table clickable-rows">
            <colgroup>
                <col style="width:1%" />
                <col />
                <col style="width:1%" />
            </colgroup>
            <tbody>
                @foreach (var file in _detail.Files)
                {
                    <tr @onclick="@(() => _diffDialog!.ShowAsync(Name, Hash, file.Path))">
                        <td class="col-shrink"><span class="kind-badge kind-file@(file.Kind.ToString().ToLowerInvariant())">@FileChangeLabel(file.Kind)</span></td>
                        <td class="ellipsis" title="@file.Path">
                            @if (file.OldPath is not null)
                            {
                                @: @file.OldPath →
                            }
                            @file.Path
                        </td>
                        <td class="col-shrink diff-stat">
                            @if (file.LinesAdded is not null && file.LinesRemoved is not null)
                            {
                                <span class="diff-stat-added">+@file.LinesAdded</span>
                                <span class="diff-stat-removed">-@file.LinesRemoved</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

<CommitFileDiffDialog @ref="_diffDialog" />

@code {
    /// <summary>The repository name from the route.</summary>
    [Parameter]
    public string Name { get; set; } = string.Empty;

    /// <summary>The commit hash from the route.</summary>
    [Parameter]
    public string Hash { get; set; } = string.Empty;

    private CommitDetail? _detail;
    private RepositorySummary? _summary;
    private bool _loading = true;
    private string? _loadedKey;
    private CommitFileDiffDialog? _diffDialog;
    private IDisposable? _statsSubscription;

    // OnParametersSetAsync, not OnInitializedAsync: clicking a parent-commit link navigates from
    // this route to itself with a different Hash, which Blazor resolves by reusing the existing
    // component instance rather than creating a new one - OnInitializedAsync only runs once per
    // instance, so it would never see the new Hash. OnParametersSetAsync runs on every navigation.
    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        var key = $"{Name}/{Hash}";
        if (key == _loadedKey)
        {
            return;
        }

        var isFirstLoad = _loadedKey is null;
        _loadedKey = key;
        _loading = true;
        _detail = null;
        _detail = await RepositoryManager.GetCommitDetailAsync(Name, Hash, CancellationToken.None);
        _loading = false;

        await RefreshSummaryAsync();

        // Subscribed once, on the very first load, rather than per-navigation - unsubscribing and
        // re-subscribing on every parent-hash click would work too, but there's no reason to churn
        // it when the repository name (what OnRepositoryStatsChanged actually filters on) usually
        // doesn't change between clicks.
        if (isFirstLoad)
        {
            _statsSubscription = RepositoryStatsEventBus.Subscribe(OnRepositoryStatsChanged);
        }
    }

    private async Task RefreshSummaryAsync()
    {
        var summaries = await RepositoryManager.ListAsync(CancellationToken.None);
        _summary = summaries.FirstOrDefault(r => string.Equals(r.Name, Name, StringComparison.OrdinalIgnoreCase));
    }

    private void OnRepositoryStatsChanged(string repositoryName)
    {
        if (!string.Equals(repositoryName, Name, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await RefreshSummaryAsync();
            StateHasChanged();
        });
    }

    /// <inheritdoc />
    public void Dispose() => _statsSubscription?.Dispose();

    private static string FileChangeLabel(CommitFileChangeKind kind) => kind switch
    {
        CommitFileChangeKind.Added => "Added",
        CommitFileChangeKind.Modified => "Modified",
        CommitFileChangeKind.Deleted => "Deleted",
        CommitFileChangeKind.Renamed => "Renamed",
        CommitFileChangeKind.Copied => "Copied",
        _ => "Changed",
    };

    private static string RefPillClass(CommitRefKind kind) => kind switch
    {
        CommitRefKind.RemoteBranch => "ref-pill-remote",
        CommitRefKind.Tag => "ref-pill-tag",
        _ => "ref-pill-local",
    };

    // Local time, no offset suffix - see RunDetail.razor's own FormatDateTime for why.
    private static string FormatDate(DateTimeOffset value) =>
        value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture);
}

@using System.Globalization
@using OutOfTheBox.Application.Repositories
@using OutOfTheBox.Domain.Repositories
@inject IRepositoryManager RepositoryManager
@inject IRepositoryStatsEventBus RepositoryStatsEventBus
@inject NavigationManager NavigationManager
@implements IDisposable

@if (_commits is null)
{
    <p>Loading...</p>
}
else if (_commits.Count == 0)
{
    <p class="empty-state">No commit history.</p>
}
else
{
    @if (_error is not null)
    {
        <span class="login-error">@_error</span>
    }

    <div class="commit-graph-wrapper">
        <table class="data-table commit-table clickable-rows">
            <colgroup>
                <col style="width:@(_graph!.LaneCount * LaneWidth)px" />
                <col />
                <col style="width:1%" />
                <col style="width:1%" />
                <col style="width:1%" />
                <col style="width:1%" />
            </colgroup>
            <tbody>
                @for (var i = 0; i < _commits.Count; i++)
                {
                    var commit = _commits[i];
                    <tr class="@(IsCheckedOut(commit) ? "commit-row-current" : null)" @onclick="@(() => NavigationManager.NavigateTo($"repository-management/{RepositoryName}/commits/{commit.Hash}"))">
                        <td class="commit-graph-cell"></td>
                        <td class="ellipsis commit-subject-cell" title="@commit.Subject">
                            @foreach (var reference in commit.Refs)
                            {
                                @if (reference.Kind == CommitRefKind.Tag || reference.IsCurrent)
                                {
                                    <span class="ref-pill @RefPillClass(reference.Kind) @(reference.IsCurrent ? "ref-pill-current" : null)">
                                        <Icon Name="@(reference.Kind == CommitRefKind.Tag ? "tag" : "branch")" />@reference.Name
                                    </span>
                                }
                                else
                                {
                                    <button type="button" class="ref-pill @RefPillClass(reference.Kind)" title="Switch to this branch"
                                            @onclick="@(() => ConfirmSwitchBranchAsync(reference))" @onclick:stopPropagation="true">
                                        <Icon Name="branch" />@reference.Name
                                    </button>
                                }
                            }
                            @commit.Subject
                        </td>
                        <td class="col-shrink ellipsis">@commit.AuthorName</td>
                        <td class="col-shrink">@FormatDate(commit.AuthorDate)</td>
                        <td class="col-shrink ellipsis" title="@commit.Hash">@commit.ShortHash</td>
                        <td class="col-shrink actions">
                            <button type="button" class="icon-button" title="Checkout as detached HEAD"
                                    @onclick="@(() => ConfirmCheckoutAsync(commit))" @onclick:stopPropagation="true">
                                <Icon Name="checkout" />
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @* One SVG spanning every row, not one per <tr> - row boxes drawn independently could each
           be a few px taller than RowHeight depending on text metrics, and vertical-align: middle
           would then center each row's graph inside that extra space, leaving visible gaps between
           consecutive rows' lines. A single overlay using absolute row-index math (rowIndex *
           RowHeight) is immune to that - it only needs every <tr> to actually render at exactly
           RowHeight, which .commit-table tr's own CSS rule guarantees. *@
        <svg class="commit-graph-svg" width="@(_graph!.LaneCount * LaneWidth)" height="@(_commits.Count * RowHeight)">
            @for (var i = 0; i < _commits.Count; i++)
            {
                var row = _graph.Rows[i];
                var rowTop = i * RowHeight;
                var rowBottom = rowTop + RowHeight;
                var rowMid = rowTop + RowHeight / 2;

                @foreach (var connector in row.Connectors)
                {
                    @if (connector.FromLane == connector.ToLane)
                    {
                        @if (connector.FromLane == row.Lane)
                        {
                            @* This row's own commit: draw only the half(s) that actually connect to
                               something. Nothing above depends on a new lane's first appearance, so
                               its line starts at its own dot, not the row's top edge; a lane that
                               arrived here but has no parent (a root, or the far end of a fork this
                               row's dot resolves) ends at its own dot too, not the row's bottom edge -
                               otherwise both dangle a stray stub past the dot with nothing to connect
                               to. An ordinary mid-lineage commit still gets the full row height. *@
                            var hasParentBelow = _commits![i].ParentHashes.Count > 0;
                            var y1 = row.IsNewLane ? rowMid : rowTop;
                            var y2 = hasParentBelow ? rowBottom : rowMid;
                            <line x1="@LaneX(connector.FromLane)" y1="@y1" x2="@LaneX(connector.ToLane)" y2="@y2"
                                  stroke="@LaneColor(connector.FromLane)" stroke-width="2.5" stroke-linecap="round" />
                        }
                        else
                        {
                            @* An unrelated lane simply passing through this row, untouched by this
                               row's own commit - always the full row height. *@
                            <line x1="@LaneX(connector.FromLane)" y1="@rowTop" x2="@LaneX(connector.ToLane)" y2="@rowBottom"
                                  stroke="@LaneColor(connector.FromLane)" stroke-width="2.5" stroke-linecap="round" />
                        }
                    }
                    else if (connector.ToLane == row.Lane)
                    {
                        @* Convergence (fork point): the other lane arrives at this row's top edge
                           and curves in to meet this commit's own dot, not past it - colored as the
                           disappearing lane, since the primary lane already has its own straight line. *@
                        <path d="@CurvePath(LaneX(connector.FromLane), rowTop, LaneX(connector.ToLane), rowMid)"
                              fill="none" stroke="@LaneColor(connector.FromLane)" stroke-width="2.5" stroke-linecap="round" />
                    }
                    else
                    {
                        @* Divergence (a merge's extra parent): starts at this commit's own dot and
                           curves out to the new lane's column by this row's bottom edge - colored as
                           the lane it becomes, since it stays that color for every row below. *@
                        <path d="@CurvePath(LaneX(connector.FromLane), rowMid, LaneX(connector.ToLane), rowBottom)"
                              fill="none" stroke="@LaneColor(connector.ToLane)" stroke-width="2.5" stroke-linecap="round" />
                    }
                }

                var isMerge = IsMergePoint(row);
                var isFork = IsForkPoint(row);

                @if (isMerge)
                {
                    @* An extra outer ring around a merge commit's own dot - multiple parent lines
                       already fan out below it, but a ring makes the merge point itself
                       recognizable at a glance instead of only inferable from the line topology. *@
                    <circle cx="@LaneX(row.Lane)" cy="@rowMid" r="7" fill="none" style="stroke:@LaneColor(row.Lane)" stroke-width="2" />
                }
                @if (isFork)
                {
                    @* A branch point (this commit has 2+ children in different lanes, i.e. 2+ lanes
                       converge into it from above) - rendered hollow instead of solid, distinct
                       from both a plain commit and a merge's outer ring. *@
                    <circle cx="@LaneX(row.Lane)" cy="@rowMid" r="5" style="fill:var(--bg-sunken);stroke:@LaneColor(row.Lane)" stroke-width="2.5" />
                }
                else
                {
                    <circle cx="@LaneX(row.Lane)" cy="@rowMid" r="5" class="commit-node" fill="@LaneColor(row.Lane)" stroke-width="2" />
                }
            }
        </svg>
    </div>

    @if (_hasMore)
    {
        <button type="button" @onclick="LoadMoreAsync">Load more</button>
    }
}

<ConfirmDialog @ref="_confirmDialog" />

@code {
    private const int PageSize = 50;
    private const int RowHeight = 34;
    private const int LaneWidth = 20;

    private static readonly string[] LaneColors =
    [
        "#ec4899", "#fb923c", "#6d28d9", "#22d3ee", "#4ade80", "#facc15", "#f87171", "#a78bfa",
    ];

    /// <summary>Which repository's commit history to show.</summary>
    [Parameter, EditorRequired]
    public string RepositoryName { get; set; } = string.Empty;

    /// <summary>
    /// Raised after a branch-switch attempt from a commit's ref pill (regardless of outcome) - the
    /// parent page's own branch dropdown/summary has no other way to learn about a switch triggered
    /// from here, since it isn't the one that called <see cref="IRepositoryManager.SwitchBranchAsync"/>.
    /// </summary>
    [Parameter]
    public EventCallback OnBranchSwitched { get; set; }

    /// <summary>
    /// The checked-out commit's short hash when the repository is in a detached-HEAD state, or
    /// <see langword="null"/> when it's on a branch. A commit's own <see cref="CommitRef.IsCurrent"/>
    /// already identifies the checked-out commit while attached to a branch (git's own "HEAD ->"
    /// decoration), but detached HEAD produces no ref decoration on any commit at all - this is the
    /// only way to still highlight the right row in that state. Comes from the parent's own
    /// <c>RepositorySummary.Branch</c>, which already holds the short hash instead of a branch name
    /// while <c>IsDetachedHead</c> is set (see RepositoryDisplay.GitStatusText).
    /// </summary>
    [Parameter]
    public string? DetachedHeadShortHash { get; set; }

    private IReadOnlyList<CommitSummary>? _commits;
    private CommitGraphResult? _graph;
    private bool _hasMore;
    private string? _error;
    private IDisposable? _statsSubscription;
    private ConfirmDialog? _confirmDialog;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        await LoadAsync(PageSize);

        // Piggybacks on the same live-update signal driving git-status refresh elsewhere on this
        // page, rather than a separate polling loop - a pull, checkout, or commit made anywhere
        // recomputes stats, which is exactly when the commit graph could also be stale.
        _statsSubscription = RepositoryStatsEventBus.Subscribe(OnRepositoryStatsChanged);
    }

    private void OnRepositoryStatsChanged(string repositoryName)
    {
        if (!string.Equals(repositoryName, RepositoryName, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await LoadAsync(Math.Max(PageSize, _commits?.Count ?? PageSize));
            StateHasChanged();
        });
    }

    private async Task LoadAsync(int take)
    {
        var commits = await RepositoryManager.ListCommitsAsync(RepositoryName, 0, take, CancellationToken.None);
        _commits = commits;
        _graph = CommitGraphLayout.Compute(commits);
        _hasMore = commits.Count == take;
    }

    private Task LoadMoreAsync() => LoadAsync((_commits?.Count ?? 0) + PageSize);

    private Task ConfirmCheckoutAsync(CommitSummary commit) =>
        _confirmDialog!.ShowAsync(
            "Checkout commit",
            $"Check out commit {commit.ShortHash} (\"{commit.Subject}\") as a detached HEAD? The working tree moves to this exact commit, leaving the current branch.",
            () => CheckoutAsync(commit.Hash),
            confirmLabel: "Checkout");

    private async Task CheckoutAsync(string hash)
    {
        _error = null;
        var result = await RepositoryManager.CheckoutCommitAsync(RepositoryName, hash, CancellationToken.None);

        _error = result switch
        {
            RepositoryGitActionResult.Failed failed => failed.ErrorMessage ?? "Checkout failed.",
            RepositoryGitActionResult.Rejected { Reason: RepositoryActionRejectionReason.Busy } rejected => $"Busy - conflicting run {rejected.ConflictingRunId}.",
            RepositoryGitActionResult.Rejected => "Rejected.",
            _ => null,
        };

        await LoadAsync(Math.Max(PageSize, _commits?.Count ?? PageSize));
    }

    // A remote-tracking ref's Name keeps its "<remote>/<branch>" shape (see CommitRef's own remarks),
    // but SwitchBranchAsync takes a short branch name and resolves a matching remote ref itself - the
    // same contract RepositoryDetail.razor's branch dropdown already relies on.
    private Task ConfirmSwitchBranchAsync(CommitRef reference)
    {
        var shortName = reference.Kind == CommitRefKind.RemoteBranch
            ? reference.Name[(reference.Name.IndexOf('/') + 1)..]
            : reference.Name;

        return _confirmDialog!.ShowAsync(
            "Switch branch",
            $"Switch to branch '{shortName}'? The working tree will be updated to match its tip.",
            () => SwitchBranchAsync(shortName),
            confirmLabel: "Switch");
    }

    private async Task SwitchBranchAsync(string branch)
    {
        _error = null;
        var result = await RepositoryManager.SwitchBranchAsync(RepositoryName, branch, CancellationToken.None);

        _error = result switch
        {
            RepositoryGitActionResult.Failed failed => failed.ErrorMessage ?? "Branch switch failed.",
            RepositoryGitActionResult.Rejected { Reason: RepositoryActionRejectionReason.Busy } rejected => $"Busy - conflicting run {rejected.ConflictingRunId}.",
            RepositoryGitActionResult.Rejected => "Rejected.",
            _ => null,
        };

        await LoadAsync(Math.Max(PageSize, _commits?.Count ?? PageSize));
        await OnBranchSwitched.InvokeAsync();
    }

    private bool IsCheckedOut(CommitSummary commit) =>
        commit.Refs.Any(r => r.IsCurrent) ||
        (DetachedHeadShortHash is not null && string.Equals(commit.ShortHash, DetachedHeadShortHash, StringComparison.OrdinalIgnoreCase));

    // A merge point: 2+ connectors leave this row's own lane (the self/first-parent continuation
    // plus one per additional parent). A fork point: 2+ connectors arrive into it (the self
    // continuation plus one per other lane converging here, i.e. this commit has 2+ children in
    // different lanes). Derived from the already-computed connectors, not commit.ParentHashes.Count
    // directly, so it stays consistent with whatever the layout actually drew.
    private static bool IsMergePoint(CommitGraphRow row) => row.Connectors.Count(c => c.FromLane == row.Lane) > 1;

    private static bool IsForkPoint(CommitGraphRow row) => row.Connectors.Count(c => c.ToLane == row.Lane) > 1;

    private static string LaneColor(int lane) => LaneColors[lane % LaneColors.Length];

    private static int LaneX(int lane) => lane * LaneWidth + LaneWidth / 2;

    // A cubic-bezier S-curve between two lane columns, control points pinned to the segment's own
    // vertical midpoint (not the full row's) - the standard smoothed shape a branch/merge line takes
    // in tools like Fork or GitKraken, versus this graph's previous plain diagonal <line>. Same-lane
    // (straight) segments stay plain <line>s, drawn separately by the caller.
    private static string CurvePath(int x1, int y1, int x2, int y2)
    {
        var yMid = (y1 + y2) / 2;
        return FormattableString.Invariant($"M{x1},{y1} C{x1},{yMid} {x2},{yMid} {x2},{y2}");
    }

    private static string RefPillClass(CommitRefKind kind) => kind switch
    {
        CommitRefKind.RemoteBranch => "ref-pill-remote",
        CommitRefKind.Tag => "ref-pill-tag",
        _ => "ref-pill-local",
    };

    // Local time, no offset suffix - see RunDetail.razor's own FormatDateTime for why.
    private static string FormatDate(DateTimeOffset value) =>
        value.ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);

    /// <inheritdoc />
    public void Dispose() => _statsSubscription?.Dispose();
}

@using OutOfTheBox.Application.Monitoring
@inject ResourceHistoryBuffer HistoryBuffer
@inject IResourceEventBus ResourceEventBus
@inject IChartInterop ChartInterop
@implements IAsyncDisposable

@if (Note is not null)
{
    <p class="run-graph-note">@Note</p>
}

@if (IsHost)
{
    <!-- Three explicit rows, per direct request - not left to flex-wrap's own natural reflow, which
         wouldn't guarantee this specific arrangement across viewport widths:
         1. CPU alone, scaled to the full row width (a lone flex item with flex-grow:1 already
            stretches to fill - see .resource-graph in dashboard.css) and showing the buffer's full
            20-minute retention, not just the usual 10.
         2. CPU per core + RAM, each showing the usual 10 minutes.
         3. Network + Disk I/O, each also 10 minutes. -->
    <div class="resource-graphs">
        <div class="resource-graph">
            <span class="resource-graph-label">CPU %</span>
            <div class="resource-graph-canvas-wrap"><canvas id="@_cpuCanvasId"></canvas></div>
        </div>
    </div>
    <div class="resource-graphs">
        <div class="resource-graph">
            <span class="resource-graph-label">CPU per core</span>
            <div class="resource-graph-canvas-wrap"><canvas id="@_perCoreCanvasId"></canvas></div>
        </div>
        <div class="resource-graph">
            <span class="resource-graph-label">RAM</span>
            <div class="resource-graph-canvas-wrap"><canvas id="@_ramCanvasId"></canvas></div>
        </div>
    </div>
    <div class="resource-graphs">
        <div class="resource-graph">
            <span class="resource-graph-label">Network</span>
            <div class="resource-graph-canvas-wrap"><canvas id="@_networkCanvasId"></canvas></div>
        </div>
        <div class="resource-graph">
            <span class="resource-graph-label">Disk I/O</span>
            <div class="resource-graph-canvas-wrap"><canvas id="@_diskCanvasId"></canvas></div>
        </div>
    </div>
}
else
{
    <!-- Same four figures as the run-detail page's own RunHistoryGraph, just in a single compact row
         (.resource-graphs-run, smaller than the detail page's two-row layout) rather than two - per
         direct request, so an expanded run card on the Status page shows the same data at a glance
         without needing a full page navigation. -->
    <div class="resource-graphs resource-graphs-run">
        <div class="resource-graph">
            <span class="resource-graph-label">CPU %</span>
            <div class="resource-graph-canvas-wrap"><canvas id="@_cpuCanvasId"></canvas></div>
        </div>
        <div class="resource-graph">
            <span class="resource-graph-label">RAM</span>
            <div class="resource-graph-canvas-wrap"><canvas id="@_ramCanvasId"></canvas></div>
        </div>
        <div class="resource-graph">
            <span class="resource-graph-label">Network</span>
            <div class="resource-graph-canvas-wrap"><canvas id="@_networkCanvasId"></canvas></div>
        </div>
        <div class="resource-graph">
            <span class="resource-graph-label">Disk I/O</span>
            <div class="resource-graph-canvas-wrap"><canvas id="@_diskCanvasId"></canvas></div>
        </div>
    </div>
}

@code {
    /// <summary>The <see cref="ResourceHistoryBuffer"/> series key to read from - <see cref="ResourceHistoryBuffer.HostSeriesKey"/> for the host, or a run id's string form for a run/transfer.</summary>
    [Parameter, EditorRequired]
    public string SeriesKey { get; set; } = string.Empty;

    /// <summary>Optional caption shown above the graphs - used to label a transfer's graph as host-level activity rather than a per-process figure.</summary>
    [Parameter]
    public string? Note { get; set; }

    // Per-core CPU has no meaning for a run/transfer (it has no cores of its own) - that one extra
    // chart only makes sense for the host series. Network/disk figures, by contrast, are tagged onto
    // every series now (see ResourceHistoryPoint's own remarks) and shown for both - a run/transfer
    // has no isolated network/disk figure of its own (see the Note parameter for how that's
    // communicated to the operator for a transfer), but the host-level figure is still useful context
    // alongside that run's own CPU/RAM while it's expanded.
    private bool IsHost => SeriesKey == ResourceHistoryBuffer.HostSeriesKey;

    private static readonly IReadOnlyList<string> CoreLabels = [.. Enumerable.Range(0, Environment.ProcessorCount).Select(core => $"Core {core}")];
    private static readonly IReadOnlyList<string> NetworkLabels = ["Sent", "Received"];
    private static readonly IReadOnlyList<string> DiskLabels = ["Read", "Write"];

    // Every live graph shows the usual 10 minutes, except the host's row-1 CPU-total graph, which
    // shows the buffer's full 20-minute retention - per direct instruction.
    private static readonly TimeSpan LiveWindow = TimeSpan.FromMinutes(10);
    private static readonly TimeSpan HostCpuLiveWindow = TimeSpan.FromMinutes(20);

    private readonly string _cpuCanvasId = $"live-cpu-{Guid.NewGuid():N}";
    private readonly string _ramCanvasId = $"live-ram-{Guid.NewGuid():N}";
    private readonly string _perCoreCanvasId = $"live-per-core-{Guid.NewGuid():N}";
    private readonly string _networkCanvasId = $"live-network-{Guid.NewGuid():N}";
    private readonly string _diskCanvasId = $"live-disk-{Guid.NewGuid():N}";
    private IDisposable? _subscription;
    private DateTimeOffset? _lastPushedTimestamp;

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var cpuWindow = IsHost ? HostCpuLiveWindow : LiveWindow;
        await ChartInterop.CreateLineChartAsync(_cpuCanvasId, ["CPU %"], showLegend: false, liveWindow: cpuWindow);
        await ChartInterop.CreateLineChartAsync(_ramCanvasId, ["RAM (bytes)"], ChartValueFormat.Bytes, showLegend: false, liveWindow: LiveWindow);
        await ChartInterop.CreateLineChartAsync(_networkCanvasId, NetworkLabels, ChartValueFormat.BytesPerSecond, liveWindow: LiveWindow);
        await ChartInterop.CreateLineChartAsync(_diskCanvasId, DiskLabels, ChartValueFormat.BytesPerSecond, liveWindow: LiveWindow);

        // Explicitly windowed rather than relying on ResourceHistoryBuffer.Get's own default -
        // the buffer itself now retains 20 minutes (so the host CPU chart above can show that much),
        // but every other graph here should still only ever seed/display the usual 10.
        var cpuInitial = HistoryBuffer.Get(SeriesKey, cpuWindow);
        var initial = HistoryBuffer.Get(SeriesKey, LiveWindow);
        await ChartInterop.SetSeriesAsync(_cpuCanvasId, 0, cpuInitial.Select(p => (p.Timestamp, p.CpuPercent)));
        await ChartInterop.SetSeriesAsync(_ramCanvasId, 0, initial.Select(p => (p.Timestamp, (double)p.RamBytes)));
        await ChartInterop.SetSeriesAsync(_networkCanvasId, 0, initial.Select(p => (p.Timestamp, p.NetworkBytesSentPerSecond ?? 0)));
        await ChartInterop.SetSeriesAsync(_networkCanvasId, 1, initial.Select(p => (p.Timestamp, p.NetworkBytesReceivedPerSecond ?? 0)));
        await ChartInterop.SetSeriesAsync(_diskCanvasId, 0, initial.Select(p => (p.Timestamp, p.DiskReadBytesPerSecond ?? 0)));
        await ChartInterop.SetSeriesAsync(_diskCanvasId, 1, initial.Select(p => (p.Timestamp, p.DiskWriteBytesPerSecond ?? 0)));

        if (IsHost)
        {
            await ChartInterop.CreateLineChartAsync(_perCoreCanvasId, CoreLabels, showLegend: false, liveWindow: LiveWindow);

            for (var core = 0; core < CoreLabels.Count; core++)
            {
                var coreIndex = core;
                await ChartInterop.SetSeriesAsync(_perCoreCanvasId, coreIndex, initial.Select(p => (p.Timestamp, CoreValue(p, coreIndex))));
            }
        }

        // cpuInitial's own window is always >= every other chart's here, so its latest point (if
        // any) is always at least as recent - safe to derive the "have we already pushed this tick"
        // baseline from it alone rather than a third, unwindowed Get() call.
        _lastPushedTimestamp = cpuInitial.Count > 0 ? cpuInitial[^1].Timestamp : null;

        _subscription = ResourceEventBus.Subscribe(OnTick);
    }

    private static double CoreValue(ResourceHistoryPoint point, int coreIndex) =>
        point.PerCoreCpuPercent is { } cores && coreIndex < cores.Count ? cores[coreIndex] : 0;

    private void OnTick(ResourceSnapshot snapshot) => _ = InvokeAsync(async () =>
    {
        // The event's own payload only carries process-tree-based run aggregates (never a
        // transfer, which has no process tree) - reading back through HistoryBuffer instead of the
        // event payload lets one code path serve the host series, a command run's series, and a
        // transfer's series uniformly, since HostResourceSamplerService.TickAsync writes all three
        // into the buffer before publishing regardless of kind.
        var points = HistoryBuffer.Get(SeriesKey);
        if (points.Count == 0)
        {
            return;
        }

        var latest = points[^1];
        if (_lastPushedTimestamp == latest.Timestamp)
        {
            return;
        }

        _lastPushedTimestamp = latest.Timestamp;
        await ChartInterop.PushPointAsync(_cpuCanvasId, 0, latest.Timestamp, latest.CpuPercent);
        await ChartInterop.PushPointAsync(_ramCanvasId, 0, latest.Timestamp, latest.RamBytes);
        await ChartInterop.PushPointAsync(_networkCanvasId, 0, latest.Timestamp, latest.NetworkBytesSentPerSecond ?? 0);
        await ChartInterop.PushPointAsync(_networkCanvasId, 1, latest.Timestamp, latest.NetworkBytesReceivedPerSecond ?? 0);
        await ChartInterop.PushPointAsync(_diskCanvasId, 0, latest.Timestamp, latest.DiskReadBytesPerSecond ?? 0);
        await ChartInterop.PushPointAsync(_diskCanvasId, 1, latest.Timestamp, latest.DiskWriteBytesPerSecond ?? 0);

        if (IsHost)
        {
            for (var core = 0; core < CoreLabels.Count; core++)
            {
                await ChartInterop.PushPointAsync(_perCoreCanvasId, core, latest.Timestamp, CoreValue(latest, core));
            }
        }
    });

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        _subscription?.Dispose();
        await ChartInterop.DestroyAsync(_cpuCanvasId);
        await ChartInterop.DestroyAsync(_ramCanvasId);
        await ChartInterop.DestroyAsync(_networkCanvasId);
        await ChartInterop.DestroyAsync(_diskCanvasId);

        if (IsHost)
        {
            await ChartInterop.DestroyAsync(_perCoreCanvasId);
        }
    }
}

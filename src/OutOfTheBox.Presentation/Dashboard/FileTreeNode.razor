@using OutOfTheBox.Application.Repositories
@using OutOfTheBox.Domain.Repositories
@inject IRepositoryFileBrowser FileBrowser
@implements IDisposable

@if (DirtyPaths is null || IsDirtyRelevant)
{
    <div class="file-tree-row" @onclick="OnRowClickAsync">
        <Icon Name="@(IsDirectory ? (_expanded ? "folder-open" : "folder") : "file")" />

        @if (_renaming)
        {
            <input class="file-tree-rename-input" value="@_renameValue" @oninput="@(e => _renameValue = e.Value?.ToString() ?? string.Empty)" @onclick:stopPropagation="true" @onkeydown="OnRenameKeyDownAsync" />
            <span class="file-tree-actions" style="visibility: visible" @onclick:stopPropagation="true">
                <button type="button" class="icon-button" title="Confirm rename" @onclick="ConfirmRenameAsync">
                    <Icon Name="confirm" />
                </button>
                <button type="button" class="icon-button" title="Cancel rename" @onclick="CancelRename">
                    <Icon Name="close" />
                </button>
            </span>
        }
        else
        {
            <span class="file-tree-name" title="@Name">@Name</span>
            <span class="file-tree-actions" @onclick:stopPropagation="true">
                @if (!IsDirectory)
                {
                    <a class="icon-button" title="Download" href="@DownloadUrl">
                        <Icon Name="download" />
                    </a>
                }
                <button type="button" class="icon-button" title="Rename" @onclick="StartRename">
                    <Icon Name="pencil" />
                </button>
                <button type="button" class="icon-button icon-button-danger" title="Delete" @onclick="ConfirmDeleteAsync">
                    <Icon Name="trash" />
                </button>
            </span>
            @if (!IsDirectory && SizeBytes is not null)
            {
                <span class="file-tree-meta">@RepositoryDisplay.FormatSize(SizeBytes.Value)</span>
            }
        }
    </div>

    @if (IsDirectory && _expanded)
    {
        <div class="file-tree-children">
            @if (_children is null)
            {
                <p class="empty-state">Loading...</p>
            }
            else if (_children.Count == 0)
            {
                <p class="empty-state">Empty</p>
            }
            else
            {
                @foreach (var child in _children)
                {
                    <FileTreeNode
                        @key="child.Name"
                        RepositoryName="@RepositoryName"
                        ParentRelativePath="@RelativePath"
                        Name="@child.Name"
                        IsDirectory="@child.IsDirectory"
                        SizeBytes="@child.SizeBytes"
                        Depth="@(Depth + 1)"
                        OnChanged="LoadChildrenAsync"
                        RequestConfirm="RequestConfirm"
                        RequestPreview="RequestPreview" />
                }
            }
        </div>
    }
}

@code {
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(15);

    /// <summary>Which repository this node belongs to.</summary>
    [Parameter, EditorRequired]
    public string RepositoryName { get; set; } = string.Empty;

    /// <summary>The relative path of this node's parent directory (empty string for a top-level entry, directly under the repository root).</summary>
    [Parameter]
    public string ParentRelativePath { get; set; } = string.Empty;

    /// <summary>This entry's own name within its parent directory.</summary>
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    /// <summary>Whether this entry is a folder.</summary>
    [Parameter]
    public bool IsDirectory { get; set; }

    /// <summary>The file's size in bytes; <see langword="null"/> for a folder.</summary>
    [Parameter]
    public long? SizeBytes { get; set; }

    /// <summary>How many levels deep this node is - used only for the CSS indentation the parent's <c>.file-tree-children</c> margin already applies per level, kept as a parameter for a future non-CSS-based indentation need.</summary>
    [Parameter]
    public int Depth { get; set; }

    /// <summary>Raised after this node is successfully renamed or deleted, so the parent reloads its own children list - the single source of truth for what's actually on disk, rather than this node privately mutating its own name.</summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    // Bubbled up to FileTree (the root, which owns the single shared ConfirmDialog/FilePreviewDialog
    // instance for the whole tree) as an EventCallback rather than passed down as a direct component
    // reference - a deeply nested node can otherwise be created (and immediately clicked) on the same
    // render where the root's own @ref hasn't been assigned yet, since a child's parameters are
    // evaluated as part of building the parent's render tree, strictly before the parent's own @ref
    // callbacks for elements declared later in that same markup are applied. Dereferencing a still-null
    // dialog reference crashed the whole Blazor circuit (a NullReferenceException in a component event
    // handler is fatal, not just a failed click) - an EventCallback has no such window, since it's just
    // a delegate reference, resolvable the instant the root component exists, long before any nested
    // node could possibly exist to raise one.

    /// <summary>Raised to ask the root <see cref="FileTree"/> to show its shared <see cref="ConfirmDialog"/>.</summary>
    [Parameter, EditorRequired]
    public EventCallback<FileTreeConfirmRequest> RequestConfirm { get; set; }

    /// <summary>Raised to ask the root <see cref="FileTree"/> to show its shared <see cref="FilePreviewDialog"/>.</summary>
    [Parameter, EditorRequired]
    public EventCallback<FilePreviewRequest> RequestPreview { get; set; }

    // Cascaded from FileTree.razor's own <CascadingValue> rather than threaded through as a regular
    // parameter at every recursive <FileTreeNode> invocation site - null when the "dirty files only"
    // filter is off, otherwise the full set of repo-relative dirty paths (not just this node's own
    // subtree), so every node at every depth can independently decide its own relevance.
    [CascadingParameter(Name = "DirtyPaths")]
    private HashSet<string>? DirtyPaths { get; set; }

    private bool _expanded;
    private bool _dirtyFilterWasActive;
    private IReadOnlyList<RepositoryFileEntry>? _children;
    private CancellationTokenSource? _pollCts;
    private bool _renaming;
    private string _renameValue = string.Empty;

    private string RelativePath => string.IsNullOrEmpty(ParentRelativePath) ? Name : $"{ParentRelativePath}/{Name}";

    private string DownloadUrl => $"/dashboard-files/{Uri.EscapeDataString(RepositoryName)}?path={Uri.EscapeDataString(RelativePath)}";

    // A file is relevant if it's dirty itself, or if it sits inside a directory git reports as a
    // single wholesale-dirty entry (an entirely untracked directory shows up in `git status
    // --porcelain` as one "?? dir/" line, not one line per file inside it - without this check,
    // every file under such a directory would be invisible under the filter). A folder is relevant
    // if it contains a dirty descendant anywhere below it (not just its immediate children), or if
    // it's itself nested inside one of those wholesale-dirty directories.
    private bool IsDirtyRelevant => DirtyPaths is not null && (IsUnderWholesaleDirtyDirectory
        || (IsDirectory
            ? DirtyPaths.Any(path => path.StartsWith(RelativePath + "/", StringComparison.Ordinal))
            : DirtyPaths.Contains(RelativePath)));

    private bool IsUnderWholesaleDirtyDirectory =>
        DirtyPaths!.Any(path => path.EndsWith('/') && RelativePath.StartsWith(path, StringComparison.Ordinal));

    // Auto-expands a relevant folder exactly once per "filter just turned on" transition (not on
    // every unrelated re-render the cascading value's own container re-renders for) - otherwise an
    // operator manually collapsing a folder while the filter stays on would find it immediately
    // re-expanding itself on the tree's next poll tick, fighting their own input.
    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        var dirtyFilterActive = DirtyPaths is not null;
        if (dirtyFilterActive && !_dirtyFilterWasActive && IsDirectory && IsDirtyRelevant && !_expanded)
        {
            _expanded = true;
            await LoadChildrenAsync();
            StartPolling();
        }

        _dirtyFilterWasActive = dirtyFilterActive;
    }

    private async Task OnRowClickAsync()
    {
        if (_renaming)
        {
            return;
        }

        if (!IsDirectory)
        {
            // Always requested, even for a file FilePreviewDialog turns out not to be able to render -
            // what it actually is can only be known by reading its content, which is FilePreviewDialog's
            // own job (it shows "No preview available" itself rather than this node pre-guessing from
            // the file's name).
            await RequestPreview.InvokeAsync(new FilePreviewRequest(RepositoryName, RelativePath, Name, DownloadUrl));
            return;
        }

        _expanded = !_expanded;

        if (_expanded)
        {
            await LoadChildrenAsync();
            StartPolling();
        }
        else
        {
            StopPolling();
        }
    }

    private async Task LoadChildrenAsync()
    {
        _children = await FileBrowser.ListDirectoryAsync(RepositoryName, RelativePath, CancellationToken.None);
        await InvokeAsync(StateHasChanged);
    }

    private void StartPolling()
    {
        _pollCts?.Cancel();
        var cts = new CancellationTokenSource();
        _pollCts = cts;
        _ = PollLoopAsync(cts.Token);
    }

    private void StopPolling()
    {
        _pollCts?.Cancel();
        _pollCts = null;
    }

    // Re-lists just this one folder's own immediate children on a fixed interval while expanded -
    // not the whole tree - per specs/service-dashboard's "An expanded folder reflects a change made
    // elsewhere" requirement/scenario, independent of every other expanded node's own polling.
    private async Task PollLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (true)
            {
                await Task.Delay(PollInterval, cancellationToken);
                var fresh = await FileBrowser.ListDirectoryAsync(RepositoryName, RelativePath, cancellationToken);
                cancellationToken.ThrowIfCancellationRequested();
                _children = fresh;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void StartRename()
    {
        _renameValue = Name;
        _renaming = true;
    }

    private void CancelRename() => _renaming = false;

    private async Task OnRenameKeyDownAsync(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Enter":
                await ConfirmRenameAsync();
                break;
            case "Escape":
                CancelRename();
                break;
        }
    }

    private async Task ConfirmRenameAsync()
    {
        _renaming = false;

        if (string.IsNullOrWhiteSpace(_renameValue) || _renameValue == Name)
        {
            return;
        }

        var result = await FileBrowser.RenameAsync(RepositoryName, RelativePath, _renameValue, CancellationToken.None);
        if (result is RepositoryFileActionResult.Succeeded)
        {
            await OnChanged.InvokeAsync();
        }
    }

    private Task ConfirmDeleteAsync() =>
        RequestConfirm.InvokeAsync(new FileTreeConfirmRequest(
            IsDirectory ? "Delete folder" : "Delete file",
            IsDirectory
                ? $"Permanently delete the folder '{Name}' and everything inside it? This cannot be undone."
                : $"Permanently delete '{Name}'? This cannot be undone.",
            DeleteAsync,
            "Delete"));

    private async Task DeleteAsync()
    {
        var result = await FileBrowser.DeleteAsync(RepositoryName, RelativePath, CancellationToken.None);
        if (result is RepositoryFileActionResult.Succeeded)
        {
            await OnChanged.InvokeAsync();
        }
    }

    /// <inheritdoc />
    public void Dispose() => StopPolling();
}

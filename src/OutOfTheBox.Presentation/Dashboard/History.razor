@page "/history"
@attribute [Authorize]
@using System.Globalization
@using OutOfTheBox.Application.Execution
@inject IRunRepository RunRepository
@inject IWorkingDirectoryResolver WorkingDirectoryResolver
@inject NavigationManager NavigationManager

<PageTitle>@VersionInfo.DisplayName - History</PageTitle>

<h1>History</h1>

<div class="history-filters">
    <fieldset>
        <legend>Kind</legend>
        @foreach (var kind in AllKinds)
        {
            <label>
                <input type="checkbox" checked="@_selectedKinds.Contains(kind)" @onchange="@(e => ToggleKind(kind, (bool)e.Value!))" />
                @kind.ShortLabel()
            </label>
        }
    </fieldset>

    <label>
        Outcome
        <select @bind="_selectedOutcome" @bind:after="RefreshAsync">
            <option value="">(any)</option>
            @foreach (var outcome in AllOutcomes)
            {
                <option value="@outcome">@outcome.Label()</option>
            }
        </select>
    </label>

    <label>
        Repository
        <input type="text" @bind="_repositoryFilter" @bind:event="oninput" @bind:after="RefreshAsync" placeholder="Repository name" />
    </label>

    <label>
        Search
        <input type="text" value="@_searchText" @oninput="OnSearchInput" placeholder="Search repository, arguments, file path, source URL" />
    </label>

    <button type="button" @onclick="ClearFiltersAsync">Clear filters</button>
</div>

@if (_runs is null)
{
    <p>Loading...</p>
}
else if (_runs.Count == 0)
{
    <p class="empty-state">No runs match the current filters.</p>
}
else
{
    <table class="data-table clickable-rows">
        <colgroup>
            <col style="width:1%" />
            <col style="width:1%" />
            <col style="width:1%" />
            <col />
            <col style="width:1%" />
        </colgroup>
        <thead>
            <tr>
                <th class="col-shrink" @onclick="@(() => SortBy(SortColumn.Kind))">Kind@(SortIndicator(SortColumn.Kind))</th>
                <th class="col-shrink" @onclick="@(() => SortBy(SortColumn.Outcome))">Outcome@(SortIndicator(SortColumn.Outcome))</th>
                <th class="col-shrink" @onclick="@(() => SortBy(SortColumn.Repository))">Repository@(SortIndicator(SortColumn.Repository))</th>
                <th @onclick="@(() => SortBy(SortColumn.Detail))">Detail@(SortIndicator(SortColumn.Detail))</th>
                <th class="col-shrink" @onclick="@(() => SortBy(SortColumn.Started))">Started@(SortIndicator(SortColumn.Started))</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var run in SortedRuns())
            {
                <tr @onclick="@(() => NavigationManager.NavigateTo($"history/{run.Id}"))">
                    <td class="col-shrink"><span class="kind-badge kind-@run.Kind.ToString().ToLowerInvariant()">@run.Kind.ShortLabel()</span></td>
                    <td class="col-shrink">@run.Outcome.Label()</td>
                    <td class="col-shrink ellipsis" title="@RunDisplay.RepositoryName(run)">@RunDisplay.RepositoryName(run)</td>
                    <td class="ellipsis" title="@RunDisplay.Detail(run)">@RunDisplay.Detail(run)</td>
                    <td class="col-shrink">@FormatDateTime(run.StartedAt)</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private static readonly RunKind[] AllKinds = Enum.GetValues<RunKind>();
    private static readonly RunOutcome[] AllOutcomes = Enum.GetValues<RunOutcome>();

    private readonly HashSet<RunKind> _selectedKinds = [];
    private string _selectedOutcome = string.Empty;
    private string _repositoryFilter = string.Empty;
    private string _searchText = string.Empty;
    private IReadOnlyList<Run>? _runs;
    private CancellationTokenSource? _debounceCts;
    private SortColumn _sortColumn = SortColumn.Started;
    private bool _sortAscending;

    private enum SortColumn
    {
        Kind,
        Outcome,
        Repository,
        Detail,
        Started,
    }

    /// <inheritdoc />
    protected override Task OnInitializedAsync() => RefreshAsync();

    private Task ToggleKind(RunKind kind, bool isSelected)
    {
        if (isSelected)
        {
            _selectedKinds.Add(kind);
        }
        else
        {
            _selectedKinds.Remove(kind);
        }

        return RefreshAsync();
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString() ?? string.Empty;

        // Debounced: cancel any pending refresh from a prior keystroke and start a fresh delay -
        // only the last keystroke in a burst actually triggers a query, per design.md's
        // "History filter/search UI" decision.
        _debounceCts?.Cancel();
        var cts = new CancellationTokenSource();
        _debounceCts = cts;

        try
        {
            await Task.Delay(TimeSpan.FromMilliseconds(300), cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        await RefreshAsync();
        StateHasChanged();
    }

    private Task ClearFiltersAsync()
    {
        _selectedKinds.Clear();
        _selectedOutcome = string.Empty;
        _repositoryFilter = string.Empty;
        _searchText = string.Empty;
        return RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        // The filter is a repository name (what an operator actually thinks in), but Run.RepositoryPath
        // stores the resolved absolute path - resolved the same way any other repository-relative
        // reference is before it's used to query. An unresolvable name (e.g. one that would escape
        // the configured root) matches nothing rather than silently falling back to "no filter."
        var repositoryPathFilter = string.IsNullOrWhiteSpace(_repositoryFilter)
            ? null
            : WorkingDirectoryResolver.Resolve(_repositoryFilter) is { IsAllowed: true, ResolvedPath: { } resolvedPath }
                ? resolvedPath
                : Guid.NewGuid().ToString();

        var query = new RunQuery
        {
            Kinds = _selectedKinds.Count > 0 ? _selectedKinds : null,
            Outcomes = Enum.TryParse<RunOutcome>(_selectedOutcome, out var outcome) ? [outcome] : null,
            RepositoryPath = repositoryPathFilter,
            SearchText = string.IsNullOrWhiteSpace(_searchText) ? null : _searchText,
        };

        _runs = await RunRepository.ListAsync(query, CancellationToken.None);
    }

    private void SortBy(SortColumn column)
    {
        if (_sortColumn == column)
        {
            _sortAscending = !_sortAscending;
        }
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
    }

    private string SortIndicator(SortColumn column) => _sortColumn == column ? (_sortAscending ? " ▲" : " ▼") : string.Empty;

    private IEnumerable<Run> SortedRuns()
    {
        IEnumerable<Run> ordered = _sortColumn switch
        {
            SortColumn.Kind => _runs!.OrderBy(r => r.Kind.ShortLabel(), StringComparer.OrdinalIgnoreCase),
            SortColumn.Outcome => _runs!.OrderBy(r => r.Outcome.Label(), StringComparer.OrdinalIgnoreCase),
            SortColumn.Repository => _runs!.OrderBy(RunDisplay.RepositoryName, StringComparer.OrdinalIgnoreCase),
            SortColumn.Detail => _runs!.OrderBy(RunDisplay.Detail, StringComparer.OrdinalIgnoreCase),
            _ => _runs!.OrderBy(r => r.StartedAt),
        };

        return _sortAscending ? ordered : ordered.Reverse();
    }

    // Local time, no offset suffix - see RunDetail.razor's own FormatDateTime for why.
    private static string FormatDateTime(DateTimeOffset value) =>
        value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture);
}

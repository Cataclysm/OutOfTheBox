@page "/history"
@attribute [Authorize]
@using System.Globalization
@inject IRunRepository RunRepository
@inject IRunEventBus RunEventBus
@inject NavigationManager NavigationManager
@implements IDisposable

<PageTitle>@VersionInfo.DisplayName - History</PageTitle>

<h1>History</h1>

<div class="run-filters run-filters-history">
    <span class="run-filter-label">Kind</span>
    <details class="kind-filter-dropdown">
        <summary>@KindFilterSummary()</summary>
        <div class="kind-filter-dropdown-panel">
            @foreach (var kind in AllKinds)
            {
                <label>
                    <input type="checkbox" checked="@_selectedKinds.Contains(kind)" @onchange="@(e => ToggleKind(kind, (bool)e.Value!))" />
                    @kind.ShortLabel()
                </label>
            }
        </div>
    </details>

    <span class="run-filter-label">Outcome</span>
    <select @bind="_selectedOutcome" @bind:after="RefreshAsync">
        <option value="">(any)</option>
        @foreach (var outcome in AllOutcomes)
        {
            <option value="@outcome">@outcome.Label()</option>
        }
    </select>

    <span class="run-filter-label">Repository</span>
    <input type="text" @bind="_repositoryFilter" @bind:event="oninput" @bind:after="RefreshAsync" placeholder="Repository name" />

    <span class="run-filter-label">Search</span>
    <input type="text" value="@_searchText" @oninput="OnSearchInput" placeholder="Search repository, arguments, file path, source URL" />

    <button type="button" class="icon-button run-filters-action" title="Clear filters" @onclick="ClearFiltersAsync">
        <Icon Name="clear-filters" />
    </button>
</div>

@if (_runs is null)
{
    <p>Loading...</p>
}
else if (_runs.Count == 0)
{
    <p class="empty-state">No runs match the current filters.</p>
}
else
{
    <table class="data-table clickable-rows">
        <colgroup>
            <col style="width:1%" />
            <col style="width:1%" />
            <col style="width:1%" />
            <col />
            <col style="width:1%" />
        </colgroup>
        <thead>
            <tr>
                <th class="col-shrink" @onclick="@(() => SortBy(SortColumn.Kind))">Kind@(SortIndicator(SortColumn.Kind))</th>
                <th class="col-shrink" @onclick="@(() => SortBy(SortColumn.Outcome))">Outcome@(SortIndicator(SortColumn.Outcome))</th>
                <th class="col-shrink" @onclick="@(() => SortBy(SortColumn.Repository))">Repository@(SortIndicator(SortColumn.Repository))</th>
                <th @onclick="@(() => SortBy(SortColumn.Detail))">Detail@(SortIndicator(SortColumn.Detail))</th>
                <th class="col-shrink" @onclick="@(() => SortBy(SortColumn.Started))">Started@(SortIndicator(SortColumn.Started))</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var run in SortedRuns())
            {
                <tr @key="run.Id" @onclick="@(() => NavigationManager.NavigateTo($"history/{run.Id}"))">
                    <td class="col-shrink"><span class="kind-badge kind-@run.Kind.ToString().ToLowerInvariant()">@run.Kind.ShortLabel()</span></td>
                    <td class="col-shrink">@run.Outcome.Label()</td>
                    <td class="col-shrink ellipsis" title="@RunDisplay.RepositoryName(run)">@RunDisplay.RepositoryName(run)</td>
                    <td class="ellipsis" title="@RunDisplay.Detail(run)">@RunDisplay.Detail(run)</td>
                    <td class="col-shrink">@FormatDateTime(run.StartedAt)</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private static readonly RunKind[] AllKinds = Enum.GetValues<RunKind>();
    private static readonly RunOutcome[] AllOutcomes = Enum.GetValues<RunOutcome>();

    // Starts with every kind checked, not empty - RunQuery treats an empty set the same as "no
    // filter" (see RefreshAsync below), so an empty _selectedKinds looked, at first load, like
    // nothing was selected while the dropdown's own summary said "All kinds" - checked state and
    // summary text disagreeing. Starting all-checked makes "checked" mean "included" throughout:
    // the summary and the checkboxes agree at load, and unchecking one kind now excludes just that
    // kind rather than the old (inverted) "check one to show only that kind" behavior.
    private readonly HashSet<RunKind> _selectedKinds = [.. AllKinds];
    private string _selectedOutcome = string.Empty;
    private string _repositoryFilter = string.Empty;
    private string _searchText = string.Empty;
    private IReadOnlyList<Run>? _runs;
    private CancellationTokenSource? _debounceCts;
    private SortColumn _sortColumn = SortColumn.Started;
    private bool _sortAscending;
    private IDisposable? _runSubscription;

    private enum SortColumn
    {
        Kind,
        Outcome,
        Repository,
        Detail,
        Started,
    }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        _runSubscription = RunEventBus.Subscribe(OnRunEvent);
    }

    // Mirrors Status.razor's own OnRunEvent - a new run (started by any caller, dashboard or MCP)
    // or one reaching a terminal state both need to show up here live, per service-dashboard's
    // "Completion moves a run from status to history live" requirement; only per-line stdout/stderr
    // output is skipped, since this view never shows a live output preview.
    private void OnRunEvent(RunEvent runEvent)
    {
        if (runEvent.Type is RunEventType.OutputLine)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await RefreshAsync();
            StateHasChanged();
        });
    }

    private Task ToggleKind(RunKind kind, bool isSelected)
    {
        if (isSelected)
        {
            _selectedKinds.Add(kind);
        }
        else
        {
            _selectedKinds.Remove(kind);
        }

        return RefreshAsync();
    }

    // "All kinds" for both the empty selection (no filter applied) and every kind individually
    // checked (equivalent to no filter) - a checked-out-of-N summary reading "6 kinds" when nothing
    // is actually being excluded would be misleading.
    private string KindFilterSummary()
    {
        if (_selectedKinds.Count == 0 || _selectedKinds.Count == AllKinds.Length)
        {
            return "All kinds";
        }

        return _selectedKinds.Count == 1 ? _selectedKinds.Single().ShortLabel() : $"{_selectedKinds.Count} kinds";
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString() ?? string.Empty;

        // Debounced: cancel any pending refresh from a prior keystroke and start a fresh delay -
        // only the last keystroke in a burst actually triggers a query, per design.md's
        // "History filter/search UI" decision.
        _debounceCts?.Cancel();
        var cts = new CancellationTokenSource();
        _debounceCts = cts;

        try
        {
            await Task.Delay(TimeSpan.FromMilliseconds(300), cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        await RefreshAsync();
        StateHasChanged();
    }

    private Task ClearFiltersAsync()
    {
        _selectedKinds.Clear();
        _selectedKinds.UnionWith(AllKinds);
        _selectedOutcome = string.Empty;
        _repositoryFilter = string.Empty;
        _searchText = string.Empty;
        return RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        var query = new RunQuery
        {
            // Every kind checked (the default/cleared state) is filtered identically to none checked -
            // both mean "no kind filter", not "match every kind via an explicit IN-list".
            Kinds = _selectedKinds.Count > 0 && _selectedKinds.Count < AllKinds.Length ? _selectedKinds : null,
            Outcomes = Enum.TryParse<RunOutcome>(_selectedOutcome, out var outcome) ? [outcome] : null,
            SearchText = string.IsNullOrWhiteSpace(_searchText) ? null : _searchText,
        };

        var runs = await RunRepository.ListAsync(query, CancellationToken.None);

        // Client-side partial match on the displayed repository name, not a server-side RunQuery.RepositoryPath
        // filter - that field does an exact match (it's what RepositoryDetail.razor's own history tab
        // relies on, scoping to one already-resolved repository), so reusing it here made this field
        // require the operator to type a full, exactly-resolvable repository name instead of the
        // partial-match behavior Repositories.razor's own search field already gives.
        _runs = string.IsNullOrWhiteSpace(_repositoryFilter)
            ? runs
            : [.. runs.Where(r => RunDisplay.RepositoryName(r).Contains(_repositoryFilter, StringComparison.OrdinalIgnoreCase))];
    }

    private void SortBy(SortColumn column)
    {
        if (_sortColumn == column)
        {
            _sortAscending = !_sortAscending;
        }
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
    }

    private string SortIndicator(SortColumn column) => _sortColumn == column ? (_sortAscending ? " ▲" : " ▼") : string.Empty;

    private IEnumerable<Run> SortedRuns()
    {
        IEnumerable<Run> ordered = _sortColumn switch
        {
            SortColumn.Kind => _runs!.OrderBy(r => r.Kind.ShortLabel(), StringComparer.OrdinalIgnoreCase),
            SortColumn.Outcome => _runs!.OrderBy(r => r.Outcome.Label(), StringComparer.OrdinalIgnoreCase),
            SortColumn.Repository => _runs!.OrderBy(RunDisplay.RepositoryName, StringComparer.OrdinalIgnoreCase),
            SortColumn.Detail => _runs!.OrderBy(RunDisplay.Detail, StringComparer.OrdinalIgnoreCase),
            _ => _runs!.OrderBy(r => r.StartedAt),
        };

        return _sortAscending ? ordered : ordered.Reverse();
    }

    // Local time, no offset suffix - see RunDetail.razor's own FormatDateTime for why.
    private static string FormatDateTime(DateTimeOffset value) =>
        value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture);

    /// <inheritdoc />
    public void Dispose() => _runSubscription?.Dispose();
}

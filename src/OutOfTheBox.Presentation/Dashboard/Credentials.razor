@page "/credentials"
@attribute [Authorize]
@using System.Globalization
@using OutOfTheBox.Application.Repositories
@inject IGitCredentialStore GitCredentialStore
@inject INuGetFeedCredentialStore NuGetFeedCredentialStore

<PageTitle>@VersionInfo.DisplayName - Credentials</PageTitle>

<h1>Credentials</h1>

<div class="history-filters">
    <button type="button" class="icon-button-labeled" @onclick="@(() => _addDialog!.ShowAsync())">
        <Icon Name="add" CssClass="icon-inline" /> Add credential
    </button>
</div>

@if (_error is not null)
{
    <p class="login-error">@_error</p>
}

@if (_rows is null)
{
    <p>Loading...</p>
}
else if (_rows.Count == 0)
{
    <p class="empty-state">No credentials authorized yet.</p>
}
else
{
    <table class="data-table clickable-rows">
        <colgroup>
            <col style="width:1%" />
            <col />
            <col style="width:1%" />
            <col style="width:1%" />
            <col style="width:1%" />
        </colgroup>
        <thead>
            <tr>
                <th class="col-shrink not-sortable">Type</th>
                <th class="not-sortable">Server / Feed</th>
                <th class="col-shrink not-sortable">PAT</th>
                <th class="col-shrink not-sortable">Authorized</th>
                <th class="col-shrink not-sortable">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in _rows)
            {
                <tr title="Click to change this credential" @onclick="@(() => _editDialog!.ShowAsync(row.Kind == CredentialKind.GitHost, row.ServerOrFeed))">
                    <td class="col-shrink"><span class="kind-badge">@row.TypeLabel</span></td>
                    <td class="ellipsis" title="@row.ServerOrFeed">@row.ServerOrFeed</td>
                    <td class="col-shrink"><code class="pat-value">@(row.Token ?? "(unavailable)")</code></td>
                    <td class="col-shrink">@FormatDateTime(row.AuthorizedAtUtc)</td>
                    <td class="col-shrink actions" @onclick:stopPropagation="true">
                        <button type="button" class="icon-button icon-button-danger" title="Remove" @onclick="@(() => ConfirmRemoveAsync(row))">
                            <Icon Name="trash" />
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<ConfirmDialog @ref="_confirmDialog" />
<AddCredentialDialog @ref="_addDialog" OnSaved="RefreshAsync" />
<EditCredentialDialog @ref="_editDialog" OnSaved="RefreshAsync" />

@code {
    /// <summary>
    /// One unified table listing every authorized credential - git host and NuGet feed alike -
    /// with the PAT itself fully shown (per direct instruction), fetched live on each refresh
    /// rather than persisted for display: <see cref="IGitCredentialStore.GetCurrentTokenAsync"/>
    /// reads it straight from the git credential helper each time, and
    /// <see cref="INuGetFeedCredentialStore.GetCurrentTokenAsync"/> reads it from whichever
    /// mechanism backs that feed. Clicking a row opens <see cref="EditCredentialDialog"/> to replace
    /// that credential (host/feed URL and type both fixed - only a new token is entered); the
    /// per-repository "change credential" action this replaced is gone, per direct instruction.
    /// </summary>
    private sealed record CredentialRow(CredentialKind Kind, string TypeLabel, string ServerOrFeed, string? Token, DateTimeOffset AuthorizedAtUtc);

    private enum CredentialKind
    {
        GitHost,
        NuGetFeed,
    }

    private IReadOnlyList<CredentialRow>? _rows;
    private string? _error;
    private ConfirmDialog? _confirmDialog;
    private AddCredentialDialog? _addDialog;
    private EditCredentialDialog? _editDialog;

    /// <inheritdoc />
    protected override Task OnInitializedAsync() => RefreshAsync();

    private async Task RefreshAsync()
    {
        var gitHosts = await GitCredentialStore.ListAuthorizedHostsAsync(CancellationToken.None);
        var nugetFeeds = await NuGetFeedCredentialStore.ListAuthorizedFeedsAsync(CancellationToken.None);

        var gitRows = await Task.WhenAll(gitHosts.Select(async h => new CredentialRow(
            CredentialKind.GitHost, "Git host", h.Host, await GitCredentialStore.GetCurrentTokenAsync(h.Host, CancellationToken.None), h.AuthorizedAtUtc)));

        var nugetRows = await Task.WhenAll(nugetFeeds.Select(async f => new CredentialRow(
            CredentialKind.NuGetFeed, "NuGet feed", f.FeedUrl, await NuGetFeedCredentialStore.GetCurrentTokenAsync(f.FeedUrl, CancellationToken.None), f.AuthorizedAtUtc)));

        _rows = [.. gitRows.Concat(nugetRows)
            .OrderBy(r => r.TypeLabel, StringComparer.Ordinal)
            .ThenBy(r => r.ServerOrFeed, StringComparer.Ordinal)];
    }

    private Task ConfirmRemoveAsync(CredentialRow row) =>
        _confirmDialog!.ShowAsync(
            "Remove credential",
            $"Remove the stored credential for '{row.ServerOrFeed}'? Any use that actually needs it will start failing.",
            () => RemoveAsync(row),
            confirmLabel: "Remove");

    private async Task RemoveAsync(CredentialRow row)
    {
        _error = row.Kind == CredentialKind.GitHost
            ? await RevokeGitHostAsync(row.ServerOrFeed)
            : await RevokeNuGetFeedAsync(row.ServerOrFeed);

        await RefreshAsync();

        // ConfirmDialog reports back via a plain Func<Task> (per this project's existing dialog
        // convention), not an EventCallback - only an EventCallback carries the receiver-component
        // reference Blazor needs to auto-render a *different* component than the one whose own
        // handler was dispatched (ConfirmDialog's Remove button, not this page). Without this
        // explicit call, the table only reflects the removal after some unrelated re-render (e.g. a
        // manual navigation) - confirmed live, not assumed.
        StateHasChanged();
    }

    private async Task<string?> RevokeGitHostAsync(string host)
    {
        var result = await GitCredentialStore.RevokeAsync(host, CancellationToken.None);
        return result switch
        {
            GitCredentialRevokeResult.Revoked or GitCredentialRevokeResult.NothingToRevoke => null,
            GitCredentialRevokeResult.GitUnreachable gitUnreachable => $"git could not be started: {gitUnreachable.ErrorMessage}",
            _ => "Could not remove that credential.",
        };
    }

    private async Task<string?> RevokeNuGetFeedAsync(string feedUrl)
    {
        var result = await NuGetFeedCredentialStore.RevokeAsync(feedUrl, CancellationToken.None);
        return result switch
        {
            NuGetCredentialRevokeResult.Revoked or NuGetCredentialRevokeResult.NothingToRevoke => null,
            NuGetCredentialRevokeResult.ConfigurationUnwritable unwritable =>
                $"This machine's NuGet configuration could not be accessed: {unwritable.ErrorMessage}",
            _ => "Could not remove that credential.",
        };
    }

    private static string FormatDateTime(DateTimeOffset value) =>
        value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture);
}

@page "/credentials"
@attribute [Authorize]
@implements IDisposable
@using System.Globalization
@using OutOfTheBox.Application.Repositories
@inject IGitCredentialStore GitCredentialStore
@inject INuGetFeedCredentialStore NuGetFeedCredentialStore
@inject ICredentialEventBus CredentialEventBus

<PageTitle>@VersionInfo.DisplayName - Credentials</PageTitle>

<h1>Credentials</h1>

<div class="history-filters">
    <label>
        Type
        <select @bind="_typeFilter">
            <option value="">(any)</option>
            <option value="git">Git host</option>
            <option value="nuget">NuGet feed</option>
        </select>
    </label>
    <label>
        Server / Feed
        <input type="text" @bind="_serverOrFeedFilter" @bind:event="oninput" placeholder="Server or feed URL" />
    </label>
    <button type="button" class="icon-button" title="Clear filters" @onclick="ClearFilters">
        <Icon Name="clear-filters" />
    </button>
    <button type="button" class="icon-button-labeled" @onclick="@(() => _addDialog!.ShowAsync())">
        <Icon Name="add" CssClass="icon-inline" /> Add credential
    </button>
</div>

@if (_error is not null)
{
    <p class="login-error">@_error</p>
}

@if (_rows is null)
{
    <p>Loading...</p>
}
else
{
    var filtered = FilteredRows();
    if (filtered.Count == 0)
    {
        <p class="empty-state">No credentials match the current filters.</p>
    }
    else
    {
        <table class="data-table clickable-rows">
            <colgroup>
                <col style="width:1%" />
                <col />
                <col style="width:1%" />
                <col style="width:1%" />
            </colgroup>
            <thead>
                <tr>
                    <th class="col-shrink" @onclick="@(() => SortBy(SortColumn.Type))">Type@(SortIndicator(SortColumn.Type))</th>
                    <th @onclick="@(() => SortBy(SortColumn.ServerOrFeed))">Server / Feed@(SortIndicator(SortColumn.ServerOrFeed))</th>
                    <th class="col-shrink" @onclick="@(() => SortBy(SortColumn.Authorized))">Authorized@(SortIndicator(SortColumn.Authorized))</th>
                    <th class="col-shrink not-sortable">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Sorted(filtered))
                {
                    <tr @key="RowKey(row)" class="@(_exitingKeys.Contains(RowKey(row)) ? ListAnimation.ExitingClass : null)" title="Click to change this credential" @onclick="@(() => _editDialog!.ShowAsync(row.Kind == CredentialKind.GitHost, row.ServerOrFeed))">
                        <td class="col-shrink"><span class="kind-badge">@row.TypeLabel</span></td>
                        <td class="ellipsis" title="@row.ServerOrFeed">@row.ServerOrFeed</td>
                        <td class="col-shrink">@FormatDateTime(row.AuthorizedAtUtc)</td>
                        <td class="col-shrink actions" @onclick:stopPropagation="true">
                            <button type="button" class="icon-button icon-button-danger" title="Remove" @onclick="@(() => ConfirmRemoveAsync(row))">
                                <Icon Name="trash" />
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

<ConfirmDialog @ref="_confirmDialog" />
<AddCredentialDialog @ref="_addDialog" OnSaved="RefreshAsync" />
<EditCredentialDialog @ref="_editDialog" OnSaved="RefreshAsync" />

@code {
    /// <summary>
    /// One unified table listing every authorized credential - git host and NuGet feed alike. The
    /// PAT itself is never shown here (removed per direct instruction, too risky to surface even to
    /// an already-authenticated operator) - only metadata (type, host/feed, authorized date). Clicking
    /// a row opens <see cref="EditCredentialDialog"/> to replace that credential (host/feed URL and
    /// type both fixed - only a new token is entered, the existing one is never read back); the
    /// per-repository "change credential" action this replaced is gone, per direct instruction.
    /// </summary>
    private sealed record CredentialRow(CredentialKind Kind, string TypeLabel, string ServerOrFeed, DateTimeOffset AuthorizedAtUtc);

    private enum CredentialKind
    {
        GitHost,
        NuGetFeed,
    }

    private enum SortColumn
    {
        Type,
        ServerOrFeed,
        Authorized,
    }

    private IReadOnlyList<CredentialRow>? _rows;
    private string? _error;
    private ConfirmDialog? _confirmDialog;
    private AddCredentialDialog? _addDialog;
    private EditCredentialDialog? _editDialog;
    private SortColumn _sortColumn = SortColumn.ServerOrFeed;
    private bool _sortAscending = true;
    private string _typeFilter = string.Empty;
    private string _serverOrFeedFilter = string.Empty;
    private IDisposable? _subscription;

    /// <summary>Row keys (see <see cref="RowKey"/>) currently mid-remove, playing their exit animation - see <see cref="ListAnimation"/>.</summary>
    private readonly HashSet<string> _exitingKeys = [];

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();

        // Without this, an authorize/revoke made via the authorize_git_host/revoke_git_host_authorization/
        // authorize_nuget_feed/revoke_nuget_feed_authorization MCP tools while this page is already open
        // would sit unreflected until a manual reload - see ICredentialEventBus's own remarks.
        _subscription = CredentialEventBus.Subscribe(OnCredentialEvent);
    }

    private void OnCredentialEvent() => _ = InvokeAsync(async () =>
    {
        await RefreshAsync();
        StateHasChanged();
    });

    /// <inheritdoc />
    public void Dispose() => _subscription?.Dispose();

    private async Task RefreshAsync()
    {
        var gitHosts = await GitCredentialStore.ListAuthorizedHostsAsync(CancellationToken.None);
        var nugetFeeds = await NuGetFeedCredentialStore.ListAuthorizedFeedsAsync(CancellationToken.None);

        var gitRows = gitHosts.Select(h => new CredentialRow(CredentialKind.GitHost, "Git host", h.Host, h.AuthorizedAtUtc));
        var nugetRows = nugetFeeds.Select(f => new CredentialRow(CredentialKind.NuGetFeed, "NuGet feed", f.FeedUrl, f.AuthorizedAtUtc));

        _rows = [.. gitRows.Concat(nugetRows)];
    }

    private IReadOnlyList<CredentialRow> FilteredRows()
    {
        IEnumerable<CredentialRow> query = _rows!;

        query = _typeFilter switch
        {
            "git" => query.Where(r => r.Kind == CredentialKind.GitHost),
            "nuget" => query.Where(r => r.Kind == CredentialKind.NuGetFeed),
            _ => query,
        };

        if (!string.IsNullOrWhiteSpace(_serverOrFeedFilter))
        {
            query = query.Where(r => r.ServerOrFeed.Contains(_serverOrFeedFilter, StringComparison.OrdinalIgnoreCase));
        }

        return [.. query];
    }

    private void ClearFilters()
    {
        _typeFilter = string.Empty;
        _serverOrFeedFilter = string.Empty;
    }

    private void SortBy(SortColumn column)
    {
        if (_sortColumn == column)
        {
            _sortAscending = !_sortAscending;
        }
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
    }

    private string SortIndicator(SortColumn column) => _sortColumn == column ? (_sortAscending ? " ▲" : " ▼") : string.Empty;

    private IEnumerable<CredentialRow> Sorted(IEnumerable<CredentialRow> rows)
    {
        IEnumerable<CredentialRow> ordered = _sortColumn switch
        {
            SortColumn.ServerOrFeed => rows.OrderBy(r => r.ServerOrFeed, StringComparer.OrdinalIgnoreCase),
            SortColumn.Authorized => rows.OrderBy(r => r.AuthorizedAtUtc),
            _ => rows.OrderBy(r => r.TypeLabel, StringComparer.OrdinalIgnoreCase).ThenBy(r => r.ServerOrFeed, StringComparer.OrdinalIgnoreCase),
        };

        return _sortAscending ? ordered : ordered.Reverse();
    }

    private Task ConfirmRemoveAsync(CredentialRow row) =>
        _confirmDialog!.ShowAsync(
            "Remove credential",
            $"Remove the stored credential for '{row.ServerOrFeed}'? Any use that actually needs it will start failing.",
            () => RemoveAsync(row),
            confirmLabel: "Remove");

    private async Task RemoveAsync(CredentialRow row)
    {
        var key = RowKey(row);
        _exitingKeys.Add(key);
        StateHasChanged();
        await Task.Delay(ListAnimation.ExitDuration);

        _error = row.Kind == CredentialKind.GitHost
            ? await RevokeGitHostAsync(row.ServerOrFeed)
            : await RevokeNuGetFeedAsync(row.ServerOrFeed);

        _exitingKeys.Remove(key);
        await RefreshAsync();

        // ConfirmDialog reports back via a plain Func<Task> (per this project's existing dialog
        // convention), not an EventCallback - only an EventCallback carries the receiver-component
        // reference Blazor needs to auto-render a *different* component than the one whose own
        // handler was dispatched (ConfirmDialog's Remove button, not this page). Without this
        // explicit call, the table only reflects the removal after some unrelated re-render (e.g. a
        // manual navigation) - confirmed live, not assumed.
        StateHasChanged();
    }

    private async Task<string?> RevokeGitHostAsync(string host)
    {
        var result = await GitCredentialStore.RevokeAsync(host, CancellationToken.None);
        return result switch
        {
            GitCredentialRevokeResult.Revoked or GitCredentialRevokeResult.NothingToRevoke => null,
            GitCredentialRevokeResult.GitUnreachable gitUnreachable => $"git could not be started: {gitUnreachable.ErrorMessage}",
            _ => "Could not remove that credential.",
        };
    }

    private async Task<string?> RevokeNuGetFeedAsync(string feedUrl)
    {
        var result = await NuGetFeedCredentialStore.RevokeAsync(feedUrl, CancellationToken.None);
        return result switch
        {
            NuGetCredentialRevokeResult.Revoked or NuGetCredentialRevokeResult.NothingToRevoke => null,
            NuGetCredentialRevokeResult.ConfigurationUnwritable unwritable =>
                $"This machine's NuGet configuration could not be accessed: {unwritable.ErrorMessage}",
            _ => "Could not remove that credential.",
        };
    }

    private static string FormatDateTime(DateTimeOffset value) =>
        value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture);

    // CredentialRow has no id of its own (it's assembled fresh from two separate stores on every
    // RefreshAsync) - Kind+ServerOrFeed is the same pair RemoveAsync already uses to know which
    // store to call, and is unique for the same reason: a git host and a NuGet feed never share a
    // URL shape, and within one kind ServerOrFeed alone already came from a Dictionary-backed store.
    private static string RowKey(CredentialRow row) => $"{row.Kind}|{row.ServerOrFeed}";
}

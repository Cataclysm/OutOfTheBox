@using OutOfTheBox.Application.Repositories
@using OutOfTheBox.Domain.Repositories
@inject IRepositoryFileBrowser FileBrowser
@inject IRepositoryHistoryReader RepositoryHistoryReader
@implements IDisposable

<div class="history-filters">
    <label>
        <input type="checkbox" @bind="_dirtyOnly" @bind:after="OnDirtyOnlyChangedAsync" /> Dirty files only
    </label>
</div>

<CascadingValue Value="_dirtyOnly ? _dirtyPaths : null" Name="DirtyPaths">
    <div class="file-tree">
        @if (_entries is null)
        {
            <p>Loading...</p>
        }
        else if (_entries.Count == 0)
        {
            <p class="empty-state">This repository is empty.</p>
        }
        else if (_dirtyOnly && _dirtyPaths.Count == 0)
        {
            <p class="empty-state">No dirty files - working tree is clean.</p>
        }
        else
        {
            @foreach (var entry in _entries)
            {
                <FileTreeNode
                    @key="entry.Name"
                    RepositoryName="@RepositoryName"
                    ParentRelativePath=""
                    Name="@entry.Name"
                    IsDirectory="@entry.IsDirectory"
                    SizeBytes="@entry.SizeBytes"
                    Depth="0"
                    OnChanged="LoadRootAsync"
                    RequestConfirm="ShowConfirmAsync"
                    RequestPreview="ShowPreviewAsync" />
            }
        }
    </div>
</CascadingValue>

<ConfirmDialog @ref="_confirmDialog" />
<FilePreviewDialog @ref="_previewDialog" />

@code {
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(15);

    /// <summary>Which repository's file tree to browse, rooted at that repository's own directory.</summary>
    [Parameter, EditorRequired]
    public string RepositoryName { get; set; } = string.Empty;

    private IReadOnlyList<RepositoryFileEntry>? _entries;
    private ConfirmDialog? _confirmDialog;
    private FilePreviewDialog? _previewDialog;
    private CancellationTokenSource? _pollCts;
    private bool _dirtyOnly;
    private HashSet<string> _dirtyPaths = [];

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        await LoadRootAsync();

        // The repository root itself is always "expanded" (its contents are the tree's top level),
        // so it polls the same way any other expanded FileTreeNode folder does.
        _pollCts = new CancellationTokenSource();
        _ = PollLoopAsync(_pollCts.Token);
    }

    private async Task LoadRootAsync()
    {
        _entries = await FileBrowser.ListDirectoryAsync(RepositoryName, string.Empty, CancellationToken.None);
        await InvokeAsync(StateHasChanged);
    }

    // @bind:after, not an inline lambda on the checkbox's own @onchange - _dirtyOnly needs to already
    // reflect the new checked state before this runs (RefreshDirtyPathsAsync's own caller-side check
    // isn't the concern here, the <CascadingValue>'s own conditional expression is, and that reads
    // _dirtyOnly directly during the next render this method's StateHasChanged triggers).
    private async Task OnDirtyOnlyChangedAsync()
    {
        if (_dirtyOnly)
        {
            await RefreshDirtyPathsAsync();
        }
    }

    private async Task RefreshDirtyPathsAsync()
    {
        _dirtyPaths = [.. await RepositoryHistoryReader.ListDirtyFilePathsAsync(RepositoryName, CancellationToken.None)];
        await InvokeAsync(StateHasChanged);
    }

    // _confirmDialog/_previewDialog are only ever dereferenced here, inside methods only invoked as
    // a result of a FileTreeNode event bubbling up - by which point this component (their owner) has
    // long since completed its own first render, so these are never null in practice despite the `!`
    // (see FileTreeNode's own remarks on RequestConfirm/RequestPreview for why passing the dialog
    // instances themselves down as parameters instead was unsafe).
    private Task ShowConfirmAsync(FileTreeConfirmRequest request) =>
        _confirmDialog!.ShowAsync(request.Title, request.Message, request.OnConfirmed, request.ConfirmLabel);

    private Task ShowPreviewAsync(FilePreviewRequest request) =>
        _previewDialog!.ShowAsync(request.RepositoryName, request.RelativePath, request.Name, request.DownloadUrl);

    private async Task PollLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (true)
            {
                await Task.Delay(PollInterval, cancellationToken);
                var fresh = await FileBrowser.ListDirectoryAsync(RepositoryName, string.Empty, cancellationToken);
                var freshDirtyPaths = _dirtyOnly
                    ? await RepositoryHistoryReader.ListDirtyFilePathsAsync(RepositoryName, cancellationToken)
                    : null;
                cancellationToken.ThrowIfCancellationRequested();
                _entries = fresh;
                if (freshDirtyPaths is not null)
                {
                    _dirtyPaths = [.. freshDirtyPaths];
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    /// <inheritdoc />
    public void Dispose() => _pollCts?.Cancel();
}

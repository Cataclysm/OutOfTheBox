@page "/history/{RunId:guid}"
@attribute [Authorize]
@using System.Globalization
@using OutOfTheBox.Presentation.Dashboard.Charts
@inject IRunRepository RunRepository
@inject IRunEventBus RunEventBus
@implements IDisposable

<PageTitle>@VersionInfo.DisplayName - Run detail</PageTitle>

<a class="back-link" href="history">← Back to History</a>

@if (_run is null)
{
    <p>Loading...</p>
}
else
{
    <h1>@_run.Kind.Heading()</h1>
    <dl>
        <dt>Repository</dt>
        <dd>@_run.RepositoryPath</dd>
        <dt>Outcome</dt>
        <dd>@_run.Outcome.Label()</dd>
        <dt>Started</dt>
        <dd>@FormatDateTime(_run.StartedAt)</dd>
        <dt>Completed</dt>
        <dd>@(_run.CompletedAt is { } completedAt ? FormatDateTime(completedAt) : "-")</dd>

        @if (_run.Kind is RunKind.DotnetCommand or RunKind.GitCommand)
        {
            <dt>Command</dt>
            <dd>@(_run.Arguments is null ? string.Empty : string.Join(' ', _run.Arguments))</dd>
            <dt>Exit code</dt>
            <dd>@(_run.ExitCode is { } exitCode ? exitCode.ToString() : "-")</dd>
        }
        else if (_run.Kind is RunKind.RepositoryClone)
        {
            <dt>Source URL</dt>
            <dd>@_run.SourceUrl</dd>
            <dt>Exit code</dt>
            <dd>@(_run.ExitCode is { } cloneExitCode ? cloneExitCode.ToString() : "-")</dd>
        }
        else if (_run.Kind is RunKind.FileTransfer)
        {
            <dt>Requested file path</dt>
            <dd>@_run.FilePath</dd>
            <dt>File size</dt>
            <dd>@(_run.FileSizeBytes is { } sizeBytes ? $"{sizeBytes:N0} bytes" : "-")</dd>
        }
        else if (_run.Kind is RunKind.RepositoryFileDelete)
        {
            <dt>Deleted path</dt>
            <dd>@_run.FilePath</dd>
        }
    </dl>

    <RunHistoryGraph RunId="@RunId" Note="@(_run.Kind == RunKind.FileTransfer ? "Host activity during transfer - no isolated per-transfer figure is possible." : null)" />

    @if (_run.Kind is RunKind.DotnetCommand or RunKind.GitCommand or RunKind.RepositoryClone)
    {
        @if (_run.Truncated)
        {
            <p class="truncated-indicator">Output was truncated at the configured cap.</p>
        }
        <h2>Stdout</h2>
        <pre class="run-output">@_run.Stdout</pre>
        <h2>Stderr</h2>
        <pre class="run-output">@_run.Stderr</pre>
    }
    else if (!string.IsNullOrEmpty(_run.Stderr))
    {
        <h2>Error</h2>
        <pre class="run-output error-detail">@_run.Stderr</pre>
    }
}

@code {
    /// <summary>The run id from the route (<c>/history/{RunId:guid}</c>).</summary>
    [Parameter]
    public Guid RunId { get; set; }

    private Run? _run;
    private IDisposable? _runSubscription;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        _run = await RunRepository.FindByIdAsync(RunId, CancellationToken.None);

        // A still-in-flight run's detail page (reachable from History or a repository's own History
        // tab, both of which list Running-outcome runs, not just completed ones) previously showed
        // whatever stdout/stderr/outcome happened to be persisted at page load and then never
        // updated again - not even once the run actually finished. Mirrors every other live-updating
        // view's subscribe-in-OnInitialized/unsubscribe-in-Dispose pattern.
        _runSubscription = RunEventBus.Subscribe(OnRunEvent);
    }

    private void OnRunEvent(RunEvent runEvent)
    {
        // OutputLine is skipped like every other live-updating view does - Run.Stdout/Stderr are
        // only ever written to the Runs table once, at the run's terminal transition (see e.g.
        // CommandExecutionMcpTools' own completion handling), never incrementally while running, so
        // re-querying on an OutputLine event would just re-fetch the same not-yet-populated fields.
        if (runEvent.RunId != RunId || runEvent.Type is RunEventType.OutputLine)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            _run = await RunRepository.FindByIdAsync(RunId, CancellationToken.None);
            StateHasChanged();
        });
    }

    /// <inheritdoc />
    public void Dispose() => _runSubscription?.Dispose();

    // Local time, no offset suffix - DateTimeOffset's own default ToString() keeps the "+HH:mm"
    // offset even after ToLocalTime(), which is redundant clutter for an operator who only ever
    // cares about their own wall-clock time. Invariant-culture-formatted for the same reason
    // Status.razor's FormatBytes/FormatPercent are - a locale-dependent format is easy to never
    // notice on a US/UK-locale dev machine.
    private static string FormatDateTime(DateTimeOffset value) =>
        value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture);
}

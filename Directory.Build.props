<Project>

  <PropertyGroup>
    <!-- Standard SemVer, starting directly at 1.0.0 and not bumped incrementally through v1
         development, per explicit instruction - every project's AssemblyVersion/FileVersion/
         InformationalVersion derive from this one property automatically, no per-project override. -->
    <Version>1.0.0</Version>
    <!-- Since .NET 8, the SDK appends "+<git commit sha>" to AssemblyInformationalVersionAttribute
         by default (Source Link's SourceRevisionId) - VersionInfo.cs reads that attribute verbatim
         for every version display on the dashboard (header/footer, login page, /version endpoint),
         so left alone every one of those showed "1.0.0+4343d1a..." instead of a plain version. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Centralized build output: every project's bin/obj lands under artifacts/ at the repo
         root (artifacts/bin/<project>/, artifacts/obj/<project>/, ...) instead of scattering a
         bin/ and obj/ folder inside every project directory. ArtifactsPath is pinned explicitly
         (not left to the default inference) because tests/Directory.Build.props is itself a
         second Directory.Build.props file - without pinning, the SDK anchors test projects'
         artifacts to tests/artifacts/ instead of unifying under the repo root. -->
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Without this, .editorconfig's csharp_style_*/dotnet_style_* rules are IDE-only hints that
         never appear in `dotnet build` output, no matter their configured severity. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- CS1591: missing XML doc comment on a publicly visible member. Treated as an error so
         undocumented public API fails the build instead of just warning. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <!-- Built-in .NET analyzers (CAxxxx) - ship with the SDK already, no new package. Recommended
         (not All) turns on the rules the .NET team itself suggests as generally applicable, without
         the noisier/more opinionated ones All also includes. Severities live in .editorconfig, same
         dotnet_diagnostic.<id>.severity mechanism as every other rule override in this file. -->
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
  </PropertyGroup>

</Project>

root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,feature}]
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_size = 2

[*.cs]
# Language conventions
# Severity is `warning` (not `suggestion`) throughout this section, and EnforceCodeStyleInBuild is
# set in Directory.Build.props, so every rule below actually surfaces in `dotnet build` output -
# per explicit instruction to enforce these, not just hint at them in the IDE. CS1591 (missing XML
# doc comment on public API) remains the only rule promoted all the way to a build-breaking error
# (via Directory.Build.props's WarningsAsErrors) - everything here is a visible, non-blocking
# warning instead.
csharp_style_var_for_built_in_types = true:warning
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = true:warning
csharp_style_expression_bodied_methods = when_on_single_line:warning
csharp_style_expression_bodied_properties = true:warning
csharp_style_expression_bodied_constructors = when_on_single_line:warning
csharp_style_expression_bodied_operators = when_on_single_line:warning
csharp_style_expression_bodied_indexers = true:warning
csharp_style_expression_bodied_accessors = true:warning
csharp_style_expression_bodied_lambdas = true:warning
csharp_style_expression_bodied_local_functions = when_on_single_line:warning
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_simple_using_statement = true:warning
csharp_using_directive_placement = outside_namespace:warning

# Pattern matching / modern control flow - genuinely clearer than the pre-C#7 equivalents they
# replace, not just a style preference.
csharp_style_pattern_matching_over_is_with_cast_check = true:warning
csharp_style_pattern_matching_over_as_with_null_check = true:warning
csharp_style_prefer_pattern_matching = true:warning
csharp_style_prefer_not_pattern = true:warning
csharp_style_prefer_extended_property_pattern = true:warning
csharp_style_prefer_switch_expression = true:warning
csharp_style_conditional_delegate_call = true:warning
csharp_style_prefer_null_check_over_type_check = true:warning
csharp_style_throw_expression = true:warning
csharp_style_prefer_tuple_swap = true:warning
csharp_style_deconstructed_variable_declaration = true:warning
csharp_style_inlined_variable_declaration = true:warning
csharp_style_unused_value_assignment_preference = discard_variable:warning
# Deliberately left at its default (effectively off), not bumped to warning like everything else
# here: IDE0058 (statement-expression preference) flags routine, idiomatic calls whose return
# value is never needed - e.g. `registry.TryAcquire(...)` in test setup, `list.RemoveAll(...)` in
# production code - and would force `_ = ...;` discards across ~200 call sites for no real clarity
# gain. Noise, not a "modern C# construct" worth enforcing.
csharp_style_unused_value_expression_statement_preference = discard_variable:silent

# Target-typed/inferred construction and index/range operators - C# 8-12 features this codebase
# already uses in places (e.g. collection-expression spreads); enabling makes that usage consistent
# rather than incidental.
csharp_style_implicit_object_creation_when_type_is_apparent = true:warning
csharp_style_prefer_index_operator = true:warning
csharp_style_prefer_range_operator = true:warning
csharp_style_prefer_local_over_anonymous_function = true:warning
csharp_style_prefer_static_local_function = true:warning
csharp_style_prefer_static_anonymous_function = true:warning
csharp_style_prefer_top_level_statements = true:warning

# Deliberately NOT enabled: csharp_style_prefer_primary_constructors. Most classes in this codebase
# take several constructor-injected dependencies (services, repositories, ports); primary
# constructors read worse at that arity, don't have a clean place for per-parameter XML doc
# comments (CS1591 is build-breaking here), and their captured-parameter/field ambiguity is a real,
# well-documented footgun. Not a "modern C# construct" this codebase benefits from - a deliberate
# omission, not an oversight.

csharp_prefer_braces = true:warning

# Formatting
csharp_new_line_before_open_brace = all
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_space_after_keywords_in_control_flow_statements = true

# dotnet_style_* rules (language-agnostic, but these are the C# constructs they map onto)
dotnet_style_object_initializer = true:warning
dotnet_style_collection_initializer = true:warning
dotnet_style_prefer_collection_expression = true:warning
dotnet_style_explicit_tuple_names = true:warning
dotnet_style_prefer_inferred_tuple_names = true:warning
dotnet_style_prefer_inferred_anonymous_type_member_names = true:warning
dotnet_style_prefer_auto_properties = true:warning
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:warning
dotnet_style_prefer_conditional_expression_over_assignment = true:warning
# Deliberately left at its default (off), not bumped like its assignment counterpart above:
# IDE0046 pushes guard-clause-then-return/throw code (this codebase's prevailing style) toward a
# ternary, including throw-expression-in-ternary for the guard-clause-then-throw shape - a change
# that trades a clear early exit for a denser, harder-to-read line. Not sense making here.
dotnet_style_prefer_conditional_expression_over_return = false
dotnet_style_prefer_compound_assignment = true:warning
dotnet_style_prefer_simplified_boolean_expressions = true:warning
dotnet_style_prefer_simplified_interpolation = true:warning
dotnet_style_null_propagation = true:warning
dotnet_style_coalesce_expression = true:warning
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning
dotnet_style_operator_placement_when_wrapping = beginning_of_line
dotnet_style_parentheses_in_arithmetic_binary_operators = always_for_clarity:warning
dotnet_style_parentheses_in_relational_binary_operators = always_for_clarity:warning
dotnet_style_parentheses_in_other_binary_operators = always_for_clarity:warning
dotnet_style_parentheses_in_other_operators = never_if_unnecessary:warning
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

# Immutability/visibility - catches fields that could be readonly and members missing an explicit
# accessibility modifier; both are real correctness/clarity wins, not just taste.
dotnet_style_readonly_field = true:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_namespace_match_folder = true:warning

# Dead/unnecessary code - these catch real cruft (unused usings, unused parameters, redundant
# discards/suppressions/equality checks), not style preferences.
dotnet_diagnostic.IDE0005.severity = warning
dotnet_code_quality_unused_parameters = all:warning
dotnet_diagnostic.IDE0079.severity = warning
dotnet_diagnostic.IDE0100.severity = warning
dotnet_diagnostic.IDE0110.severity = warning

# Naming: private fields are _camelCase
dotnet_naming_rule.private_fields_underscore_camel_case.severity = suggestion
dotnet_naming_rule.private_fields_underscore_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_underscore_camel_case.style = underscore_camel_case
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

# CS1591 (missing XML doc comment on public API) is promoted to an error via Directory.Build.props

# Built-in .NET analyzers (CAxxxx, Directory.Build.props's AnalysisMode=Recommended). Disabled only
# where a rule conflicts with a convention this codebase already follows deliberately:
# - CA1859 (return/accept concrete collection types instead of interfaces "for improved
#   performance") fights this codebase's whole ports-and-adapters design - IReadOnlyList<T>/
#   IReadOnlyDictionary<TKey,TValue> return types are a deliberate encapsulation choice (callers
#   can't mutate what a repository/port hands back), not an oversight to "fix" for a marginal gain.
# - CA1848 (use LoggerMessage source-generated delegates instead of ILogger.LogWarning/LogError(...))
#   exists to avoid per-call string-formatting allocation on hot logging paths - this service's own
#   logging philosophy (Warning floor, "not gigabytes of logs, just the stuff that really matters")
#   means none of its log call sites are hot enough for that to matter, and the delegate-per-message
#   boilerplate isn't worth it for occasional lifecycle/failure events.
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1859.severity = none

# EF Core migrations are scaffolded by `dotnet ef migrations add`, not hand-authored, and get
# regenerated/appended to by that tooling - style-rule nagging on them is pure noise that would
# just be overwritten anyway.
[**/Migrations/*.cs]
generated_code = true

# CA1707 (identifiers should not contain underscores) would flag every test method in this codebase
# - Given_When_Then-style underscore-separated names (e.g. Compute_returns_null_for_an_empty_series)
# are this project's deliberate test-naming convention, chosen for readability as a sentence, not a
# lapse. CA1861 (prefer a static readonly field over a literal array argument, for methods called
# repeatedly) is a real perf suggestion, but BDD step-definition methods run once per scenario, not
# in a hot loop - not worth the extra field per call site for equally-negligible gain. Neither
# disabled everywhere: src/ has no equivalent naming convention or hot-loop-adjacent code these
# exceptions apply to.
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none

# Same two rules, same reasoning, for the installer's own standalone test project
# (installer/OutOfTheBox.Msi.CustomActions.Tests) plus its production CustomActions code - an MSI
# custom action also runs once (or a handful of times) per install, never in a hot loop, so CA1861
# buys nothing there either; CA1707 has no legitimate target in the production code today (it's
# ordinary PascalCase), so scoping this to all of installer/ rather than just its .Tests project is
# safe in practice, not just broad for convenience.
[installer/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none

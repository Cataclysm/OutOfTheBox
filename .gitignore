# .NET build output
# All projects use the centralized artifacts output layout (Directory.Build.props:
# UseArtifactsOutput), so build output lands under artifacts/ at the repo root. bin/ and obj/
# are kept ignored too as a safety net (e.g. a project built outside the .slnx without picking up
# Directory.Build.props).
artifacts/
bin/
obj/
out/
publish/
*.pdb

# Test results / coverage
TestResults/
*.trx
*.coverage
*.coveragexml

# IDE
.vs/
.idea/
*.user
*.sln.DotSettings.user
.vscode/

# Reqnroll-generated code-behind for .feature files (regenerated on every build)
*.feature.cs

# NuGet
*.nupkg
*.snupkg
.nuget/
packages/

# Local/secret configuration - never commit real tokens or certs
appsettings.*.local.json
*.local.json
.env
secrets.json
*.pfx
*.pem
*.key

# Runtime data (SQLite db is generated at runtime, never checked in)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Claude Code local settings
.claude/settings.local.json
